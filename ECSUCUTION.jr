const execution = {
  cleanPhoneNumber(raw) {
    let cleaned = raw.replace(/\D/g, '');
    if (cleaned.startsWith('0')) return '+213' + cleaned.substring(1);
    if (cleaned.length === 9) return '+213' + cleaned;
    return '+' + cleaned;
  },
  async send(message, orderData) {
    const phone = this.cleanPhoneNumber(orderData.customer?.phone || '');
    console.log([EXECUTION - SCEAU 32] Envoi vers ${phone} : ${message});
  }
};
module.exports = execution;
