<!-- OG EMPIRE — TOPBAR (langue, notifications, profil résumé) -->
<header class="og-topbar" id="og-topbar">
  <button class="og-topbar__menu" id="og-topbar-menu" aria-label="Ouvrir le menu" data-testid="topbar-menu-btn">
    <span></span><span></span><span></span>
  </button>

  <div class="og-topbar__breadcrumb">
    <% if (typeof breadcrumb !== 'undefined') { %>
      <span class="og-eyebrow"><%- breadcrumb %></span>
    <% } else { %>
      <span class="og-eyebrow">Empire · <%= (typeof active !== 'undefined' ? active.toUpperCase() : 'HUB') %></span>
    <% } %>
  </div>

  <div class="og-topbar__actions">
    <div class="og-topbar__grade" title="Votre grade actuel">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h12l-2 5 4 3-4 3 2 5H6l2-5-4-3 4-3Z"/></svg>
      <span class="og-mono">SOLDAT · N.I</span>
    </div>

    <div class="og-lang" data-testid="lang-switcher">
      <button class="og-lang__btn is-active" data-lang="fr">FR</button>
      <button class="og-lang__btn" data-lang="en">EN</button>
      <button class="og-lang__btn" data-lang="ar">العربية</button>
    </div>

    <button class="og-topbar__icon" aria-label="Notifications" data-testid="topbar-notifs">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a2 2 0 0 0 3.4 0"/></svg>
      <span class="og-topbar__dot"></span>
    </button>

    <a href="/profile" class="og-topbar__profile" data-testid="topbar-profile">
      <span class="og-topbar__avatar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
      </span>
    </a>
  </div>
</header>
