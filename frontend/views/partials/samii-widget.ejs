<!-- OG EMPIRE — SAMII WIDGET (flottant, discret, présent partout) -->
<div class="samii-widget" id="samii-widget" data-open="false">
  <button class="samii-widget__trigger" id="samii-widget-trigger" aria-label="Ouvrir SAMII">
    <span class="samii-widget__aura"></span>
    <span class="samii-widget__aura samii-widget__aura--2"></span>
    <svg class="samii-widget__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 8V4H8"/>
      <rect width="16" height="12" x="4" y="8" rx="2"/>
      <path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>
    </svg>
    <span class="samii-widget__label">SAMII</span>
  </button>

  <div class="samii-widget__panel" id="samii-widget-panel" role="dialog" aria-label="Assistant SAMII">
    <header class="samii-widget__header">
      <div class="samii-widget__id">
        <div class="samii-widget__avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2M20 14h2M15 13v2M9 13v2"/></svg>
        </div>
        <div>
          <p class="samii-widget__name">SAMII</p>
          <p class="samii-widget__status"><span class="og-badge og-badge--live">OPÉRATIONNEL</span></p>
        </div>
      </div>
      <div class="samii-widget__actions">
        <button class="samii-widget__toggle" id="samii-widget-toggle" data-samii-on="true" aria-label="Activer/Désactiver SAMII">
          <span class="samii-widget__toggle-track"><span class="samii-widget__toggle-dot"></span></span>
          <span class="samii-widget__toggle-label">ON</span>
        </button>
        <a href="/samii" class="samii-widget__expand" aria-label="Ouvrir SAMII en plein écran">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        </a>
        <button class="samii-widget__close" id="samii-widget-close" aria-label="Fermer">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </header>

    <div class="samii-widget__feed" id="samii-widget-feed">
      <div class="samii-msg samii-msg--bot">
        <div class="samii-msg__bubble">
          Bienvenue, Général. Je suis <b>SAMII</b>, votre stratège.<br>
          Comment puis-je vous aider aujourd'hui ?
        </div>
      </div>
      <div class="samii-widget__suggestions">
        <button class="samii-chip" data-msg="Fais le point sur mon empire">📊 Point du jour</button>
        <button class="samii-chip" data-msg="Propose-moi une mission stratégique">🎯 Mission stratégique</button>
        <button class="samii-chip" data-msg="Analyse mes opportunités">🔎 Radar d'opportunités</button>
      </div>
    </div>

    <form class="samii-widget__form" id="samii-widget-form">
      <input type="text" id="samii-widget-input" placeholder="Parler à SAMII…" autocomplete="off">
      <button type="submit" aria-label="Envoyer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/></svg>
      </button>
    </form>
  </div>
</div>

<script src="/js/samii-widget.js" defer></script>
