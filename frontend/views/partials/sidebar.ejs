<!-- OG EMPIRE — SIDEBAR (nav principale, présente sur Hub/QG/pages internes) -->
<aside class="og-sidebar" id="og-sidebar" data-collapsed="false">
  <div class="og-sidebar__logo">
    <a href="/" aria-label="Retour à l'accueil">
      <svg class="og-sidebar__crest" viewBox="0 0 48 48" fill="none">
        <defs>
          <linearGradient id="ogCrestGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#F0C651"/>
            <stop offset=".5" stop-color="#D4AF37"/>
            <stop offset="1" stop-color="#9C7A2E"/>
          </linearGradient>
        </defs>
        <path d="M24 3 L42 10 V26 C42 34 34 42 24 45 C14 42 6 34 6 26 V10 Z" stroke="url(#ogCrestGrad)" stroke-width="1.5" fill="rgba(212,175,55,0.06)"/>
        <text x="24" y="30" text-anchor="middle" font-family="Cinzel" font-weight="800" font-size="14" fill="url(#ogCrestGrad)">OG</text>
      </svg>
      <div class="og-sidebar__brand">
        <span class="og-sidebar__name">OG · EMPIRE</span>
        <span class="og-sidebar__tag">Du soldat au général</span>
      </div>
    </a>
  </div>

  <nav class="og-sidebar__nav">
    <a href="/hub" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='hub') ? 'is-active' : '' %>" data-testid="nav-hub">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 3l9 9M5 10v10h14V10"/></svg>
      <span>Hub</span>
    </a>
    <a href="/profile" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='profile') ? 'is-active' : '' %>" data-testid="nav-profile">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
      <span>Profil</span>
    </a>
    <a href="/academy" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='academy') ? 'is-active' : '' %>" data-testid="nav-academy">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c2 2 4 3 6 3s4-1 6-3v-5"/></svg>
      <span>Académie</span>
    </a>
    <a href="/marketplace" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='marketplace') ? 'is-active' : '' %>" data-testid="nav-marketplace">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18l-1 12H4Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
      <span>Marketplace</span>
    </a>
    <a href="/community" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='community') ? 'is-active' : '' %>" data-testid="nav-community">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>Community</span>
    </a>
    <a href="/coffre" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='coffre') ? 'is-active' : '' %>" data-testid="nav-coffre">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="14" cy="12" r="3"/><path d="M14 9v-1M14 15v1M17 12h1M10 12H9"/></svg>
      <span>Coffre OG</span>
    </a>
    <a href="/dashboard" class="og-sidebar__link <%= (typeof active !== 'undefined' && active==='dashboard') ? 'is-active' : '' %>" data-testid="nav-dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
      <span>Dashboard</span>
    </a>
    <a href="/samii" class="og-sidebar__link og-sidebar__link--samii <%= (typeof active !== 'undefined' && active==='samii') ? 'is-active' : '' %>" data-testid="nav-samii">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2M20 14h2M15 13v2M9 13v2"/></svg>
      <span>SAMII</span>
    </a>
  </nav>

  <div class="og-sidebar__footer">
    <a href="/settings" class="og-sidebar__link og-sidebar__link--sub <%= (typeof active !== 'undefined' && active==='settings') ? 'is-active' : '' %>" data-testid="nav-settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
      <span>Paramètres</span>
    </a>
    <button class="og-sidebar__collapse" id="og-sidebar-collapse" aria-label="Réduire le menu" data-testid="sidebar-collapse-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18 9 12l6-6"/></svg>
    </button>
  </div>
</aside>
