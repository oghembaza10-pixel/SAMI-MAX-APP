    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #070809;
            --bg-deep: #040506;
            --bg-card: #0e1012;
            --bg-card-hover: #13171a;
            --bg-elevated: #111417;

            --gold: #D4A94A;
            --gold-bright: #F2CC78;
            --gold-soft: rgba(212,169,74,0.10);
            --gold-soft-strong: rgba(212,169,74,0.16);
            --gold-border: rgba(212,169,74,0.26);

            --blue: #00D4FF;
            --blue-bright: #5FD4FF;
            --blue-soft: rgba(0,212,255,0.08);
            --blue-glow: rgba(0,212,255,0.22);
            --blue-border: rgba(0,212,255,0.42);

            --silver: #C7CDD3;
            --silver-bright: #E8ECEF;
            --silver-soft: rgba(199,205,211,0.08);
            --silver-glow: rgba(199,205,211,0.18);
            --silver-border: rgba(199,205,211,0.32);

            --green: #22c55e;
            --green-soft: rgba(34,197,94,0.10);

            --text-main: #F7F7F5;
            --text-muted: #999d9f;
            --text-dim: #64696c;
            --text-faint: #414548;

            --border: 1px solid rgba(255,255,255,0.075);
            --border-soft: 1px solid rgba(255,255,255,0.055);
            --border-gold: 1px solid var(--gold-border);
            --border-blue: 1px solid var(--blue-border);

            --font-display: 'Cinzel', serif;
            --font-body: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;

            --r: 16px;
            --r-sm: 12px;

            --shadow-card:
                0 18px 50px rgba(0,0,0,0.28),
                0 2px 8px rgba(0,0,0,0.28),
                inset 0 1px 0 rgba(255,255,255,0.035);

            --shadow-blue:
                0 0 0 1px rgba(0,212,255,0.15),
                0 0 24px rgba(0,212,255,0.11),
                0 18px 55px rgba(0,0,0,0.36);

            --shadow-gold:
                0 0 0 1px rgba(212,169,74,0.12),
                0 0 28px rgba(212,169,74,0.11),
                0 18px 55px rgba(0,0,0,0.34);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
            background: var(--bg-deep);
        }

        body {
            position: relative;
            background:
                radial-gradient(circle at 50% -10%, rgba(212,169,74,0.065), transparent 32%),
                radial-gradient(circle at 8% 42%, rgba(0,212,255,0.025), transparent 28%),
                radial-gradient(circle at 92% 72%, rgba(0,212,255,0.018), transparent 26%),
                var(--bg);
            color: var(--text-main);
            font-family: var(--font-body);
            min-height: 100vh;
            width: 100%;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -1;
            opacity: .18;
            background-image:
                linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
            background-size: 72px 72px;
            mask-image: linear-gradient(to bottom, black, transparent 75%);
        }

        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 50%;
            width: min(900px, 90vw);
            height: 1px;
            transform: translateX(-50%);
            background: linear-gradient(
                90deg,
                transparent,
                rgba(212,169,74,.35),
                rgba(0,212,255,.45),
                rgba(212,169,74,.35),
                transparent
            );
            box-shadow: 0 0 35px rgba(0,212,255,.14);
            pointer-events: none;
            z-index: 500;
        }

        ::selection {
            background: rgba(0,212,255,.24);
            color: #fff;
        }

        a,
        button,
        input,
        select {
            -webkit-tap-highlight-color: transparent;
        }

        button,
        a {
            transition:
                color .25s ease,
                background .25s ease,
                border-color .25s ease,
                box-shadow .25s ease,
                transform .25s cubic-bezier(.2,.8,.2,1),
                opacity .25s ease;
        }

        /* TOP BAR */

        .top-bar {
            position: sticky;
            top: 0;
            z-index: 200;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
            background:
                linear-gradient(
                    180deg,
                    rgba(8,10,11,.96),
                    rgba(8,10,11,.82)
                );
            backdrop-filter: blur(22px) saturate(150%);
            -webkit-backdrop-filter: blur(22px) saturate(150%);
            border-bottom: 1px solid rgba(255,255,255,.07);
            box-shadow:
                0 12px 40px rgba(0,0,0,.24),
                inset 0 -1px 0 rgba(212,169,74,.035);
        }

        .top-bar::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent 5%,
                rgba(212,169,74,.18),
                rgba(0,212,255,.16),
                transparent 95%
            );
            pointer-events: none;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand img {
            width: 31px;
            height: 31px;
            filter:
                drop-shadow(0 0 8px rgba(212,169,74,.18))
                drop-shadow(0 0 14px rgba(0,212,255,.06));
        }

        .brand__text {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.05rem;
            color: #fff;
            letter-spacing: .035em;
            text-shadow: 0 0 18px rgba(255,255,255,.06);
        }

        .brand__sub {
            display: none;
            font-family: var(--font-mono);
            font-size: .58rem;
            color: var(--gold);
            letter-spacing: .15em;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .top-bar__right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .lang-switch {
            display: flex;
            gap: 2px;
            font-family: var(--font-mono);
            font-size: .64rem;
            padding: 3px;
            border: 1px solid rgba(255,255,255,.055);
            border-radius: 9px;
            background: rgba(255,255,255,.018);
        }

        .lang-switch span {
            padding: 5px 7px;
            border-radius: 6px;
            cursor: pointer;
            color: var(--text-dim);
            transition: .2s ease;
        }

        .lang-switch span.active,
        .lang-switch span:hover {
            color: var(--blue-bright);
            background: var(--blue-soft);
            box-shadow: inset 0 0 0 1px rgba(0,212,255,.09);
        }

        .btn-login-top {
            position: relative;
            overflow: hidden;
            padding: 8px 16px;
            border-radius: 9px;
            text-decoration: none;
            font-size: .77rem;
            font-weight: 800;
            border: 1px solid var(--silver-border);
            background-color: var(--silver-soft);
            color: var(--silver-bright);
            cursor: pointer;
            font-family: var(--font-body);
            text-shadow: 0 1px 0 rgba(255,255,255,.15), 0 0 16px rgba(199,205,211,.22);
        }

        .btn-login-top::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                110deg,
                transparent 20%,
                rgba(0,212,255,.12) 50%,
                transparent 80%
            );
            transform: translateX(-120%);
            transition: transform .55s ease;
        }

        .btn-login-top:hover {
            color: var(--blue-bright);
            border-color: var(--blue-border);
            background: var(--blue-soft);
            box-shadow: 0 0 20px rgba(0,212,255,.08);
            transform: translateY(-1px);
        }

        .btn-login-top:hover::before {
            transform: translateX(120%);
        }

        /* HERO */

        .hero {
            position: relative;
            max-width: 850px;
            margin: 0 auto;
            padding: 62px 20px 10px;
            text-align: center;
        }

        .hero::before {
            content: "";
            position: absolute;
            top: 20px;
            left: 50%;
            width: 440px;
            height: 230px;
            max-width: 90vw;
            transform: translateX(-50%);
            background:
                radial-gradient(
                    ellipse,
                    rgba(212,169,74,.095) 0%,
                    rgba(0,212,255,.035) 30%,
                    transparent 70%
                );
            filter: blur(20px);
            pointer-events: none;
            z-index: -1;
        }

        .hero::after {
            content: "";
            position: absolute;
            top: 54px;
            left: 50%;
            width: 1px;
            height: 95px;
            transform: translateX(-50%);
            background: linear-gradient(
                to bottom,
                rgba(212,169,74,.32),
                transparent
            );
            opacity: .55;
            pointer-events: none;
        }

        .hero-badge {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 17px;
            border-radius: 30px;
            background:
                linear-gradient(
                    135deg,
                    rgba(212,169,74,.10),
                    rgba(0,212,255,.045)
                );
            border: 1px solid rgba(212,169,74,.27);
            box-shadow:
                0 0 22px rgba(212,169,74,.07),
                inset 0 1px 0 rgba(255,255,255,.045);
            font-family: var(--font-mono);
            font-size: .66rem;
            color: var(--gold-bright);
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-bottom: 27px;
        }

        .hero-badge::before {
            content: "";
            position: absolute;
            inset: -1px;
            border-radius: inherit;
            border: 1px solid rgba(0,212,255,.08);
            pointer-events: none;
        }

        .hero-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            box-shadow:
                0 0 6px var(--green),
                0 0 14px rgba(34,197,94,.38);
            animation: pulse-status 2.2s ease-in-out infinite;
        }

        @keyframes pulse-status {
            0%, 100% {
                opacity: 1;
                box-shadow: 0 0 6px var(--green), 0 0 14px rgba(34,197,94,.28);
            }
            50% {
                opacity: .65;
                box-shadow: 0 0 3px var(--green), 0 0 8px rgba(34,197,94,.16);
            }
        }

        .hero h1 {
            position: relative;
            font-family: var(--font-display);
            font-size: clamp(2rem, 7vw, 3.7rem);
            font-weight: 800;
            color: #fff;
            line-height: 1.13;
            letter-spacing: -.025em;
            margin-bottom: 16px;
            text-shadow:
                0 2px 24px rgba(0,0,0,.55),
                0 0 45px rgba(255,255,255,.025);
        }

        .hero h1 .accent {
            color: var(--gold);
            text-shadow:
                0 0 25px rgba(212,169,74,.18),
                0 0 55px rgba(212,169,74,.07);
        }

        /* Signature OG — écho du logo or/argent en miroir */
        .hero-divider {
            width: 92px;
            height: 2px;
            margin: 18px auto 20px;
            border-radius: 2px;
            background: linear-gradient(
                90deg,
                transparent,
                var(--gold) 30%,
                var(--silver-bright) 70%,
                transparent
            );
            box-shadow:
                0 0 14px rgba(212,169,74,.35),
                0 0 14px rgba(199,205,211,.25);
        }

        .hero-tagline {
            font-family: var(--font-mono);
            font-size: .91rem;
            color: var(--text-muted);
            letter-spacing: .045em;
            margin-bottom: 11px;
        }

        .hero-tagline b {
            color: var(--gold);
            font-weight: 700;
        }

        .hero p.desc {
            color: #74797b;
            font-size: .86rem;
            max-width: 530px;
            margin: 15px auto 0;
            line-height: 1.75;
        }

        .hero-ctas {
            display: flex;
            gap: 11px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        /* PREMIUM BUTTONS */

        .btn-primary {
            position: relative;
            overflow: hidden;
            padding: 13px 27px;
            border-radius: 11px;
            background:
                linear-gradient(
                    135deg,
                    #D4A94A 0%,
                    #E6B95F 45%,
                    #F0C878 100%
                );
            color: #050505;
            font-weight: 800;
            font-size: .84rem;
            text-decoration: none;
            border: 1px solid rgba(255,220,145,.35);
            cursor: pointer;
            font-family: var(--font-body);
            box-shadow:
                0 8px 24px rgba(212,169,74,.13),
                0 2px 5px rgba(0,0,0,.4),
                inset 0 1px 0 rgba(255,255,255,.34);
            transform: translateZ(0);
        }

        .btn-primary::before,
        .auth-submit::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: -80%;
            width: 55%;
            transform: skewX(-18deg);
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,.42),
                transparent
            );
            transition: left .65s cubic-bezier(.2,.8,.2,1);
        }

        .btn-primary::after,
        .auth-submit::after {
            content: "";
            position: absolute;
            inset: -2px;
            border-radius: inherit;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(0,212,255,.25),
                transparent
            );
            opacity: 0;
            transition: opacity .3s ease;
            z-index: -1;
        }

        .btn-primary:hover {
            color: #000;
            transform: translateY(-2px);
            box-shadow:
                0 12px 30px rgba(212,169,74,.2),
                0 0 0 1px rgba(0,212,255,.15),
                0 0 24px rgba(0,212,255,.10),
                inset 0 1px 0 rgba(255,255,255,.42);
        }

        .btn-primary:hover::before,
        .auth-submit:hover::before {
            left: 130%;
        }

        .btn-primary:hover::after,
        .auth-submit:hover::after {
            opacity: 1;
        }

        .btn-primary:active,
        .auth-submit:active {
            transform: translateY(0) scale(.985);
        }

        .btn-secondary {
            position: relative;
            padding: 13px 23px;
            border-radius: 11px;
            background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.012));
            border: 1px solid var(--silver-border);
            color: var(--silver-bright);
            font-weight: 800;
            font-size: .84rem;
            text-decoration: none;
            cursor: pointer;
            text-shadow: 0 1px 0 rgba(255,255,255,.15), 0 0 18px rgba(199,205,211,.22);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.06),
                0 8px 24px rgba(0,0,0,.14);
            transition: color .3s ease, border-color .35s ease, box-shadow .35s ease, transform .35s ease;
        }

        .btn-secondary:hover {
            color: var(--blue-bright);
            border-color: var(--blue-border);
            background: var(--blue-soft);
            text-shadow: 0 0 18px rgba(0,212,255,.35);
            box-shadow:
                0 0 22px rgba(0,212,255,.14),
                inset 0 1px 0 rgba(255,255,255,.06);
            transform: translateY(-2px);
        }

        /* SECTION HEADINGS */

        .section-head {
            display: flex;
            align-items: center;
            gap: 9px;
            margin: 0 0 15px;
            padding: 0 4px;
        }

        .section-head::after {
            content: "";
            height: 1px;
            flex: 1;
            margin-left: 5px;
            background: linear-gradient(
                90deg,
                rgba(255,255,255,.06),
                transparent
            );
        }

        .section-head__icon {
            font-size: .95rem;
            filter: drop-shadow(0 0 6px rgba(212,169,74,.15));
        }

        .section-head__title {
            font-size: .81rem;
            font-weight: 700;
            color: #f3f3f2;
            letter-spacing: .01em;
        }

        .section-head__sub {
            font-size: .63rem;
            color: var(--text-faint);
            margin-left: auto;
            font-family: var(--font-mono);
            letter-spacing: .05em;
        }

        /* CARDS */

        .preview-section {
            max-width: 1180px;
            margin: 62px auto 0;
            padding: 0 16px;
        }

        .preview-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 13px;
        }

        @media (min-width: 860px) {
            .preview-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        .p-card {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at 100% 0%,
                    rgba(0,212,255,.025),
                    transparent 34%
                ),
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.025),
                    rgba(255,255,255,.008)
                ),
                var(--bg-card);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: var(--r);
            padding: 19px;
            box-shadow: var(--shadow-card);
            transition:
                transform .35s cubic-bezier(.2,.8,.2,1),
                background .35s ease,
                border-color .35s ease,
                box-shadow .35s ease;
        }

        .p-card::before,
        .m-card::before,
        .s-card::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            border-radius: inherit;
            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,.045),
                    transparent 25%,
                    transparent 72%,
                    rgba(0,212,255,.025)
                );
            opacity: .7;
        }

        .p-card::after,
        .m-card::after,
        .s-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -95px;
            top: -95px;
            border-radius: 50%;
            background: rgba(0,212,255,.13);
            filter: blur(40px);
            opacity: 0;
            pointer-events: none;
            transition: opacity .4s ease;
        }

        .p-card:hover,
        .m-card:hover,
        .s-card:hover {
            background:
                radial-gradient(
                    circle at 100% 0%,
                    rgba(0,212,255,.07),
                    transparent 38%
                ),
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.035),
                    rgba(255,255,255,.01)
                ),
                var(--bg-card-hover);
            border-color: rgba(0,212,255,.34);
            box-shadow: var(--shadow-blue);
            transform: translateY(-4px);
        }

        .p-card:hover::after,
        .m-card:hover::after,
        .s-card:hover::after {
            opacity: 1;
        }

        .p-card__top {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 15px;
        }

        .p-card__badge {
            width: 41px;
            height: 41px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.12rem;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.045);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.045),
                0 7px 18px rgba(0,0,0,.18);
        }

        .p-card__badge--gold {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .p-card__badge--shopify {
            background: rgba(149,197,86,.10);
            color: #95c556;
        }

        .p-card__badge--whatsapp {
            background: var(--green-soft);
            color: var(--green);
        }

        .p-card__badge--dash {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .p-card:hover .p-card__badge--gold,
        .p-card:hover .p-card__badge--dash {
            box-shadow:
                0 0 18px rgba(212,169,74,.10),
                inset 0 1px 0 rgba(255,255,255,.05);
        }

        .p-card__title {
            font-size: .87rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -.005em;
        }

        .p-card__desc {
            font-size: .71rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .p-card__stat {
            position: relative;
            z-index: 1;
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 1.52rem;
            color: #fff;
            margin-bottom: 3px;
            letter-spacing: -.03em;
        }

        .p-card__stat span {
            font-size: .91rem;
            color: var(--text-dim);
            font-weight: 500;
        }

        .p-card__statlabel {
            position: relative;
            z-index: 1;
            font-size: .67rem;
            color: var(--text-dim);
            margin-bottom: 15px;
        }

        .p-card__status {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .71rem;
            color: var(--text-dim);
            margin-bottom: 14px;
        }

        .p-card__status .sdot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--text-faint);
            box-shadow: 0 0 0 3px rgba(255,255,255,.025);
        }

        .p-card-btn {
            position: relative;
            z-index: 2;
            display: block;
            width: 100%;
            text-align: center;
            padding: 9px 10px;
            border-radius: 9px;
            background:
                linear-gradient(
                    135deg,
                    rgba(212,169,74,.085),
                    rgba(212,169,74,.035)
                );
            color: var(--gold);
            border: 1px solid rgba(212,169,74,.22);
            font-size: .72rem;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            font-family: var(--font-body);
        }

        .p-card-btn:hover {
            color: var(--blue-bright);
            border-color: var(--blue-border);
            background: var(--blue-soft);
            box-shadow:
                0 0 20px rgba(0,212,255,.08),
                inset 0 1px 0 rgba(255,255,255,.035);
            transform: translateY(-1px);
        }

        .p-card--globe {
            position: relative;
            overflow: hidden;
            grid-column: span 1;
        }

        @media (min-width: 860px) {
            .p-card--globe {
                grid-column: span 1;
            }
        }

        .globe-mini {
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 160px;
            height: 160px;
            opacity: .72;
            pointer-events: none;
            filter: drop-shadow(0 0 13px rgba(212,169,74,.08));
            transition: opacity .35s ease, transform .5s ease;
        }

        .p-card--globe:hover .globe-mini {
            opacity: .95;
            transform: rotate(4deg) scale(1.03);
        }

        /* MODULES */

        .modules-section {
            max-width: 1180px;
            margin: 47px auto 0;
            padding: 0 16px;
        }

        .modules-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 11px;
        }

        @media (min-width: 640px) {
            .modules-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        .m-card {
            position: relative;
            overflow: hidden;
            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.025),
                    rgba(255,255,255,.008)
                ),
                var(--bg-card);
            border: 1px solid rgba(255,255,255,.07);
            border-radius: 13px;
            padding: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow:
                0 12px 30px rgba(0,0,0,.2),
                inset 0 1px 0 rgba(255,255,255,.025);
            transition:
                all .3s cubic-bezier(.2,.8,.2,1);
        }

        .m-card:hover {
            transform: translateY(-3px);
        }

        .m-card__icon {
            position: relative;
            z-index: 1;
            width: 35px;
            height: 35px;
            border-radius: 9px;
            background:
                linear-gradient(
                    145deg,
                    rgba(212,169,74,.12),
                    rgba(212,169,74,.045)
                );
            color: var(--gold);
            border: 1px solid rgba(212,169,74,.11);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .96rem;
            flex-shrink: 0;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.035);
            transition: all .3s ease;
        }

        .m-card:hover .m-card__icon {
            color: var(--blue-bright);
            border-color: rgba(0,212,255,.18);
            background: var(--blue-soft);
            box-shadow: 0 0 18px rgba(0,212,255,.07);
        }

        .m-card__name {
            position: relative;
            z-index: 1;
            font-size: .77rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.25;
        }

        .m-card__desc {
            position: relative;
            z-index: 1;
            font-size: .63rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        .m-check {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            background: rgba(34,197,94,.9);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(34,197,94,.12);
        }

        .m-check svg {
            width: 10px;
            height: 10px;
            color: #000;
        }

        /* SOON */

        .soon-section {
            max-width: 1180px;
            margin: 35px auto 0;
            padding: 0 16px;
        }

        .soon-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 11px;
        }

        @media (min-width: 640px) {
            .soon-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        .s-card {
            position: relative;
            overflow: hidden;
            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.015),
                    rgba(255,255,255,.005)
                ),
                rgba(255,255,255,.008);
            border: 1px solid rgba(255,255,255,.055);
            border-radius: 13px;
            padding: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: .62;
            box-shadow:
                0 10px 25px rgba(0,0,0,.13),
                inset 0 1px 0 rgba(255,255,255,.02);
            transition:
                opacity .3s ease,
                border-color .3s ease,
                box-shadow .3s ease,
                transform .3s ease;
        }

        .s-card:hover {
            opacity: .9;
            transform: translateY(-2px);
        }

        .s-card__icon {
            position: relative;
            z-index: 1;
            width: 35px;
            height: 35px;
            border-radius: 9px;
            background: rgba(255,255,255,.035);
            color: var(--text-dim);
            border: 1px solid rgba(255,255,255,.045);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .96rem;
            flex-shrink: 0;
        }

        .s-card__name {
            position: relative;
            z-index: 1;
            font-size: .77rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .s-card__desc {
            position: relative;
            z-index: 1;
            font-size: .63rem;
            color: var(--text-dim);
        }

        .s-lock {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: .76rem;
            color: var(--text-faint);
        }

        .soon-banner {
            position: relative;
            overflow: hidden;
            max-width: 1148px;
            margin: 14px auto 0;
            padding: 16px 20px;
            background:
                radial-gradient(
                    circle at 0% 50%,
                    rgba(212,169,74,.075),
                    transparent 30%
                ),
                linear-gradient(
                    90deg,
                    rgba(212,169,74,.075),
                    rgba(0,212,255,.025)
                );
            border: 1px solid rgba(212,169,74,.20);
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-left: 16px;
            margin-right: 16px;
            box-shadow:
                0 14px 34px rgba(0,0,0,.16),
                inset 0 1px 0 rgba(255,255,255,.025);
        }

        .soon-banner::after {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            right: 0;
            width: 35%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(0,212,255,.045)
            );
            pointer-events: none;
        }

        .soon-banner__icon {
            position: relative;
            z-index: 1;
            font-size: 1.25rem;
            filter: drop-shadow(0 0 8px rgba(212,169,74,.15));
        }

        .soon-banner__text {
            position: relative;
            z-index: 1;
            font-size: .79rem;
            color: var(--text-main);
            line-height: 1.5;
        }

        .soon-banner__text strong {
            color: var(--gold);
        }

        /* PILLS */

        .pills-bar {
            max-width: 1180px;
            margin: 43px auto 0;
            padding: 19px 16px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
            border-top: 1px solid rgba(255,255,255,.065);
            border-bottom: 1px solid rgba(255,255,255,.065);
            position: relative;
        }

        .pills-bar::before {
            content: "";
            position: absolute;
            top: -1px;
            left: 15%;
            right: 15%;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(0,212,255,.12),
                transparent
            );
        }

        @media (min-width: 768px) {
            .pills-bar {
                grid-template-columns: repeat(5, 1fr);
            }
        }

        .pill {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
        }

        .pill__icon {
            font-size: 1.05rem;
            color: var(--gold);
            flex-shrink: 0;
            filter: drop-shadow(0 0 7px rgba(212,169,74,.10));
            transition: color .25s ease, filter .25s ease;
        }

        .pill:hover .pill__icon {
            color: var(--blue-bright);
            filter: drop-shadow(0 0 8px rgba(0,212,255,.22));
        }

        .pill__title {
            font-size: .73rem;
            font-weight: 700;
            color: #fff;
        }

        .pill__desc {
            font-size: .61rem;
            color: var(--text-dim);
            margin-top: 2px;
        }

        /* AUTH */

        .auth-section {
            max-width: 480px;
            margin: 70px auto 0;
            padding: 0 16px;
        }

        .auth-header {
            position: relative;
            text-align: center;
            margin-bottom: 22px;
        }

        .auth-header::before {
            content: "";
            position: absolute;
            left: 50%;
            top: -30px;
            width: 130px;
            height: 1px;
            transform: translateX(-50%);
            background: linear-gradient(
                90deg,
                transparent,
                rgba(212,169,74,.35),
                rgba(0,212,255,.28),
                transparent
            );
        }

        .auth-header h2 {
            font-family: var(--font-display);
            font-size: 1.42rem;
            color: #fff;
            margin-bottom: 7px;
            letter-spacing: -.01em;
            text-shadow: 0 0 25px rgba(255,255,255,.035);
        }

        .auth-header p {
            font-size: .79rem;
            color: var(--text-dim);
        }

        .auth-tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 16px;
            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.025),
                    rgba(255,255,255,.008)
                ),
                var(--bg-card);
            border-radius: 12px;
            padding: 4px;
            border: 1px solid rgba(255,255,255,.07);
            box-shadow:
                0 12px 32px rgba(0,0,0,.2),
                inset 0 1px 0 rgba(255,255,255,.025);
        }

        .auth-tab {
            flex: 1;
            padding: 11px 6px;
            border-radius: 9px;
            border: none;
            background: transparent;
            color: var(--text-dim);
            font-weight: 700;
            font-size: .79rem;
            cursor: pointer;
            transition: all .25s ease;
            font-family: var(--font-body);
        }

        .auth-tab:hover:not(.active) {
            color: var(--blue-bright);
            background: var(--blue-soft);
        }

        .auth-tab.active {
            background:
                linear-gradient(
                    135deg,
                    var(--gold),
                    #F0C878
                );
            color: #000;
            box-shadow:
                0 5px 16px rgba(212,169,74,.13),
                inset 0 1px 0 rgba(255,255,255,.32);
        }

        .auth-card {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at 100% 0%,
                    rgba(0,212,255,.035),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 0% 100%,
                    rgba(212,169,74,.035),
                    transparent 35%
                ),
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.025),
                    rgba(255,255,255,.008)
                ),
                var(--bg-card);
            border: 1px solid rgba(212,169,74,.23);
            border-radius: var(--r);
            padding: 22px 18px;
            box-shadow:
                0 25px 70px rgba(0,0,0,.34),
                0 0 40px rgba(212,169,74,.035),
                inset 0 1px 0 rgba(255,255,255,.035);
        }

        .auth-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 10%;
            right: 10%;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(212,169,74,.35),
                rgba(0,212,255,.22),
                transparent
            );
            pointer-events: none;
        }

        .step-indicator {
            display: flex;
            gap: 6px;
            margin-bottom: 16px;
        }

        .step-dot {
            flex: 1;
            height: 3px;
            border-radius: 3px;
            background: rgba(255,255,255,.07);
            transition: .35s ease;
        }

        .step-dot.done {
            background: linear-gradient(
                90deg,
                var(--gold),
                var(--blue)
            );
            box-shadow:
                0 0 9px rgba(0,212,255,.15),
                0 0 9px rgba(212,169,74,.12);
        }

        .step-label {
            font-family: var(--font-mono);
            font-size: .61rem;
            color: var(--text-dim);
            text-align: center;
            margin-bottom: 15px;
            letter-spacing: .045em;
        }

        .form-step {
            display: none;
        }

        .form-step.active {
            display: block;
            animation: stepin .3s cubic-bezier(.2,.8,.2,1) both;
        }

        @keyframes stepin {
            from {
                opacity: 0;
                transform: translateX(10px);
                filter: blur(2px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
                filter: blur(0);
            }
        }

        .type-choice {
            display: flex;
            gap: 8px;
            margin-bottom: 14px;
        }

        .type-choice label {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 12px 6px;
            border-radius: 10px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,.075);
            background: rgba(255,255,255,.018);
            font-size: .73rem;
            color: var(--text-dim);
            transition: .25s ease;
        }

        .type-choice label:hover {
            border-color: rgba(0,212,255,.28);
            background: var(--blue-soft);
            color: #fff;
            box-shadow: 0 0 18px rgba(0,212,255,.06);
        }

        .type-choice input {
            display: none;
        }

        .type-choice label:has(input:checked) {
            border-color: var(--blue-border);
            background:
                linear-gradient(
                    145deg,
                    rgba(0,212,255,.085),
                    rgba(212,169,74,.045)
                );
            color: #fff;
            box-shadow:
                0 0 20px rgba(0,212,255,.07),
                inset 0 1px 0 rgba(255,255,255,.035);
        }

        .type-choice .icon {
            font-size: 1.2rem;
        }

        .pa-intro {
            font-size: .79rem;
            color: var(--text-dim);
            line-height: 1.6;
            margin-bottom: 16px;
        }

        .partner-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            margin-bottom: 16px;
        }

        @media (min-width: 480px) {
            .partner-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .partner-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            padding: 14px 8px;
            border-radius: 12px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,.075);
            background: rgba(255,255,255,.018);
            font-size: .73rem;
            color: var(--text-dim);
            text-align: center;
            transition: .25s ease;
        }

        .partner-card:hover {
            border-color: rgba(0,212,255,.28);
            background: var(--blue-soft);
            color: #fff;
            box-shadow: 0 0 18px rgba(0,212,255,.06);
        }

        .partner-card input {
            display: none;
        }

        .partner-card:has(input:checked) {
            border-color: var(--blue-border);
            background:
                linear-gradient(
                    145deg,
                    rgba(0,212,255,.085),
                    rgba(212,169,74,.045)
                );
            color: #fff;
            box-shadow:
                0 0 20px rgba(0,212,255,.07),
                inset 0 1px 0 rgba(255,255,255,.035);
        }

        .partner-card .icon {
            font-size: 1.25rem;
        }

        .field-group {
            margin-bottom: 13px;
        }

        .field-group label {
            display: block;
            font-family: var(--font-mono);
            font-size: .61rem;
            text-transform: uppercase;
            letter-spacing: .055em;
            color: var(--text-dim);
            margin-bottom: 6px;
        }

        .field-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .auth-card input,
        .auth-card select,
        .auth-card textarea {
            width: 100%;
            padding: 12px 13px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,.085);
            background:
                linear-gradient(
                    180deg,
                    rgba(255,255,255,.018),
                    rgba(0,0,0,.15)
                ),
                #050607;
            color: var(--text-main);
            font-size: 16px;
            font-family: var(--font-body);
            box-shadow:
                inset 0 1px 5px rgba(0,0,0,.3),
                0 1px 0 rgba(255,255,255,.015);
            transition:
                border-color .25s ease,
                box-shadow .25s ease,
                background .25s ease,
                transform .25s ease;
        }

        .auth-card input::placeholder,
        .auth-card textarea::placeholder {
            color: #474c4f;
        }

        .auth-card select option {
            background: #0a0a0a;
        }

        .auth-card textarea {
            resize: vertical;
            min-height: 80px;
            font-family: var(--font-body);
        }

        .auth-card input:hover,
        .auth-card select:hover,
        .auth-card textarea:hover {
            border-color: rgba(0,212,255,.18);
        }

        .auth-card input:focus,
        .auth-card select:focus,
        .auth-card textarea:focus {
            outline: none;
            border-color: var(--blue);
            background:
                linear-gradient(
                    180deg,
                    rgba(0,212,255,.025),
                    rgba(0,0,0,.12)
                ),
                #050607;
            box-shadow:
                0 0 0 3px rgba(0,212,255,.075),
                0 0 24px rgba(0,212,255,.10),
                inset 0 1px 6px rgba(0,0,0,.28);
        }

        #champ-autre-pays {
            display: none;
            margin-top: 8px;
        }

        .grade-preview {
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 12px;
            border-radius: 11px;
            background:
                linear-gradient(
                    135deg,
                    rgba(212,169,74,.085),
                    rgba(0,212,255,.025)
                );
            border: 1px solid rgba(212,169,74,.18);
            margin-bottom: 15px;
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.025),
                0 7px 20px rgba(0,0,0,.13);
        }

        .grade-preview::after {
            content: "";
            position: absolute;
            right: -40px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(0,212,255,.06);
            filter: blur(24px);
            pointer-events: none;
        }

        .grade-preview__icon {
            position: relative;
            z-index: 1;
            font-size: 1.2rem;
        }

        .grade-preview__text {
            position: relative;
            z-index: 1;
            font-size: .73rem;
            color: var(--text-dim);
            line-height: 1.45;
        }

        .grade-preview__text strong {
            color: var(--gold);
        }

        /* THEMES */

        .theme-picker {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            margin-bottom: 14px;
        }

        .theme-card {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            padding: 11px 10px;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,.075);
            background: rgba(255,255,255,.012);
            text-align: center;
            transition: .3s cubic-bezier(.2,.8,.2,1);
        }

        .theme-card:hover {
            transform: translateY(-2px);
            border-color: rgba(0,212,255,.28);
            background: var(--blue-soft);
            box-shadow: 0 0 20px rgba(0,212,255,.06);
        }

        .theme-card input {
            display: none;
        }

        .theme-card__preview {
            height: 24px;
            border-radius: 6px;
            margin-bottom: 6px;
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.22),
                0 5px 12px rgba(0,0,0,.18);
            transition: transform .3s ease, box-shadow .3s ease;
        }

        .theme-card:hover .theme-card__preview {
            transform: scale(1.025);
        }

        .theme-card--strategiste .theme-card__preview {
            background:
                linear-gradient(
                    90deg,
                    #8A9A5B,
                    #6b7a4f 48%,
                    #3a4230
                );
        }

        .theme-card--sagesse .theme-card__preview {
            background:
                linear-gradient(
                    90deg,
                    #D4A94A,
                    #C5A059 50%,
                    #7f6b35
                );
        }

        .theme-card--aventurier .theme-card__preview {
            background:
                linear-gradient(
                    90deg,
                    #5FD4FF,
                    #4e9db8 48%,
                    #d8c39a
                );
        }

        .theme-card--gaming .theme-card__preview {
            background:
                linear-gradient(
                    90deg,
                    #9d5cff,
                    #6946c5 45%,
                    #00e5ff
                );
        }

        .theme-card__name {
            font-size: .65rem;
            color: var(--text-dim);
            font-weight: 600;
        }

        .theme-card:has(input:checked) {
            border-color: var(--blue-border);
            background:
                linear-gradient(
                    145deg,
                    rgba(0,212,255,.08),
                    rgba(212,169,74,.035)
                );
            box-shadow:
                0 0 22px rgba(0,212,255,.08),
                inset 0 1px 0 rgba(255,255,255,.04);
        }

        .theme-card:has(input:checked)::after {
            content: "✓";
            position: absolute;
            top: 6px;
            right: 7px;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--blue);
            color: #001016;
            font-size: .62rem;
            font-weight: 900;
            box-shadow: 0 0 10px rgba(0,212,255,.28);
        }

        .theme-card:has(input:checked) .theme-card__name {
            color: #fff;
        }

        .theme-card--locked {
            cursor: not-allowed;
            opacity: .5;
        }

        .theme-card--locked:hover {
            transform: none;
            border-color: rgba(255,255,255,.075);
            background: rgba(255,255,255,.012);
            box-shadow: none;
        }

        .theme-card--locked .theme-card__preview {
            filter: grayscale(.6);
        }

        .theme-card__lock {
            margin-top: 4px;
            font-size: .58rem;
            color: var(--text-dim);
            font-weight: 700;
        }

        .btn-row {
            display: flex;
            gap: 10px;
            margin-top: 6px;
        }

        .auth-btn-back {
            padding: 13px 16px;
            border-radius: 11px;
            border: 1px solid rgba(255,255,255,.09);
            background: rgba(255,255,255,.018);
            color: var(--text-dim);
            font-weight: 700;
            font-size: .79rem;
            cursor: pointer;
            transition: all .25s ease;
        }

        .auth-btn-back:hover {
            color: var(--blue-bright);
            border-color: rgba(0,212,255,.28);
            background: var(--blue-soft);
            transform: translateX(-1px);
        }

        .auth-submit {
            position: relative;
            overflow: hidden;
            flex: 1;
            padding: 13px;
            border: 1px solid rgba(255,220,145,.32);
            border-radius: 11px;
            background:
                linear-gradient(
                    135deg,
                    var(--gold),
                    #F0C878
                );
            color: #000;
            font-weight: 800;
            font-size: .84rem;
            cursor: pointer;
            font-family: var(--font-body);
            box-shadow:
                0 8px 24px rgba(212,169,74,.13),
                0 2px 5px rgba(0,0,0,.35),
                inset 0 1px 0 rgba(255,255,255,.34);
        }

        .auth-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow:
                0 12px 30px rgba(212,169,74,.18),
                0 0 0 1px rgba(0,212,255,.16),
                0 0 25px rgba(0,212,255,.10),
                inset 0 1px 0 rgba(255,255,255,.4);
        }

        .auth-submit:active:not(:disabled) {
            transform: translateY(0) scale(.985);
        }

        .auth-submit:disabled {
            opacity: .5;
            cursor: not-allowed;
            box-shadow: none;
        }

        .auth-msg {
            text-align: center;
            margin-top: 13px;
            font-size: .77rem;
            color: #ff6b6b;
            min-height: 18px;
        }

        .auth-msg.ok {
            color: var(--green);
            text-shadow: 0 0 12px rgba(34,197,94,.16);
        }

        .forgot-link {
            display: block;
            text-align: right;
            font-size: .71rem;
            color: var(--text-dim);
            text-decoration: none;
            margin-top: -4px;
            margin-bottom: 12px;
            transition: color .2s ease;
        }

        .forgot-link:hover {
            color: var(--blue-bright);
        }

        /* LOGGED-IN NOTICE */

        body > div[style*="max-width:1180px"] > div {
            box-shadow:
                0 15px 40px rgba(0,0,0,.2),
                inset 0 1px 0 rgba(255,255,255,.025);
        }

        /* FOOTER */

        .site-footer {
            position: relative;
            border-top: 1px solid rgba(255,255,255,.065);
            padding: 28px 16px;
            margin-top: 70px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            text-align: center;
            background:
                linear-gradient(
                    180deg,
                    transparent,
                    rgba(0,0,0,.18)
                );
        }

        .site-footer::before {
            content: "";
            position: absolute;
            top: -1px;
            left: 30%;
            right: 30%;
            height: 1px;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(212,169,74,.22),
                rgba(0,212,255,.18),
                transparent
            );
        }

        @media (min-width: 768px) {
            .site-footer {
                flex-direction: row;
                justify-content: space-between;
                padding: 28px 32px;
            }
        }

        .site-footer__quote {
            font-family: var(--font-mono);
            color: var(--text-dim);
            font-size: .66rem;
            letter-spacing: .02em;
        }

        .social-links {
            display: flex;
            gap: 9px;
        }

        .social-links a {
            color: var(--text-dim);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 33px;
            height: 33px;
            border-radius: 9px;
            border: 1px solid rgba(255,255,255,.065);
            background: rgba(255,255,255,.012);
        }

        .social-links a:hover {
            color: var(--blue-bright);
            border-color: var(--blue-border);
            background: var(--blue-soft);
            box-shadow: 0 0 17px rgba(0,212,255,.07);
            transform: translateY(-2px);
        }

        .site-footer__meta {
            font-family: var(--font-mono);
            font-size: .62rem;
            color: var(--text-dim);
        }

        /* RESPONSIVE */

        @media (min-width: 768px) {
            .top-bar {
                padding: 17px 32px;
            }

            .brand__sub {
                display: block;
            }

            .auth-card {
                padding: 28px;
            }
        }

        @media (max-width: 520px) {
            .hero {
                padding-top: 52px;
            }

            .hero h1 {
                font-size: clamp(1.85rem, 9vw, 2.7rem);
            }

            .hero-tagline {
                font-size: .82rem;
            }

            .hero p.desc {
                font-size: .82rem;
            }

            .hero-ctas {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-primary,
            .btn-secondary {
                text-align: center;
                width: 100%;
            }

            .field-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .section-head__sub {
                display: none;
            }

            .soon-banner {
                align-items: flex-start;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>
<body>

    <header class="top-bar">
        <div class="brand">
            <img src="/og.png" alt="OG">
            <div>
                <div class="brand__text">SAMII OS</div>
                <div class="brand__sub" data-i18n="brand.sub">LE QG MONDIAL</div>
            </div>
        </div>
        <div class="top-bar__right">
            <div class="lang-switch">
                <span data-lang="fr" class="active">FR</span>
                <span data-lang="en">EN</span>
                <span data-lang="ar">AR</span>
                <span data-lang="zh">中</span>
            </div>
            <a href="#auth" class="btn-login-top" data-i18n="nav.login">Se connecter</a>
        </div>
    </header>

    <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
    <div style="max-width:1180px; margin:16px auto 0; padding:0 16px;">
        <div style="background:var(--gold-soft); border:var(--border-gold); border-radius:14px; padding:16px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div style="font-size:.85rem;"><span data-i18n="banner.welcome">Content de te revoir,</span> <strong style="color:var(--gold);"><%= nom || 'Général' %></strong> 👋</div>
            <a href="<%= typeCompte === 'client' ? '/client-qg' : '/qg' %>" class="btn-primary" style="text-decoration:none;" data-i18n="banner.continue">Continuer vers mon QG →</a>
        </div>
    </div>
    <% } %>

    <section class="hero">
        <span class="hero-badge"><span class="dot"></span><span data-i18n="hero.badge">SAMII OS · OPÉRATIONNEL</span></span>
        <h1><span data-i18n="hero.title1">Prends le commandement de ton</span> <span class="accent" data-i18n="hero.title2">Empire Digital</span> 👑</h1>
        <div class="hero-divider" aria-hidden="true"></div>
        <div class="hero-tagline"><b data-i18n="hero.tag1">Automatisez.</b> <span data-i18n="hero.tag2">Développez.</span> <b data-i18n="hero.tag3">Dominez.</b></div>
        <p class="desc" data-i18n="hero.desc">La plateforme des bâtisseurs d'empire : pilote ton commerce, connecte tes outils, et règne sur ton marché — où que tu sois dans le monde.</p>
        <div class="hero-ctas">
            <a href="#auth" class="btn-primary" data-i18n="hero.cta1">👑 Créer mon compte</a>
            <a href="#preview" class="btn-secondary" data-i18n="hero.cta2">Découvrir SAMII ↓</a>
        </div>
    </section>

    <section class="preview-section" id="preview">
        <div class="section-head">
            <span class="section-head__icon">🖥️</span>
            <span class="section-head__title" data-i18n="preview.title">Aperçu de ton QG</span>
            <span class="section-head__sub" data-i18n="preview.sub">CE QUI T'ATTEND</span>
        </div>
        <div class="preview-grid">
            <div class="p-card">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--gold">🧠</div>
                    <div>
                        <div class="p-card__title">IA SAMII</div>
                        <div class="p-card__desc" data-i18n="preview.samii.desc">Ton stratège personnel</div>
                    </div>
                </div>
                <div class="p-card__stat">50 <span>/ 50</span></div>
                <div class="p-card__statlabel" data-i18n="preview.samii.stat">messages disponibles chaque jour</div>
                <a href="#auth" class="p-card-btn" data-i18n="preview.samii.btn">Discuter avec SAMII →</a>
            </div>

            <div class="p-card">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--shopify">🛍️</div>
                    <div>
                        <div class="p-card__title">Shopify</div>
                        <div class="p-card__desc" data-i18n="preview.shopify.desc">Connecte ta boutique</div>
                    </div>
                </div>
                <div class="p-card__status"><span class="sdot"></span> <span data-i18n="preview.notconnected">Non connecté</span></div>
                <div style="height:26px;"></div>
                <a href="#auth" class="p-card-btn" data-i18n="preview.shopify.btn">Connecter Shopify →</a>
            </div>

            <div class="p-card">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--whatsapp">💬</div>
                    <div>
                        <div class="p-card__title">WhatsApp Business</div>
                        <div class="p-card__desc" data-i18n="preview.whatsapp.desc">Connecte ton numéro</div>
                    </div>
                </div>
                <div class="p-card__status"><span class="sdot"></span> <span data-i18n="preview.notconnected">Non connecté</span></div>
                <div style="height:26px;"></div>
                <a href="#auth" class="p-card-btn" data-i18n="preview.whatsapp.btn">Connecter WhatsApp →</a>
            </div>

            <div class="p-card p-card--globe">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--dash">📊</div>
                    <div>
                        <div class="p-card__title" data-i18n="preview.dash.title">Tableau de bord</div>
                        <div class="p-card__desc" data-i18n="preview.dash.desc">Vue d'ensemble</div>
                    </div>
                </div>
                <div class="p-card__stat">0</div>
                <div class="p-card__statlabel" data-i18n="preview.dash.stat">commandes aujourd'hui</div>
                <a href="#auth" class="p-card-btn" style="position:relative; z-index:2;" data-i18n="preview.dash.btn">Voir les statistiques →</a>
                <svg class="globe-mini" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(212,169,74,0.35)" stroke-width="1"/>
                    <circle cx="100" cy="100" r="65" fill="none" stroke="rgba(212,169,74,0.25)" stroke-width="1"/>
                    <ellipse cx="100" cy="100" rx="90" ry="28" fill="none" stroke="rgba(212,169,74,0.2)" stroke-width="1"/>
                    <ellipse cx="100" cy="100" rx="90" ry="55" fill="none" stroke="rgba(212,169,74,0.2)" stroke-width="1"/>
                    <ellipse cx="100" cy="100" rx="28" ry="90" fill="none" stroke="rgba(212,169,74,0.2)" stroke-width="1"/>
                    <circle cx="70" cy="80" r="2.5" fill="#D4A94A"/>
                    <circle cx="130" cy="60" r="2" fill="#D4A94A"/>
                    <circle cx="150" cy="110" r="2" fill="#D4A94A"/>
                </svg>
            </div>
        </div>
    </section>

    <section class="modules-section">
        <div class="section-head">
            <span class="section-head__icon">◎</span>
            <span class="section-head__title" data-i18n="modules.title">Ton arsenal, déjà prêt</span>
        </div>
        <div class="modules-grid">
            <div class="m-card">
                <div class="m-card__icon">🧠</div>
                <div><div class="m-card__name">IA SAMII</div><div class="m-card__desc" data-i18n="modules.samii">Assistant intelligent</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">📊</div>
                <div><div class="m-card__name" data-i18n="modules.dashboard.name">Dashboard</div><div class="m-card__desc" data-i18n="modules.dashboard.desc">Tableau de bord</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">🛍️</div>
                <div><div class="m-card__name">Shopify</div><div class="m-card__desc" data-i18n="modules.shopify">E-commerce</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">💬</div>
                <div><div class="m-card__name">WhatsApp</div><div class="m-card__desc" data-i18n="modules.whatsapp">Messagerie</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">✈️</div>
                <div><div class="m-card__name">Telegram</div><div class="m-card__desc" data-i18n="modules.telegram">Commandes en direct</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">📣</div>
                <div><div class="m-card__name">Meta Ads</div><div class="m-card__desc" data-i18n="modules.metaads">Pubs Facebook & Instagram</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">🏪</div>
                <div><div class="m-card__name" data-i18n="modules.marketplace.name">Marketplace</div><div class="m-card__desc" data-i18n="modules.marketplace.desc">Achète & vends</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">🛎️</div>
                <div><div class="m-card__name" data-i18n="modules.services.name">Services</div><div class="m-card__desc" data-i18n="modules.services.desc">Livraison, garde...</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">💼</div>
                <div><div class="m-card__name" data-i18n="modules.emploi.name">Emploi</div><div class="m-card__desc" data-i18n="modules.emploi.desc">Missions & postes</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
            <div class="m-card">
                <div class="m-card__icon">🤝</div>
                <div><div class="m-card__name" data-i18n="modules.parrainage.name">Parrainage</div><div class="m-card__desc" data-i18n="modules.parrainage.desc">20% + 5%, pendant 12 mois</div></div>
                <div class="m-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></div>
            </div>
        </div>
    </section>

    <section class="soon-section">
        <div class="section-head">
            <span class="section-head__icon">🔒</span>
            <span class="section-head__title" data-i18n="soon.title">Bientôt disponible</span>
        </div>
        <div class="soon-grid">
            <div class="s-card">
                <div class="s-card__icon">🌍</div>
                <div><div class="s-card__name" data-i18n="soon.reseau.name">Réseau Mondial</div><div class="s-card__desc" data-i18n="soon.reseau.desc">Connectez-vous</div></div>
                <span class="s-lock">🔒</span>
            </div>
            <div class="s-card">
                <div class="s-card__icon">🚚</div>
                <div><div class="s-card__name" data-i18n="soon.logistique.name">Logistique</div><div class="s-card__desc" data-i18n="soon.logistique.desc">Livraison & suivi</div></div>
                <span class="s-lock">🔒</span>
            </div>
            <div class="s-card">
                <div class="s-card__icon">💳</div>
                <div><div class="s-card__name" data-i18n="soon.finance.name">Finance</div><div class="s-card__desc" data-i18n="soon.finance.desc">Paiements & compta</div></div>
                <span class="s-lock">🔒</span>
            </div>
            <div class="s-card">
                <div class="s-card__icon">🔌</div>
                <div><div class="s-card__name" data-i18n="soon.api.name">API & Intégrations</div><div class="s-card__desc" data-i18n="soon.api.desc">Connecte tout</div></div>
                <span class="s-lock">🔒</span>
            </div>
        </div>
    </section>

    <div class="soon-banner">
        <span class="soon-banner__icon">🚀</span>
        <span class="soon-banner__text"><strong data-i18n="banner.soon1">L'Empire ne cesse de grandir.</strong> <span data-i18n="banner.soon2">De nouveaux pouvoirs arrivent chaque semaine — prépare-toi à passer au niveau supérieur.</span></span>
