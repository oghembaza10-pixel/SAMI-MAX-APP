    <script>
        document.querySelectorAll('.auth-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                const isRegister = tab.dataset.tab === 'register';
                document.getElementById('form-register').style.display = isRegister ? 'block' : 'none';
                document.getElementById('form-login').style.display = isRegister ? 'none' : 'block';
                document.getElementById('auth-msg').textContent = '';
            });
        });

        document.querySelectorAll('input[name="type_compte"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.getElementById('bloc-metier').style.display = radio.value === 'marchand' && radio.checked ? 'block' : 'none';
            });
        });

        document.getElementById('select-pays').addEventListener('change', function () {
            document.getElementById('champ-autre-pays').style.display = this.value === 'autre' ? 'block' : 'none';
        });

        const stepLabels = { 1: 'Étape 1 sur 2 — Ton profil', 2: 'Étape 2 sur 2 — Sécurité & style' };
        function goToStep(n) {
            document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
            document.querySelector('.form-step[data-step="' + n + '"]').classList.add('active');
            document.querySelectorAll('.step-dot').forEach(d => d.classList.toggle('done', parseInt(d.dataset.stepDot, 10) <= n));
            document.getElementById('step-label').textContent = stepLabels[n];
        }
        document.getElementById('btn-step1-next').addEventListener('click', () => {
            const form = document.getElementById('form-register');
            const requiredFields = form.querySelectorAll('.form-step[data-step="1"] [required]');
            for (const field of requiredFields) { if (!field.value) { field.reportValidity(); return; } }
            goToStep(2);
        });
        document.getElementById('btn-step2-back').addEventListener('click', () => goToStep(1));

        document.getElementById('form-register').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('auth-msg');
            const btn = e.target.querySelector('button[type="submit"]');
            const data = Object.fromEntries(new FormData(e.target));
            if (data.pays === 'autre' && data.pays_autre) { data.pays = data.pays_autre; }
            delete data.pays_autre;

            btn.disabled = true;
            msg.textContent = '⏳ Création en cours...';
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = json.message || '✅ Compte créé !';
                    msg.className = 'auth-msg ok';
                    if (json.redirect) setTimeout(() => window.location.href = json.redirect, 1200);
                } else {
                    msg.textContent = json.error || '❌ Erreur.';
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = '❌ Erreur réseau.';
                btn.disabled = false;
            }
        });

        document.getElementById('form-login').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('auth-msg');
            const btn = e.target.querySelector('button');
            const data = Object.fromEntries(new FormData(e.target));

            btn.disabled = true;
            msg.textContent = '⏳ Connexion...';
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = '✅ Connecté !';
                    msg.className = 'auth-msg ok';
                    window.location.href = json.redirect || '/';
                } else {
                    msg.textContent = json.error || '❌ Erreur.';
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = '❌ Erreur réseau.';
                btn.disabled = false;
            }
        });
    </script>
