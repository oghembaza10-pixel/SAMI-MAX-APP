            <form id="form-login" style="display:none;">
                <div class="field-group"><label>Email</label><input name="email" type="email" placeholder="ton@email.com" required></div>
                <div class="field-group"><label>Mot de passe</label><input name="password" type="password" placeholder="Ton mot de passe" required></div>
                <a href="/password-reset" class="forgot-link">Mot de passe oublié ?</a>
                <button type="submit" class="auth-submit">Se connecter</button>
            </form>

            <div class="auth-msg" id="auth-msg"></div>
        </div>
    </section>

