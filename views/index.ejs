<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG • ACCRÉDITATION</title>
    <link rel="stylesheet" href="/css/hub-style.css">
    <style>
        .entry-page {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            text-align: center;
            background: #050505;
        }
        .main-insigne {
            width: 300px;
            margin-bottom: 30px;
            filter: drop-shadow(0 0 40px rgba(197, 160, 89, 0.4));
        }
        .btn-gold {
            margin-top: 40px;
            padding: 16px 45px;
            border: 1px solid #C5A059;
            color: #C5A059;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 8px;
            font-weight: bold;
        }
        .btn-gold:hover {
            background: #C5A059;
            color: #000;
        }
        .language-switcher {
            position: absolute;
            top: 20px;
            right: 20px;
            display: flex;
            gap: 10px;
        }
    </style>
</head>
<body class="entry-page">

    <!-- Sélecteur de langue -->
    <div class="language-switcher">
        <button data-lang="fr" class="active">FR</button>
        <button data-lang="en">EN</button>
        <button data-lang="ar">AR</button>
    </div>

    <!-- Image principale -->
    <img src="/images/Gemini_Generated_Image_x7pcb1x7pcb1x7pc.png" class="main-insigne" alt="OG Insigne">
    
    <a href="/hub" class="btn-gold">REJOINDRE MON QG</a>

</body>
</html>
