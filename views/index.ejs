<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG Empire — SAMII OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0a0a0a;
            --bg-card: #131313;
            --bg-card-hover: #171717;
            --gold: #D4A94A;
            --gold-soft: rgba(212,169,74,0.12);
            --gold-border: rgba(212,169,74,0.28);
            --green: #22c55e;
            --green-soft: rgba(34,197,94,0.12);
            --text-main: #F5F5F4;
            --text-muted: #8a8a88;
            --text-dim: #5c5c5a;
            --border: 1px solid rgba(255,255,255,0.07);
            --border-gold: 1px solid var(--gold-border);
            --font-display: 'Cinzel', serif;
            --font-body: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --r: 16px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
        body {
            background: var(--bg); color: var(--text-main); font-family: var(--font-body);
            min-height: 100vh; width: 100%; overflow-x: hidden;
        }

        .top-bar {
            position: sticky; top: 0; z-index: 200;
            display: flex; justify-content: space-between; align-items: center;
            padding: 16px 20px; background: rgba(10,10,10,0.92); backdrop-filter: blur(16px);
            border-bottom: var(--border);
        }
        .brand { display: flex; align-items: center; gap: 9px; }
        .brand img { width: 30px; height: 30px; }
        .brand__text { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: #fff; letter-spacing: .02em; }
        .brand__sub { display: none; font-family: var(--font-mono); font-size: .6rem; color: var(--gold); letter-spacing: .12em; text-transform: uppercase; }
        .top-bar__right { display: flex; align-items: center; gap: 10px; }
        .lang-switch { display: flex; gap: 2px; font-family: var(--font-mono); font-size: .66rem; }
        .lang-switch span { padding: 5px 7px; border-radius: 6px; cursor: pointer; color: var(--text-dim); transition: .2s; }
        .lang-switch span.active, .lang-switch span:hover { color: var(--gold); background: var(--gold-soft); }
        .btn-login-top {
            padding: 8px 16px; border-radius: 9px; text-decoration: none; font-size: .78rem; font-weight: 700;
            color: var(--gold); border: var(--border-gold); background: transparent; cursor: pointer;
            font-family: var(--font-body);
        }

        .hero { max-width: 780px; margin: 0 auto; padding: 44px 20px 8px; text-align: center; }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 7px; padding: 7px 16px; border-radius: 30px;
            background: var(--gold-soft); border: var(--border-gold); font-family: var(--font-mono);
            font-size: .68rem; color: var(--gold); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 22px;
        }
        .hero-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 6px var(--green); }
        .hero h1 {
            font-family: var(--font-display); font-size: clamp(1.9rem, 7vw, 3.4rem); font-weight: 800; color: #fff;
            line-height: 1.15; margin-bottom: 14px;
        }
        .hero h1 .accent { color: var(--gold); }
        .hero-tagline {
            font-family: var(--font-mono); font-size: .95rem; color: var(--text-muted); letter-spacing: .04em;
            margin-bottom: 10px;
        }
        .hero-tagline b { color: var(--gold); font-weight: 700; }
        .hero p.desc { color: var(--text-dim); font-size: .88rem; max-width: 480px; margin: 14px auto 0; line-height: 1.6; }
        .hero-ctas { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
        .btn-primary {
            padding: 13px 26px; border-radius: 11px; background: linear-gradient(135deg, var(--gold), #F0C878);
            color: #000; font-weight: 800; font-size: .86rem; text-decoration: none; border: none; cursor: pointer;
            font-family: var(--font-body);
        }
        .btn-secondary {
            padding: 13px 22px; border-radius: 11px; background: transparent; border: var(--border-gold);
            color: var(--gold); font-weight: 700; font-size: .86rem; text-decoration: none; cursor: pointer;
        }

        .section-head { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; padding: 0 4px; }
        .section-head__icon { font-size: 1rem; }
        .section-head__title { font-size: .82rem; font-weight: 700; color: #fff; }
        .section-head__sub { font-size: .68rem; color: var(--text-dim); margin-left: auto; font-family: var(--font-mono); }

        .preview-section { max-width: 1180px; margin: 54px auto 0; padding: 0 16px; }
        .preview-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
        @media (min-width: 860px) { .preview-grid { grid-template-columns: repeat(4, 1fr); } }

        .p-card {
            background: var(--bg-card); border: var(--border); border-radius: var(--r);
            padding: 18px; transition: all .25s ease;
        }
        .p-card:hover { background: var(--bg-card-hover); border-color: rgba(212,169,74,0.2); }
        .p-card__top { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; }
        .p-card__badge {
            width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center;
            font-size: 1.15rem; flex-shrink: 0;
        }
        .p-card__badge--gold { background: var(--gold-soft); color: var(--gold); }
        .p-card__badge--shopify { background: rgba(149,197,86,0.15); color: #95c556; }
        .p-card__badge--whatsapp { background: var(--green-soft); color: var(--green); }
        .p-card__badge--dash { background: var(--gold-soft); color: var(--gold); }
        .p-card__title { font-size: .88rem; font-weight: 700; color: #fff; }
        .p-card__desc { font-size: .72rem; color: var(--text-dim); margin-top: 1px; }
        .p-card__stat { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: #fff; margin-bottom: 2px; }
        .p-card__stat span { font-size: .95rem; color: var(--text-dim); font-weight: 500; }
        .p-card__statlabel { font-size: .68rem; color: var(--text-dim); margin-bottom: 14px; }
        .p-card__status { display: flex; align-items: center; gap: 6px; font-size: .72rem; color: var(--text-dim); margin-bottom: 14px; }
        .p-card__status .sdot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-dim); }
        .p-card-btn {
            display: block; width: 100%; text-align: center; padding: 9px; border-radius: 9px;
            background: var(--gold-soft); color: var(--gold); border: var(--border-gold);
            font-size: .74rem; font-weight: 700; text-decoration: none; cursor: pointer; font-family: var(--font-body);
        }

        .p-card--globe { position: relative; overflow: hidden; grid-column: span 1; }
        @media (min-width: 860px) { .p-card--globe { grid-column: span 1; } }
        .globe-mini { position: absolute; right: -30px; bottom: -30px; width: 160px; height: 160px; opacity: .9; pointer-events: none; }

        .modules-section { max-width: 1180px; margin: 40px auto 0; padding: 0 16px; }
        .modules-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        @media (min-width: 640px) { .modules-grid { grid-template-columns: repeat(4, 1fr); } }
        .m-card {
            position: relative; background: var(--bg-card); border: var(--border); border-radius: 13px;
            padding: 14px; display: flex; align-items: center; gap: 10px; transition: all .25s ease;
        }
        .m-card:hover { border-color: rgba(212,169,74,0.25); }
        .m-card__icon {
            width: 34px; height: 34px; border-radius: 9px; background: var(--gold-soft); color: var(--gold);
            display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;
        }
        .m-card__name { font-size: .78rem; font-weight: 700; color: #fff; line-height: 1.25; }
        .m-card__desc { font-size: .64rem; color: var(--text-dim); margin-top: 1px; }
        .m-check {
            position: absolute; top: 10px; right: 10px; width: 17px; height: 17px; border-radius: 50%;
            background: var(--green); display: flex; align-items: center; justify-content: center;
        }
        .m-check svg { width: 10px; height: 10px; color: #000; }

        .soon-section { max-width: 1180px; margin: 30px auto 0; padding: 0 16px; }
        .soon-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        @media (min-width: 640px) { .soon-grid { grid-template-columns: repeat(4, 1fr); } }
        .s-card {
            position: relative; background: rgba(255,255,255,0.015); border: var(--border); border-radius: 13px;
            padding: 14px; display: flex; align-items: center; gap: 10px; opacity: .55;
        }
        .s-card__icon {
            width: 34px; height: 34px; border-radius: 9px; background: rgba(255,255,255,0.05); color: var(--text-dim);
            display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0;
        }
        .s-card__name { font-size: .78rem; font-weight: 700; color: var(--text-muted); }
        .s-card__desc { font-size: .64rem; color: var(--text-dim); }
        .s-lock { position: absolute; top: 10px; right: 10px; font-size: .8rem; color: var(--text-dim); }

        .soon-banner {
            max-width: 1180px; margin: 12px auto 0; padding: 16px 20px;
            background: var(--gold-soft); border: var(--border-gold); border-radius: 14px;
            display: flex; align-items: center; gap: 12px; margin-left: 16px; margin-right: 16px;
        }
        .soon-banner__icon { font-size: 1.3rem; }
        .soon-banner__text { font-size: .8rem; color: var(--text-main); }
        .soon-banner__text strong { color: var(--gold); }

        .pills-bar {
            max-width: 1180px; margin: 40px auto 0; padding: 18px 16px;
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
            border-top: var(--border); border-bottom: var(--border);
        }
        @media (min-width: 768px) { .pills-bar { grid-template-columns: repeat(5, 1fr); } }
        .pill { display: flex; align-items: center; gap: 9px; }
        .pill__icon { font-size: 1.1rem; color: var(--gold); flex-shrink: 0; }
        .pill__title { font-size: .74rem; font-weight: 700; color: #fff; }
        .pill__desc { font-size: .62rem; color: var(--text-dim); }

        .auth-section { max-width: 480px; margin: 60px auto 0; padding: 0 16px; }
        .auth-header { text-align: center; margin-bottom: 20px; }
        .auth-header h2 { font-family: var(--font-display); font-size: 1.4rem; color: #fff; margin-bottom: 6px; }
        .auth-header p { font-size: .8rem; color: var(--text-dim); }

        .auth-tabs { display: flex; gap: 5px; margin-bottom: 16px; background: var(--bg-card); border-radius: 12px; padding: 4px; border: var(--border); }
        .auth-tab {
            flex: 1; padding: 11px 6px; border-radius: 9px; border: none; background: transparent;
            color: var(--text-dim); font-weight: 700; font-size: .8rem; cursor: pointer; transition: all .25s ease;
            font-family: var(--font-body);
        }
        .auth-tab.active { background: linear-gradient(135deg, var(--gold), #F0C878); color: #000; }

        .auth-card { background: var(--bg-card); border: var(--border-gold); border-radius: var(--r); padding: 22px 18px; }

        .step-indicator { display: flex; gap: 6px; margin-bottom: 16px; }
        .step-dot { flex: 1; height: 3px; border-radius: 3px; background: rgba(255,255,255,0.08); transition: .3s; }
        .step-dot.done { background: var(--gold); }
        .step-label { font-family: var(--font-mono); font-size: .62rem; color: var(--text-dim); text-align: center; margin-bottom: 14px; letter-spacing: .04em; }

        .form-step { display: none; }
        .form-step.active { display: block; animation: stepin .3s ease both; }
        @keyframes stepin { from { opacity: 0; transform: translateX(10px);} to { opacity: 1; transform: translateX(0);} }

        .type-choice { display: flex; gap: 8px; margin-bottom: 14px; }
        .type-choice label {
            flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 6px;
            border-radius: 10px; cursor: pointer; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.02);
            font-size: .74rem; color: var(--text-dim); transition: .25s;
        }
        .type-choice input { display: none; }
        .type-choice label:has(input:checked) { border-color: var(--gold); background: var(--gold-soft); color: #fff; }
        .type-choice .icon { font-size: 1.2rem; }

        .field-group { margin-bottom: 12px; }
        .field-group label { display: block; font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-dim); margin-bottom: 5px; }
        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .auth-card input, .auth-card select {
            width: 100%; padding: 12px 13px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.09);
            background: #000; color: var(--text-main); font-size: 16px; font-family: var(--font-body);
        }
        .auth-card select option { background: #0a0a0a; }
        .auth-card input:focus, .auth-card select:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-soft); }

        #champ-autre-pays { display: none; margin-top: 8px; }

        .grade-preview { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 11px; background: var(--gold-soft); border: var(--border-gold); margin-bottom: 14px; }
        .grade-preview__icon { font-size: 1.2rem; }
        .grade-preview__text { font-size: .74rem; color: var(--text-dim); line-height: 1.4; }
        .grade-preview__text strong { color: var(--gold); }

        .theme-picker { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 14px; }
        .theme-card { border-radius: 12px; padding: 11px 10px; cursor: pointer; border: 1px solid rgba(255,255,255,0.09); text-align: center; transition: .25s; }
        .theme-card input { display: none; }
        .theme-card__preview { height: 24px; border-radius: 6px; margin-bottom: 6px; }
        .theme-card--strategiste .theme-card__preview { background: linear-gradient(90deg, #D4A94A, #3a3a2a); }
        .theme-card--sagesse .theme-card__preview { background: linear-gradient(90deg, #4a6fa5, #cfd8e8); }
        .theme-card--aventurier .theme-card__preview { background: linear-gradient(90deg, #5FD4FF, #d8c39a); }
        .theme-card--gaming .theme-card__preview { background: linear-gradient(90deg, #9d5cff, #00e5ff); }
        .theme-card__name { font-size: .66rem; color: var(--text-dim); font-weight: 600; }
        .theme-card:has(input:checked) { border-color: var(--gold); background: var(--gold-soft); }
        .theme-card:has(input:checked) .theme-card__name { color: #fff; }

        .btn-row { display: flex; gap: 10px; margin-top: 6px; }
        .auth-btn-back { padding: 13px 16px; border-radius: 11px; border: 1px solid rgba(255,255,255,0.1); background: transparent; color: var(--text-dim); font-weight: 700; font-size: .8rem; cursor: pointer; }
        .auth-submit {
            flex: 1; padding: 13px; border: none; border-radius: 11px; background: linear-gradient(135deg, var(--gold), #F0C878);
            color: #000; font-weight: 800; font-size: .86rem; cursor: pointer; font-family: var(--font-body);
        }
        .auth-submit:disabled { opacity: .5; cursor: not-allowed; }
        .auth-msg { text-align: center; margin-top: 12px; font-size: .78rem; color: #ff6b6b; min-height: 18px; }
        .auth-msg.ok { color: var(--green); }
        .forgot-link { display: block; text-align: right; font-size: .72rem; color: var(--text-dim); text-decoration: none; margin-top: -4px; margin-bottom: 12px; }

        .site-footer { border-top: var(--border); padding: 26px 16px; margin-top: 60px; display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
        @media (min-width: 768px) { .site-footer { flex-direction: row; justify-content: space-between; padding: 26px 32px; } }
        .site-footer__quote { font-family: var(--font-mono); color: var(--text-dim); font-size: .68rem; }
        .social-links { display: flex; gap: 9px; }
        .social-links a { color: var(--text-dim); display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 9px; border: var(--border); transition: .25s; }
        .social-links a:hover { color: var(--gold); border-color: var(--gold-border); }
        .site-footer__meta { font-family: var(--font-mono); font-size: .64rem; color: var(--text-dim); }

        @media (min-width: 768px) {
            .top-bar { padding: 18px 32px; }
            .brand__sub { display: block; }
            .auth-card { padding: 28px; }
        }
    </style>
</head>
<body>

    <header class="top-bar">
        <div class="brand">
            <img src="/og.png" alt="OG">
            <div>
                <div class="brand__text">SAMII OS</div>
                <div class="brand__sub">LE QG MONDIAL</div>
            </div>
        </div>
        <div class="top-bar__right">
            <div class="lang-switch">
                <span data-lang="fr" class="active">FR</span>
                <span data-lang="en">EN</span>
                <span data-lang="ar">AR</span>
            </div>
            <a href="#auth" class="btn-login-top">Se connecter</a>
        </div>
    </header>

    <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
    <div style="max-width:1180px; margin:16px auto 0; padding:0 16px;">
        <div style="background:var(--gold-soft); border:var(--border-gold); border-radius:14px; padding:16px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <div style="font-size:.85rem;">Content de te revoir, <strong style="color:var(--gold);"><%= nom || 'Général' %></strong> 👋</div>
            <a href="<%= typeCompte === 'client' ? '/client-qg' : '/qg' %>" class="btn-primary" style="text-decoration:none;">Continuer vers mon QG →</a>
        </div>
    </div>
    <% } %>

    <section class="hero">
        <span class="hero-badge"><span class="dot"></span>SAMII OS · OPÉRATIONNEL</span>
        <h1>Bienvenue au <span class="accent">QG Mondial</span> 👋</h1>
        <div class="hero-tagline"><b>Automatisez.</b> Développez. <b>Dominez.</b></div>
        <p class="desc">Une seule plateforme pour piloter ton commerce, connecter tes outils, et faire grandir ton empire — où que tu sois dans le monde.</p>
        <div class="hero-ctas">
            <a href="#auth" class="btn-primary">👑 Créer mon compte</a>
            <a href="#preview" class="btn-secondary">Découvrir SAMII ↓</a>
        </div>
    </section>

    <section class="preview-section" id="preview">
        <div class="section-head">
            <span class="section-head__icon">🖥️</span>
            <span class="section-head__title">Aperçu de ton QG</span>
            <span class="section-head__sub">CE QUI T'ATTEND</span>
        </div>
        <div class="preview-grid">
            <div class="p-card">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--gold">🧠</div>
                    <div>
                        <div class="p-card__title">IA SAMII</div>
                        <div class="p-card__desc">Ton assistant intelligent</div>
                    </div>
                </div>
                <div class="p-card__stat">50 <span>/ 50</span></div>
                <div class="p-card__statlabel">messages disponibles chaque jour</div>
                <a href="#auth" class="p-card-btn">Discuter avec SAMII →</a>
            </div>

            <div class="p-card">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--shopify">🛍️</div>
                    <div>
                        <div class="p-card__title">Shopify</div>
                        <div class="p-card__desc">Connecte ta boutique</div>
                    </div>
                </div>
                <div class="p-card__status"><span class="sdot"></span> Non connecté</div>
                <div style="height:26px;"></div>
                <a href="#auth" class="p-card-btn">Connecter Shopify →</a>
            </div>

            <div class="p-card">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--whatsapp">💬</div>
                    <div>
                        <div class="p-card__title">WhatsApp Business</div>
                        <div class="p-card__desc">Connecte ton numéro</div>
                    </div>
                </div>
                <div class="p-card__status"><span class="sdot"></span> Non connecté</div>
                <div style="height:26px;"></div>
                <a href="#auth" class="p-card-btn">Connecter WhatsApp →</a>
            </div>

            <div class="p-card p-card--globe">
                <div class="p-card__top">
                    <div class="p-card__badge p-card__badge--dash">📊</div>
                    <div>
                        <div class="p-card__title">Tableau de bord</div>
                        <div class="p-card__desc">Vue d'ensemble</div>
                    </div>
                </div>
                <div class="p-card__stat">0</div>
                <div class="p-card__statlabel">commandes aujourd'hui</div>
                <a href="#auth" class="p-card-btn" style="position:relative; z-index:2;">Voir les statistiques →</a>
                <svg class="globe-mini" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(212,169,74,0.35)" stroke-width="1"/>
                    <circle cx="100" cy="100" r="65" fill="none" stroke="rgba(212,169,74,0.25)" stroke-width="1"/>
                    <ellipse cx="100" cy="100" rx="90" ry="28" fill="none" stroke="rgba(212,169,74,0.2)" stroke-width="1"/>
                    <ellipse cx="100" cy="100" rx="90" ry="55" fill="none" stroke="rgba(212,169,74,0.2)" stroke-width="1"/>
                    <ellipse cx="100" cy="100" rx="28" ry="90" fill="none" stroke="rgba(212,169,74,0.2)" stroke-width="1"/>
                    <circle cx="70" cy="80" r="2.5" fill="#D4A94A"/>
                    <circle cx="130" cy="60" r="2" fill="#D4A94A"/>
                    <circle cx="150" cy="110" r="2" fill="#D4A94A"/>
                </svg>
            </div>
