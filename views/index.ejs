    <!-- Scripts interactifs pour les modes et formulaires -->
    <script>
        // Gestion des onglets Inscription / Connexion
        const authTabs = document.querySelectorAll('.auth-tab');
        const formRegister = document.getElementById('form-register');
        const formLogin = document.getElementById('form-login');

        authTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                authTabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                if (tab.dataset.tab === 'register') {
                    formRegister.style.display = 'block';
                    formLogin.style.display = 'none';
                } else {
                    formRegister.style.display = 'none';
                    formLogin.style.display = 'block';
                }
            });
        });

        // Gestion multi-étapes formulaire inscription
        const btnStep1Next = document.getElementById('btn-step1-next');
        const btnStep2Back = document.getElementById('btn-step2-back');
        const step1 = document.querySelector('.form-step[data-step="1"]');
        const step2 = document.querySelector('.form-step[data-step="2"]');
        const stepDots = document.querySelectorAll('[data-step-dot]');
        const stepLabel = document.getElementById('step-label');

        btnStep1Next.addEventListener('click', () => {
            const inputsStep1 = step1.querySelectorAll('input[required], select[required]');
            let valid = true;
            inputsStep1.forEach(input => {
                if (!input.value.trim()) { valid = false; input.style.borderColor = '#ff6b6b'; }
                else { input.style.borderColor = ''; }
            });
            if (!valid) {
                document.getElementById('register-msg').innerText = "Veuillez remplir tous les champs requis.";
                return;
            }
            document.getElementById('register-msg').innerText = "";
            step1.classList.remove('active');
            step2.classList.add('active');
            stepDots[1].classList.add('done');
            stepLabel.innerText = "Étape 2 sur 2 — Sécurité & Initialisation";
        });

        btnStep2Back.addEventListener('click', () => {
            step2.classList.remove('active');
            step1.classList.add('active');
            stepDots[1].classList.remove('done');
            stepLabel.innerText = "Étape 1 sur 2 — Identité & Profil";
        });

        // Gestion du champ "Autre pays"
        const selectPays = document.getElementById('select-pays');
        const champAutrePays = document.getElementById('champ-autre-pays');

        selectPays.addEventListener('change', (e) => {
            if (e.target.value === 'autre') {
                champAutrePays.style.display = 'block';
                champAutrePays.required = true;
            } else {
                champAutrePays.style.display = 'none';
                champAutrePays.required = false;
            }
        });

        // Bascule dynamique des modes (Amazon / GitHub / Database) pour l'effet interactif
        const modeButtons = document.querySelectorAll('.mode-btn');
        const previewModeTitle = document.getElementById('preview-mode-title');
        const previewConsoleText = document.getElementById('preview-console-text');

        modeButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                modeButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const mode = btn.dataset.mode;

                if (mode === 'amazon') {
                    previewModeTitle.innerText = "SAMII OS // MODE AMAZON (TRANSACTIONNEL)";
                    previewConsoleText.innerHTML = `
                        <div class="console-line"><span class="console-prompt">&gt;</span> [MODE] Amazon High-Volume Transaction active.</div>
                        <div class="console-line"><span class="console-prompt">&gt;</span> [CHECKOUT] Flux d'achat instantané et sécurisé.</div>
                        <div class="console-line"><span class="console-prompt">&gt;</span> [SYNC] Commandes synchronisées en temps réel.</div>
                    `;
                } else if (mode === 'github') {
                    previewModeTitle.innerText = "SAMII OS // MODE GITHUB (TECHNIQUE & REPO)";
                    previewConsoleText.innerHTML = `
                        <div class="console-line"><span class="console-prompt">&gt;</span> [MODE] Repository Infrastructure Core chargé.</div>
                        <div class="console-line"><span class="console-prompt">&gt;</span> [BUILD] Compilation des branches d'automatisation...</div>
                        <div class="console-line"><span class="console-prompt">&gt;</span> [DEPLOY] Pipeline CI/CD opérationnel sans coupure.</div>
                    `;
                } else if (mode === 'database') {
                    previewModeTitle.innerText = "SAMII OS // MODE DATABASE (RELATIONNEL)";
                    previewConsoleText.innerHTML = `
                        <div class="console-line"><span class="console-prompt">&gt;</span> [MODE] Table Mère & Tables Filles connectées.</div>
                        <div class="console-line"><span class="console-prompt">&gt;</span> [QUERY] Indexation relationnelle des flux e-commerce.</div>
                        <div class="console-line"><span class="console-prompt">&gt;</span> [OPTIMIZE] Intégrité des données vérifiée à 100%.</div>
                    `;
                }
            });
        });
    </script>
