<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="OG Empire — La plateforme d'automatisation souveraine. Connectez Shopify, WhatsApp, Instagram, Telegram et plus encore depuis un seul OS.">
    <meta property="og:title" content="OG Empire — SAMII OS">
    <meta property="og:description" content="L'empire commence ici. Automatisez tout, dominez partout.">
    <title>OG Empire — SAMII OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           DESIGN TOKENS
        ============================================================ */
        :root {
            --bg-deep:            #03040a;
            --bg-panel:           rgba(255,255,255,0.042);
            --bg-panel-strong:    rgba(255,255,255,0.075);
            --bg-panel-hover:     rgba(255,255,255,0.10);
            --gold:               #C5A059;
            --gold-light:         #E8C27A;
            --gold-dim:           rgba(197,160,89,0.18);
            --cyan:               #5FD4FF;
            --cyan-dim:           rgba(95,212,255,0.15);
            --violet:             #9d5cff;
            --violet-dim:         rgba(157,92,255,0.15);
            --green:              #3ddc84;
            --red:                #ff6b6b;
            --text-main:          #F1F0EC;
            --text-muted:         #7a8394;
            --text-faint:         #4a5260;
            --border-soft:        1px solid rgba(255,255,255,0.08);
            --border-gold:        1px solid rgba(197,160,89,0.30);
            --border-cyan:        1px solid rgba(95,212,255,0.30);
            --font-display:       'Cinzel', serif;
            --font-body:          'Inter', sans-serif;
            --font-mono:          'JetBrains Mono', monospace;
            --ease:               cubic-bezier(0.16,1,0.3,1);
            --ease-back:          cubic-bezier(0.34,1.56,0.64,1);
            --radius-sm:          10px;
            --radius-md:          16px;
            --radius-lg:          24px;
            --radius-xl:          32px;
            --shadow-gold:        0 0 40px rgba(197,160,89,0.12);
            --shadow-cyan:        0 0 40px rgba(95,212,255,0.12);
            --shadow-card:        0 24px 60px rgba(0,0,0,0.5);
        }

        /* ============================================================
           RESET & BASE
        ============================================================ */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; font-size: 16px; }
        body {
            background: var(--bg-deep);
            color: var(--text-main);
            font-family: var(--font-body);
            min-height: 100vh;
            width: 100%;
            overflow-x: hidden;
            position: relative;
            -webkit-font-smoothing: antialiased;
        }
        a { color: inherit; text-decoration: none; }
        button { font-family: var(--font-body); cursor: pointer; }
        img { display: block; max-width: 100%; }

        /* ============================================================
           SCROLLBAR
        ============================================================ */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--bg-deep); }
        ::-webkit-scrollbar-thumb { background: rgba(197,160,89,0.35); border-radius: 10px; }

        /* ============================================================
           ANIMATED WORLD BACKGROUND
        ============================================================ */
        .world-bg {
            position: fixed; inset: 0; z-index: -3;
            overflow: hidden; pointer-events: none;
        }
        .world-bg__overlay {
            position: absolute; inset: 0;
            background:
                radial-gradient(ellipse 90% 70% at 50% -10%, rgba(197,160,89,0.06) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 80% 50%, rgba(95,212,255,0.04) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 20% 80%, rgba(157,92,255,0.04) 0%, transparent 60%),
                linear-gradient(180deg, rgba(3,4,10,0.3) 0%, var(--bg-deep) 85%);
        }
        .world-svg {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: min(1600px, 240vw); height: auto; opacity: .45;
        }
        .globe-ring        { fill: none; stroke: rgba(95,212,255,0.13); stroke-width: 1; }
        .globe-ring--gold  { stroke: rgba(197,160,89,0.12); }
        .globe-ring--violet{ stroke: rgba(157,92,255,0.10); }
        .globe-meridian    { fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 1; }
        .hub-dot           { fill: var(--gold); filter: drop-shadow(0 0 8px rgba(197,160,89,1)); }
        .hub-dot--cyan     { fill: var(--cyan); filter: drop-shadow(0 0 8px rgba(95,212,255,1)); }
        .hub-dot--violet   { fill: var(--violet); filter: drop-shadow(0 0 8px rgba(157,92,255,1)); }
        .hub-pulse {
            fill: none; stroke: var(--cyan); stroke-width: 1.2;
            opacity: 0; transform-origin: center;
            animation: pulse-ring 3.5s ease-out infinite;
        }
        .hub-pulse--gold   { stroke: var(--gold); }
        .hub-pulse--violet { stroke: var(--violet); animation-delay: 1.2s; }
        @keyframes pulse-ring {
            0%   { opacity: .9; transform: scale(0.2); }
            80%  { opacity: 0;  transform: scale(3.2); }
            100% { opacity: 0;  transform: scale(3.2); }
        }
        .arc-line {
            fill: none; stroke: url(#arcGradient); stroke-width: 1.2;
            stroke-dasharray: 8 6; opacity: .5;
            animation: arc-flow 5s linear infinite;
        }
        .arc-line:nth-child(2) { animation-delay: -1.5s; animation-duration: 6s; }
        .arc-line:nth-child(3) { animation-delay: -3s;   animation-duration: 4s; }
        @keyframes arc-flow { to { stroke-dashoffset: -140; } }
        .world-rotate {
            animation: world-spin 160s linear infinite;
            transform-origin: center;
        }
        @keyframes world-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        /* ============================================================
           STAR PARTICLES
        ============================================================ */
        .bg-particles {
            position: fixed; inset: 0; z-index: -2;
            pointer-events: none; opacity: .22;
            background-image:
                radial-gradient(circle, rgba(255,255,255,0.5) 1px, transparent 1px),
                radial-gradient(circle, rgba(95,212,255,0.4) 1px, transparent 1px),
                radial-gradient(circle, rgba(197,160,89,0.3) 1px, transparent 1px);
            background-size: 120px 120px, 200px 200px, 300px 300px;
            animation: particles-drift 80s linear infinite;
        }
        @keyframes particles-drift {
            from { background-position: 0 0, 0 0, 0 0; }
            to   { background-position: 0 -600px, 0 -800px, 0 -400px; }
        }

        /* ============================================================
           NOISE TEXTURE OVERLAY
        ============================================================ */
        .noise-overlay {
            position: fixed; inset: 0; z-index: -1;
            pointer-events: none; opacity: .025;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
            background-size: 200px 200px;
        }

        /* ============================================================
           TOP BAR
        ============================================================ */
        .top-bar {
            position: sticky; top: 0; z-index: 200;
            display: flex; justify-content: space-between; align-items: center;
            padding: 14px 20px;
            backdrop-filter: blur(32px) saturate(180%);
            -webkit-backdrop-filter: blur(32px) saturate(180%);
            background: rgba(3,4,10,0.85);
            border-bottom: var(--border-soft);
            width: 100%;
            transition: padding .3s ease;
        }
        .top-bar.scrolled { padding: 10px 20px; }

        .brand {
            display: flex; align-items: center; gap: 10px;
            font-family: var(--font-display); font-weight: 800;
            color: #fff; font-size: 1rem; letter-spacing: .04em;
        }
        .brand__logo {
            width: 30px; height: 30px; border-radius: 8px;
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            display: flex; align-items: center; justify-content: center;
            font-size: .9rem; flex-shrink: 0;
            box-shadow: 0 0 20px rgba(197,160,89,0.4);
        }
        .brand__separator { color: rgba(255,255,255,0.2); font-weight: 300; }

        .top-bar__center {
            display: none;
            gap: 4px;
        }
        .nav-link {
            padding: 8px 14px; border-radius: 20px;
            font-size: .78rem; font-weight: 600;
            color: var(--text-muted);
            border: 1px solid transparent;
            transition: all .25s ease;
        }
        .nav-link:hover {
            color: var(--cyan);
            border-color: rgba(95,212,255,0.3);
            background: rgba(95,212,255,0.06);
        }

        .top-bar__right { display: flex; align-items: center; gap: 10px; }

        .status-pill {
            display: flex; align-items: center; gap: 6px;
            padding: 6px 12px; border-radius: 20px;
            background: rgba(61,220,132,0.08);
            border: 1px solid rgba(61,220,132,0.2);
            font-family: var(--font-mono); font-size: .62rem;
            color: var(--green); letter-spacing: .04em;
        }
        .status-pill__dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: blink 2s ease-in-out infinite;
        }
        @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: .3; } }

        @media (min-width: 768px) {
            .top-bar { padding: 18px 36px; }
            .top-bar.scrolled { padding: 12px 36px; }
            .top-bar__center { display: flex; }
            .brand { font-size: 1.15rem; }
            .brand__logo { width: 36px; height: 36px; }
        }

        /* ============================================================
           HERO SECTION
        ============================================================ */
        .hero {
            max-width: 820px; margin: 0 auto;
            padding: 70px 20px 30px;
            text-align: center; position: relative;
        }

        .eyebrow {
            font-family: var(--font-mono); letter-spacing: .18em;
            font-size: .66rem; color: var(--cyan);
            text-transform: uppercase;
            display: inline-flex; align-items: center; gap: 8px;
            margin-bottom: 20px;
            padding: 7px 16px; border-radius: 20px;
            background: rgba(95,212,255,0.07);
            border: 1px solid rgba(95,212,255,0.2);
        }
        .eyebrow .dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: var(--green); box-shadow: 0 0 8px var(--green);
            animation: blink 2s ease-in-out infinite;
        }

        .hero__title {
            font-family: var(--font-display);
            font-size: clamp(2rem, 7vw, 3.8rem);
            color: #fff; line-height: 1.12;
            margin-bottom: 10px;
            text-shadow: 0 0 80px rgba(197,160,89,0.2);
            letter-spacing: .02em;
        }
        .hero__title .line2 {
            display: block;
            background: linear-gradient(135deg, var(--gold) 0%, var(--cyan) 50%, var(--violet) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero__subtitle {
            color: var(--text-muted); font-size: .95rem;
            line-height: 1.7; max-width: 540px; margin: 18px auto 0;
            padding: 0 10px;
        }
        .hero__subtitle strong { color: var(--text-main); font-weight: 600; }

        /* Scroll indicator */
        .scroll-hint {
            display: flex; flex-direction: column; align-items: center;
            gap: 6px; margin-top: 40px;
            font-family: var(--font-mono); font-size: .6rem;
            color: var(--text-faint); letter-spacing: .1em;
            animation: float-hint 3s ease-in-out infinite;
        }
        .scroll-hint__arrow {
            width: 20px; height: 20px; border-right: 1px solid var(--text-faint);
            border-bottom: 1px solid var(--text-faint);
            transform: rotate(45deg);
        }
        @keyframes float-hint {
            0%,100% { transform: translateY(0); opacity: .5; }
            50%      { transform: translateY(6px); opacity: 1; }
        }

        /* ============================================================
           LIVE STATS BAR
        ============================================================ */
        .stats-bar {
            max-width: 700px; margin: 40px auto 0;
            padding: 0 20px;
        }
        .stats-bar__inner {
            display: flex; justify-content: center;
            gap: 0; flex-wrap: wrap;
            background: var(--bg-panel);
            border: var(--border-gold);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-gold);
        }
        .stat-item {
            flex: 1; min-width: 120px;
            padding: 20px 16px; text-align: center;
            position: relative;
        }
        .stat-item:not(:last-child)::after {
            content: ''; position: absolute; right: 0; top: 20%; bottom: 20%;
            width: 1px; background: rgba(255,255,255,0.08);
        }
        .stat-item__num {
            font-family: var(--font-mono); font-weight: 700;
            font-size: 1.6rem; color: var(--gold);
            line-height: 1;
            text-shadow: 0 0 30px rgba(197,160,89,0.5);
        }
        .stat-item__label {
            font-family: var(--font-mono); font-size: .58rem;
            color: var(--text-muted); text-transform: uppercase;
            letter-spacing: .08em; margin-top: 5px;
        }
        .stat-item__icon { font-size: .9rem; margin-bottom: 4px; }

        /* ============================================================
           MARQUEE TICKER
        ============================================================ */
        .ticker-wrap {
            width: 100%; overflow: hidden;
            margin-top: 50px;
            border-top: var(--border-soft);
            border-bottom: var(--border-soft);
            padding: 12px 0;
            background: rgba(0,0,0,0.2);
        }
        .ticker {
            display: flex; gap: 0;
            animation: ticker-scroll 30s linear infinite;
            width: max-content;
        }
        .ticker__item {
            display: flex; align-items: center; gap: 10px;
            padding: 0 32px;
            font-family: var(--font-mono); font-size: .68rem;
            color: var(--text-muted); white-space: nowrap;
        }
        .ticker__item span { color: var(--gold); font-weight: 700; }
        .ticker__sep { color: var(--text-faint); }
        @keyframes ticker-scroll {
            from { transform: translateX(0); }
            to   { transform: translateX(-50%); }
        }

        /* ============================================================
           AUTH ZONE
        ============================================================ */
        .auth-zone {
            max-width: 480px; margin: 60px auto 0;
            padding: 0 18px;
        }
        .auth-zone__label {
            text-align: center; font-family: var(--font-mono);
            font-size: .62rem; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: .1em;
            margin-bottom: 14px;
        }

        .auth-tabs {
            display: flex; gap: 5px; margin-bottom: 18px;
            background: rgba(0,0,0,0.4);
            border-radius: 14px; padding: 5px;
            border: var(--border-soft);
        }
        .auth-tab {
            flex: 1; padding: 12px 8px; border-radius: 10px;
            border: none; background: transparent;
            color: var(--text-muted); font-weight: 700;
            font-size: .82rem; transition: all .3s var(--ease);
            position: relative; overflow: hidden;
        }
        .auth-tab.active {
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            color: #000;
            box-shadow: 0 4px 20px rgba(197,160,89,0.3);
        }

        .auth-card {
            position: relative; overflow: hidden;
            background: var(--bg-panel);
            backdrop-filter: blur(32px) saturate(160%);
            -webkit-backdrop-filter: blur(32px) saturate(160%);
            border: var(--border-gold);
            border-radius: var(--radius-lg);
            padding: 28px 22px;
            box-shadow: var(--shadow-card), var(--shadow-gold);
        }
        .auth-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(197,160,89,0.6), transparent);
        }

        /* Step indicator */
        .step-indicator {
            display: flex; align-items: center; gap: 6px; margin-bottom: 6px;
        }
        .step-dot {
            flex: 1; height: 3px; border-radius: 3px;
            background: rgba(255,255,255,0.08);
            transition: background .4s ease;
        }
        .step-dot.done {
            background: linear-gradient(90deg, var(--gold), var(--cyan));
            box-shadow: 0 0 10px rgba(197,160,89,0.4);
        }
        .step-label {
            font-family: var(--font-mono); font-size: .62rem;
            color: var(--text-muted); text-align: center;
            margin-bottom: 18px; letter-spacing: .04em;
        }

        /* Form steps */
        .form-step { display: none; }
        .form-step.active {
            display: block;
            animation: step-in .4s var(--ease) both;
        }
        @keyframes step-in {
            from { opacity: 0; transform: translateX(18px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* Account type choice */
        .type-choice { display: flex; gap: 8px; margin-bottom: 18px; }
        .type-choice label {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; gap: 5px;
            padding: 14px 8px; border-radius: 12px; cursor: pointer;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.25);
            font-size: .76rem; color: var(--text-muted);
            transition: all .3s var(--ease);
        }
        .type-choice input { display: none; }
        .type-choice label:has(input:checked) {
            border-color: var(--gold);
            background: rgba(197,160,89,0.1);
            color: #fff;
            box-shadow: 0 0 24px rgba(197,160,89,0.18);
            transform: translateY(-2px);
        }
        .type-choice .icon { font-size: 1.4rem; }

        /* Field groups */
        .field-group { margin-bottom: 14px; }
        .field-group label {
            display: block; font-family: var(--font-mono);
            font-size: .62rem; text-transform: uppercase;
            letter-spacing: .06em; color: var(--text-muted); margin-bottom: 6px;
        }
        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .auth-card input,
        .auth-card select {
            width: 100%; padding: 13px 14px; border-radius: var(--radius-sm);
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.45);
            color: var(--text-main); font-size: 15px;
            font-family: var(--font-body);
            transition: all .3s ease;
            -webkit-appearance: none;
        }
        .auth-card select option { background: #0a0d14; }
        .auth-card input:focus,
        .auth-card select:focus {
            outline: none; border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(95,212,255,0.12), 0 0 24px rgba(95,212,255,0.12);
            background: rgba(0,0,0,0.6);
        }
        .auth-card input::placeholder { color: var(--text-faint); }

        #champ-autre-pays { display: none; margin-top: 8px; }
        #bloc-metier { display: none; }

        /* Grade preview */
        .grade-preview {
            display: flex; align-items: center; gap: 12px;
            margin: 4px 0 16px;
            padding: 12px 14px; border-radius: 12px;
            background: rgba(197,160,89,0.07);
            border: 1px solid rgba(197,160,89,0.22);
        }
        .grade-preview__icon { font-size: 1.4rem; flex-shrink: 0; }
        .grade-preview__text { font-size: .76rem; color: var(--text-muted); line-height: 1.5; }
        .grade-preview__text strong { color: var(--gold); }

        /* Theme picker */
        .theme-picker {
            display: grid; grid-template-columns: repeat(2, 1fr);
            gap: 8px; margin-bottom: 16px;
        }
        .theme-card {
            position: relative; border-radius: 12px;
            padding: 12px 10px; cursor: pointer;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden; transition: all .3s ease; text-align: center;
        }
        .theme-card input { display: none; }
        .theme-card__preview { height: 28px; border-radius: 8px; margin-bottom: 8px; }
        .theme-card--strategiste .theme-card__preview { background: linear-gradient(90deg, #C5A059, #3a3a2a); }
        .theme-card--sagesse    .theme-card__preview { background: linear-gradient(90deg, #4a6fa5, #cfd8e8); }
        .theme-card--aventurier .theme-card__preview { background: linear-gradient(90deg, #5FD4FF, #d8c39a); }
        .theme-card--gaming     .theme-card__preview { background: linear-gradient(90deg, #9d5cff, #00e5ff); }
        .theme-card__name { font-size: .68rem; color: var(--text-muted); font-weight: 600; }
        .theme-card:has(input:checked) {
            border-color: var(--cyan);
            box-shadow: 0 0 20px rgba(95,212,255,0.2);
            transform: translateY(-2px);
        }
        .theme-card:has(input:checked) .theme-card__name { color: #fff; }

        /* Buttons */
        .btn-row { display: flex; gap: 10px; margin-top: 8px; }
        .auth-btn-back {
            padding: 14px 18px; border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.12);
            background: transparent; color: var(--text-muted);
            font-weight: 700; font-size: .82rem;
            transition: all .25s ease;
        }
        .auth-btn-back:hover { border-color: rgba(255,255,255,0.25); color: var(--text-main); }

        .auth-submit {
            flex: 1; padding: 14px; border: none; border-radius: 12px;
            position: relative; overflow: hidden;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
            color: #000; font-weight: 800; font-size: .9rem;
            font-family: var(--font-display); letter-spacing: .04em;
            transition: transform .25s var(--ease-back), box-shadow .25s ease;
        }
        .auth-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 40px rgba(197,160,89,0.4);
        }
        .auth-submit:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }
        .glow-follow {
            position: absolute; width: 140px; height: 140px;
            background: radial-gradient(circle, rgba(255,255,255,0.4), transparent 70%);
            border-radius: 50%; pointer-events: none; opacity: 0;
            transition: opacity .2s ease; transform: translate(-50%, -50%);
        }
        .auth-submit:hover .glow-follow { opacity: 1; }

        .auth-msg {
            text-align: center; margin-top: 14px;
            font-size: .8rem; color: var(--red); min-height: 20px;
            font-family: var(--font-mono);
        }
        .auth-msg.ok { color: var(--green); }

        .forgot-link {
            display: block; text-align: right; font-size: .74rem;
            color: var(--text-muted); margin-top: -4px; margin-bottom: 14px;
            transition: color .2s ease;
        }
        .forgot-link:hover { color: var(--cyan); }

        /* Social login divider */
        .auth-divider {
            display: flex; align-items: center; gap: 12px;
            margin: 18px 0; font-size: .72rem; color: var(--text-faint);
            font-family: var(--font-mono);
        }
        .auth-divider::before, .auth-divider::after {
            content: ''; flex: 1; height: 1px;
            background: rgba(255,255,255,0.08);
        }

        /* Trust badges */
        .trust-badges {
            display: flex; justify-content: center; gap: 16px;
            margin-top: 16px; flex-wrap: wrap;
        }
        .trust-badge {
            display: flex; align-items: center; gap: 5px;
            font-family: var(--font-mono); font-size: .6rem;
            color: var(--text-faint);
        }
        .trust-badge svg { opacity: .5; }

        @media (min-width: 768px) {
            .auth-card { padding: 36px 32px; border-radius: var(--radius-xl); }
        }

        /* ============================================================
           SECTION COMMONS
        ============================================================ */
        .section-wrap {
            max-width: 1060px; margin: 0 auto;
            padding: 80px 20px 0;
        }
        .section-header { text-align: center; margin-bottom: 40px; }
        .section-eyebrow {
            font-family: var(--font-mono); font-size: .64rem;
            letter-spacing: .14em; text-transform: uppercase;
            color: var(--text-muted); margin-bottom: 10px;
        }
        .section-title {
            font-family: var(--font-display); font-size: clamp(1.3rem, 3.5vw, 2rem);
            color: #fff; line-height: 1.2;
        }
        .section-title span {
            background: linear-gradient(135deg, var(--gold), var(--cyan));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .section-desc {
            color: var(--text-muted); font-size: .88rem;
            line-height: 1.65; max-width: 500px; margin: 12px auto 0;
        }

        /* ============================================================
           AUTOMATION / CONNECTORS SECTION
        ============================================================ */
        .connectors-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
        @media (min-width: 540px) { .connectors-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (min-width: 900px) { .connectors-grid { grid-template-columns: repeat(5, 1fr); } }

        .connector-card {
            background: var(--bg-panel);
            border: var(--border-soft);
            border-radius: var(--radius-md);
            padding: 20px 12px; text-align: center;
            transition: all .35s var(--ease);
            position: relative; overflow: hidden;
            cursor: default;
        }
        .connector-card::before {
            content: ''; position: absolute;
            inset: 0; opacity: 0;
            background: radial-gradient(circle at 50% 0%, rgba(95,212,255,0.1), transparent 70%);
            transition: opacity .35s ease;
        }
        .connector-card:hover { transform: translateY(-6px); border-color: rgba(95,212,255,0.35); }
        .connector-card:hover::before { opacity: 1; }

        .connector-card__icon { font-size: 1.8rem; margin-bottom: 10px; }
        .connector-card__name { font-size: .8rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
        .connector-card__desc { font-size: .65rem; color: var(--text-muted); line-height: 1.45; }
        .connector-badge {
            display: inline-flex; align-items: center; gap: 4px;
            margin-top: 10px; font-size: .58rem; font-family: var(--font-mono);
            padding: 3px 10px; border-radius: 20px;
            background: rgba(61,220,132,0.1); color: var(--green);
            border: 1px solid rgba(61,220,132,0.2);
        }
        .connector-badge::before {
            content: ''; width: 4px; height: 4px; border-radius: 50%;
            background: var(--green); box-shadow: 0 0 6px var(--green);
        }
        .connector-badge--soon {
            background: rgba(157,92,255,0.1); color: var(--violet);
            border-color: rgba(157,92,255,0.2);
        }
        .connector-badge--soon::before { background: var(--violet); box-shadow: 0 0 6px var(--violet); }

        /* ============================================================
           WHY SECTION — FEATURE CARDS
        ============================================================ */
        .features-grid {
            display: grid; grid-template-columns: 1fr;
            gap: 14px;
        }
        @media (min-width: 640px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (min-width: 960px) { .features-grid { grid-template-columns: repeat(3, 1fr); } }

        .feature-card {
            background: var(--bg-panel);
            border: var(--border-soft);
            border-radius: var(--radius-md);
            padding: 26px 22px;
            transition: all .35s var(--ease);
            position: relative; overflow: hidden;
        }
        .feature-card::after {
            content: ''; position: absolute;
            bottom: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, var(--gold), var(--cyan));
            transform: scaleX(0); transform-origin: left;
            transition: transform .4s var(--ease);
        }
        .feature-card:hover { transform: translateY(-5px); border-color: rgba(255,255,255,0.15); }
        .feature-card:hover::after { transform: scaleX(1); }

        .feature-card__icon {
            width: 44px; height: 44px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; margin-bottom: 16px;
            background: var(--bg-panel-strong);
            border: var(--border-soft);
        }
        .feature-card__title {
            font-family: var(--font-display); font-size: .95rem;
            color: #fff; margin-bottom: 8px;
        }
        .feature-card__desc {
            font-size: .8rem; color: var(--text-muted); line-height: 1.6;
        }
        .feature-card__tag {
            display: inline-block; margin-top: 14px;
            font-family: var(--font-mono); font-size: .58rem;
            padding: 3px 10px; border-radius: 20px;
            background: var(--gold-dim); color: var(--gold);
            border: 1px solid rgba(197,160,89,0.25);
        }

        /* ============================================================
           GRADES / RANKS SECTION
        ============================================================ */
        .grades-section { max-width: 1060px; margin: 0 auto; padding: 80px 20px 0; }
        .grades-track {
            display: flex; gap: 0; overflow-x: auto;
            padding-bottom: 16px; scrollbar-width: none;
        }
        .grades-track::-webkit-scrollbar { display: none; }

        .grade-card {
            flex: 0 0 160px; background: var(--bg-panel);
            border: var(--border-soft); border-radius: var(--radius-md);
            padding: 20px 14px; text-align: center;
            position: relative; transition: all .3s ease;
            margin-right: 10px;
        }
        .grade-card:hover { transform: translateY(-4px); border-color: rgba(197,160,89,0.3); }
        .grade-card.active {
            border-color: var(--gold);
            background: rgba(197,160,89,0.08);
            box-shadow: var(--shadow-gold);
        }
        .grade-card__emoji { font-size: 2rem; margin-bottom: 8px; }
        .grade-card__name {
            font-family: var(--font-display); font-size: .8rem;
            color: #fff; margin-bottom: 4px;
        }
        .grade-card__xp {
            font-family: var(--font-mono); font-size: .6rem;
            color: var(--text-muted);
        }
        .grade-card__perks {
            margin-top: 10px; font-size: .65rem;
            color: var(--text-muted); line-height: 1.5;
        }
        .grade-card.active .grade-card__name { color: var(--gold); }
        .grade-connector {
            flex: 0 0 20px; display: flex; align-items: center;
            justify-content: center; color: var(--text-faint);
            font-size: .7rem; margin-top: -20px;
        }

        /* ============================================================
           TESTIMONIALS
        ============================================================ */
        .testimonials-grid {
            display: grid; grid-template-columns: 1fr; gap: 14px;
        }
        @media (min-width: 640px) { .testimonials-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (min-width: 960px) { .testimonials-grid { grid-template-columns: repeat(3, 1fr); } }

        .testimonial-card {
            background: var(--bg-panel);
            border: var(--border-soft);
            border-radius: var(--radius-md);
            padding: 24px 20px;
            transition: all .3s ease;
            position: relative;
        }
        .testimonial-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.14); }
        .testimonial-card__quote {
            font-size: .85rem; color: var(--text-main);
            line-height: 1.65; margin-bottom: 18px;
            font-style: italic;
        }
        .testimonial-card__quote::before {
            content: '"'; font-family: var(--font-display);
            font-size: 2rem; color: var(--gold); line-height: 0;
            vertical-align: -0.5rem; margin-right: 4px; opacity: .6;
        }
        .testimonial-card__author {
            display: flex; align-items: center; gap: 10px;
        }
        .testimonial-card__avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), var(--cyan));
            display: flex; align-items: center; justify-content: center;
            font-size: .9rem; flex-shrink: 0;
        }
        .testimonial-card__name {
            font-weight: 700; font-size: .82rem; color: #fff;
        }
        .testimonial-card__role {
            font-family: var(--font-mono); font-size: .62rem;
            color: var(--text-muted);
        }
        .testimonial-stars {
            position: absolute; top: 20px; right: 20px;
            font-size: .7rem; color: var(--gold);
            letter-spacing: 2px;
        }

        /* ============================================================
           ECOSYSTEM CARDS
        ============================================================ */
        .ecosystem-grid {
            display: grid; grid-template-columns: 1fr; gap: 14px;
        }
        @media (min-width: 768px) { .ecosystem-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; } }

        .eco-card {
            background: var(--bg-panel);
            backdrop-filter: blur(14px);
            border: var(--border-soft);
            border-radius: var(--radius-md);
            padding: 22px 18px;
            text-decoration: none; color: var(--text-main);
            display: flex; align-items: center; gap: 16px;
            transition: all .35s var(--ease);
            position: relative; overflow: hidden;
        }
        @media (min-width: 768px) {
            .eco-card { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
        }
        .eco-card::before {
            content: ''; position: absolute; inset: 0; opacity: 0;
            background: radial-gradient(circle at 30% 30%, rgba(95,212,255,0.08), transparent 70%);
            transition: opacity .35s ease;
        }
        .eco-card:hover {
            transform: translateY(-8px);
            border-color: rgba(95,212,255,0.4);
            box-shadow: 0 24px 50px rgba(0,0,0,0.35), var(--shadow-cyan);
        }
        .eco-card:hover::before { opacity: 1; }
        .eco-card__icon {
            font-size: 1.8rem; flex-shrink: 0;
            width: 52px; height: 52px; border-radius: 14px;
            background: var(--bg-panel-strong); border: var(--border-soft);
            display: flex; align-items: center; justify-content: center;
        }
        .eco-card h3 {
            font-family: var(--font-display); font-size: 1.05rem; color: #fff;
            margin-bottom: 6px;
        }
        .eco-card p { color: var(--text-muted); font-size: .8rem; line-height: 1.5; }
        .eco-card__arrow {
            margin-top: 14px; font-family: var(--font-mono);
            font-size: .7rem; color: var(--cyan);
            display: flex; align-items: center; gap: 5px;
            transition: gap .25s ease;
        }
        .eco-card:hover .eco-card__arrow { gap: 10px; }

        /* ============================================================
           QUOTE SECTION
        ============================================================ */
        .quote-section {
            max-width: 700px; margin: 80px auto 0;
            padding: 0 24px; text-align: center;
        }
        .quote-section__inner {
            padding: 40px 32px; border-radius: var(--radius-xl);
            background: var(--bg-panel);
            border: var(--border-gold);
            box-shadow: var(--shadow-gold);
            position: relative; overflow: hidden;
        }
        .quote-section__inner::before {
            content: '❝'; position: absolute; top: -10px; left: 24px;
            font-size: 5rem; color: rgba(197,160,89,0.08);
            font-family: var(--font-display); line-height: 1;
        }
        .quote-section p {
            font-family: var(--font-display); font-size: clamp(1rem, 2.5vw, 1.25rem);
            color: var(--text-main); font-style: italic; line-height: 1.6;
            position: relative; z-index: 1;
        }
        .quote-section span {
            display: block; margin-top: 16px;
            font-family: var(--font-mono); font-size: .7rem;
            color: var(--gold); letter-spacing: .08em;
        }

        /* ============================================================
           CTA BANNER
        ============================================================ */
        .cta-banner {
            max-width: 800px; margin: 80px auto 0;
            padding: 0 20px;
        }
        .cta-banner__inner {
            border-radius: var(--radius-xl);
            padding: 50px 32px; text-align: center;
            background: linear-gradient(135deg, rgba(197,160,89,0.12) 0%, rgba(95,212,255,0.08) 50%, rgba(157,92,255,0.08) 100%);
            border: var(--border-gold);
            position: relative; overflow: hidden;
        }
        .cta-banner__inner::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(197,160,89,0.1), transparent 70%);
        }
        .cta-banner h2 {
            font-family: var(--font-display); font-size: clamp(1.4rem, 4vw, 2.2rem);
            color: #fff; margin-bottom: 12px; position: relative;
        }
        .cta-banner p {
            color: var(--text-muted); font-size: .9rem; margin-bottom: 28px;
            position: relative;
        }
        .cta-btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 16px 32px; border-radius: 14px;
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            color: #000; font-weight: 800; font-size: .95rem;
            font-family: var(--font-display); letter-spacing: .04em;
            transition: all .3s var(--ease-back);
            position: relative;
        }
        .cta-btn:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 16px 50px rgba(197,160,89,0.45);
        }

        /* ============================================================
           FOOTER
        ============================================================ */
        .site-footer {
            border-top: var(--border-soft);
            padding: 40px 20px; margin-top: 80px;
        }
        .site-footer__inner {
            max-width: 1060px; margin: 0 auto;
            display: flex; flex-direction: column;
            align-items: center; gap: 24px; text-align: center;
        }
        @media (min-width: 768px) {
            .site-footer__inner {
                flex-direction: row; justify-content: space-between;
                text-align: left;
            }
        }
        .footer-brand {
            font-family: var(--font-display); font-weight: 800;
            font-size: .95rem; color: #fff;
        }
        .footer-brand span { color: var(--gold); }
        .footer-tagline {
            font-family: var(--font-mono); font-size: .65rem;
            color: var(--text-muted); margin-top: 4px;
        }
        .social-links { display: flex; gap: 8px; }
        .social-links a {
            color: var(--text-muted);
            display: flex; align-items: center; justify-content: center;
            width: 36px; height: 36px; border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.09);
            transition: all .25s ease;
        }
        .social-links a:hover {
            color: var(--gold); border-color: rgba(197,160,89,0.4);
            background: rgba(197,160,89,0.07); transform: translateY(-3px);
        }
        .footer-links {
            display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;
        }
        .footer-links a {
            font-family: var(--font-mono); font-size: .65rem;
            color: var(--text-muted); transition: color .2s ease;
        }
        .footer-links a:hover { color: var(--cyan); }
        .site-footer__meta {
            font-family: var(--font-mono); font-size: .62rem;
            color: var(--text-faint);
        }

        /* ============================================================
           SCROLL REVEAL ANIMATIONS
        ============================================================ */
        .reveal {
            opacity: 0; transform: translateY(28px);
            transition: opacity .7s var(--ease), transform .7s var(--ease);
        }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: .1s; }
        .reveal-delay-2 { transition-delay: .2s; }
        .reveal-delay-3 { transition-delay: .3s; }
        .reveal-delay-4 { transition-delay: .4s; }
        .reveal-delay-5 { transition-delay: .5s; }

        /* ============================================================
           CONNECTED BANNER (if user already logged in)
        ============================================================ */
        .connected-banner {
            max-width: 700px; margin: 24px auto 0;
            padding: 16px 22px; border-radius: var(--radius-md);
            background: rgba(61,220,132,0.07);
            border: 1px solid rgba(61,220,132,0.2);
            display: flex; align-items: center;
            justify-content: space-between; flex-wrap: wrap; gap: 12px;
        }
        .connected-banner__text { color: var(--text-main); font-size: .85rem; }
        .connected-banner__text strong { color: var(--gold); }
        .continue-btn {
            padding: 10px 20px; border-radius: 10px;
            background: linear-gradient(135deg, var(--gold), var(--gold-light));
            color: #000; font-weight: 800; font-size: .82rem;
            font-family: var(--font-display); white-space: nowrap;
            transition: all .25s ease;
        }
        .continue-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(197,160,89,0.3); }

        /* ============================================================
           MOBILE RESPONSIVE TWEAKS
        ============================================================ */
        @media (max-width: 480px) {
            .hero { padding: 50px 16px 20px; }
            .stats-bar__inner { border-radius: var(--radius-md); }
            .stat-item { min-width: 90px; padding: 16px 10px; }
            .stat-item__num { font-size: 1.3rem; }
            .field-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- ============================================================
         WORLD BACKGROUND
    ============================================================ -->
    <div class="world-bg">
        <div class="world-bg__overlay"></div>
        <svg class="world-svg" viewBox="0 0 900 900" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="arcGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%"   stop-color="#C5A059"/>
                    <stop offset="50%"  stop-color="#5FD4FF"/>
                    <stop offset="100%" stop-color="#9d5cff"/>
                </linearGradient>
            </defs>
            <g class="world-rotate">
                <circle class="globe-ring"          cx="450" cy="450" r="380"/>
                <circle class="globe-ring globe-ring--gold"   cx="450" cy="450" r="310"/>
                <circle class="globe-ring globe-ring--violet" cx="450" cy="450" r="240"/>
                <circle class="globe-ring"          cx="450" cy="450" r="170"/>
                <ellipse class="globe-meridian" cx="450" cy="450" rx="380" ry="100"/>
                <ellipse class="globe-meridian" cx="450" cy="450" rx="380" ry="200"/>
                <ellipse class="globe-meridian" cx="450" cy="450" rx="380" ry="300"/>
                <ellipse class="globe-meridian" cx="450" cy="450" rx="100" ry="380"/>
                <ellipse class="globe-meridian" cx="450" cy="450" rx="200" ry="380"/>
                <ellipse class="globe-meridian" cx="450" cy="450" rx="300" ry="380"/>
            </g>
            <!-- Hub nodes -->
            <circle class="hub-dot"          cx="450" cy="370" r="5"/>
            <circle class="hub-pulse hub-pulse--gold" cx="450" cy="370" r="5"/>
            <circle class="hub-dot--cyan"    cx="560" cy="290" r="4"/>
            <circle class="hub-pulse"        cx="560" cy="290" r="4"/>
            <circle class="hub-dot"          cx="620" cy="450" r="4"/>
            <circle class="hub-pulse hub-pulse--gold" cx="620" cy="450" r="4"/>
            <circle class="hub-dot--violet"  cx="370" cy="410" r="3.5"/>
            <circle class="hub-pulse hub-pulse--violet" cx="370" cy="410" r="3.5"/>
            <circle class="hub-dot--cyan"    cx="540" cy="340" r="3.5"/>
            <circle class="hub-dot"          cx="510" cy="430" r="3.5"/>
            <circle class="hub-dot--cyan"    cx="340" cy="320" r="3"/>
            <circle class="hub-dot--violet"  cx="580" cy="510" r="3"/>
            <!-- Arc connections -->
            <path class="arc-line" d="M450,370 Q505,280 560,290"/>
            <path class="arc-line" d="M450,370 Q535,390 620,450"/>
            <path class="arc-line" d="M450,370 Q410,390 370,410"/>
            <path class="arc-line" d="M450,370 Q480,400 510,430"/>
            <path class="arc-line" d="M560,290 Q550,315 540,340"/>
            <path class="arc-line" d="M450,370 Q395,345 340,320"/>
            <path class="arc-line" d="M620,450 Q600,480 580,510"/>
        </svg>
    </div>
    <div class="bg-particles"></div>
    <div class="noise-overlay"></div>

    <!-- ============================================================
         TOP BAR
    ============================================================ -->
    <header class="top-bar" id="topBar">
        <div class="brand">
            <div class="brand__logo">👑</div>
            OG <span class="brand__separator">·</span> EMPIRE
        </div>

        <nav class="top-bar__center">
            <a href="/marketplace" class="nav-link">Marketplace</a>
            <a href="/community"   class="nav-link">Community</a>
            <a href="/academy"     class="nav-link">Academy</a>
            <a href="#connectors"  class="nav-link">Connecteurs</a>
        </nav>

        <div class="top-bar__right">
            <div class="status-pill">
                <span class="status-pill__dot"></span>
                SAMII OS · LIVE
            </div>
        </div>
    </header>

    <!-- ============================================================
         HERO
    ============================================================ -->
    <section class="hero">
        <div class="eyebrow">
            <span class="dot"></span>
            Plateforme d'automatisation souveraine
        </div>

        <h1 class="hero__title">
            L'empire commence ici.
            <span class="line2">Automatisez tout.</span>
        </h1>

        <p class="hero__subtitle">
            <strong>SAMII OS</strong> connecte Shopify, WhatsApp, Instagram, Telegram et bien plus —
            depuis un seul tableau de bord. Gérez votre empire sans friction,
            <strong>24h/24, 7j/7.</strong>
        </p>

        <div class="scroll-hint">
            DÉCOUVRIR
            <div class="scroll-hint__arrow"></div>
        </div>
    </section>

    <!-- ============================================================
         LIVE STATS BAR
    ============================================================ -->
    <div class="stats-bar reveal">
        <div class="stats-bar__inner">
            <div class="stat-item">
                <div class="stat-item__icon">🏪</div>
                <div class="stat-item__num" id="stat-marchands">0</div>
                <div class="stat-item__label">Marchands actifs</div>
