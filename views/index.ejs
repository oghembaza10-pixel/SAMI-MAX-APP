        let currentLang = localStorage.getItem('samii_lang') || 'fr';
        function t(key) { return (I18N[currentLang] && I18N[currentLang][key]) || I18N.fr[key] || key; }

        function applyLang(lang) {
            if (!I18N[lang]) lang = 'fr';
            currentLang = lang;
            localStorage.setItem('samii_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (I18N[lang][key] !== undefined) el.textContent = I18N[lang][key];
            });
            document.querySelectorAll('[data-i18n-ph]').forEach(el => {
                const key = el.getAttribute('data-i18n-ph');
                if (I18N[lang][key] !== undefined) el.placeholder = I18N[lang][key];
            });
            document.querySelectorAll('.lang-switch span').forEach(s => s.classList.toggle('active', s.dataset.lang === lang));

            const activeStep = document.querySelector('.form-step.active');
            if (activeStep) {
                const stepN = activeStep.dataset.step;
                document.getElementById('step-label').textContent = stepN === '2' ? t('auth.step2.label') : t('auth.step1.label');
            }
        }

        document.querySelectorAll('.lang-switch span').forEach(span => {
            span.addEventListener('click', () => applyLang(span.dataset.lang));
        });

        applyLang(currentLang);

        document.querySelectorAll('.auth-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                const target = tab.dataset.tab;
                document.getElementById('form-register').style.display = target === 'register' ? 'block' : 'none';
                document.getElementById('form-login').style.display = target === 'login' ? 'block' : 'none';
                document.getElementById('form-partenariat').style.display = target === 'partenariat' ? 'block' : 'none';
                document.getElementById('auth-msg').textContent = '';
            });
        });

        document.querySelectorAll('input[name="partner_categorie"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.getElementById('partner-details').style.display = 'block';
            });
        });

        document.getElementById('btn-partner-submit').addEventListener('click', async () => {
            const msg = document.getElementById('partner-msg');
            const categorie = document.querySelector('input[name="partner_categorie"]:checked')?.value;
            const email = document.getElementById('partner-email').value.trim();
            const telephone = document.getElementById('partner-telephone').value.trim();
            const description = document.getElementById('partner-description').value.trim();

            if (!categorie || !email || !description) {
                msg.textContent = t('msg.error_default');
                msg.className = 'auth-msg';
                return;
            }

            const btn = document.getElementById('btn-partner-submit');
            btn.disabled = true;
            msg.textContent = t('msg.creating');
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/partenariat', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ categorie, email, telephone, description }),
                });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = t('partenariat.sent');
                    msg.className = 'auth-msg ok';
                    document.getElementById('partner-email').value = '';
                    document.getElementById('partner-telephone').value = '';
                    document.getElementById('partner-description').value = '';
                    document.querySelectorAll('input[name="partner_categorie"]').forEach(r => r.checked = false);
                    document.getElementById('partner-details').style.display = 'none';
                    btn.disabled = false;
                } else {
                    msg.textContent = json.error || t('msg.error_default');
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = t('msg.error_network');
                btn.disabled = false;
            }
        });

        document.getElementById('select-pays').addEventListener('change', function () {
            document.getElementById('champ-autre-pays').style.display = this.value === 'autre' ? 'block' : 'none';
        });

        function goToStep(n) {
            document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
            document.querySelector('.form-step[data-step="' + n + '"]').classList.add('active');
            document.querySelectorAll('.step-dot').forEach(d => d.classList.toggle('done', parseInt(d.dataset.stepDot, 10) <= n));
            document.getElementById('step-label').textContent = n === 2 ? t('auth.step2.label') : t('auth.step1.label');
        }
        document.getElementById('btn-step1-next').addEventListener('click', () => {
            const form = document.getElementById('form-register');
            const requiredFields = form.querySelectorAll('.form-step[data-step="1"] [required]');
            for (const field of requiredFields) { if (!field.value) { field.reportValidity(); return; } }
            goToStep(2);
        });
        document.getElementById('btn-step2-back').addEventListener('click', () => goToStep(1));

        document.getElementById('form-register').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('auth-msg');
            const btn = e.target.querySelector('button[type="submit"]');
            const data = Object.fromEntries(new FormData(e.target));
            if (data.pays === 'autre' && data.pays_autre) { data.pays = data.pays_autre; }
            delete data.pays_autre;

            btn.disabled = true;
            msg.textContent = t('msg.creating');
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = json.message || t('msg.created_default');
                    msg.className = 'auth-msg ok';
                    if (json.redirect) setTimeout(() => window.location.href = json.redirect, 1200);
                } else {
                    msg.textContent = json.error || t('msg.error_default');
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = t('msg.error_network');
                btn.disabled = false;
            }
        });

        document.getElementById('form-login').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('auth-msg');
            const btn = e.target.querySelector('button');
            const data = Object.fromEntries(new FormData(e.target));

            btn.disabled = true;
            msg.textContent = t('msg.connecting');
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = t('msg.connected');
                    msg.className = 'auth-msg ok';
                    window.location.href = json.redirect || '/';
                } else {
                    msg.textContent = json.error || t('msg.error_default');
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = t('msg.error_network');
                btn.disabled = false;
            }
        });
    </script>
    <script src="/js/pwa-register.js"></script>
</body>
</html>
