<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAMII OS — L'Empire de l'Automatisation E-Commerce</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #030407;
            --bg-surface: rgba(12, 16, 28, 0.85);
            --bg-panel: rgba(255, 255, 255, 0.03);
            --bg-panel-strong: rgba(255, 255, 255, 0.06);
            --gold: #C5A059;
            --gold-hover: #E8C27A;
            --gold-glow: rgba(197, 160, 89, 0.4);
            --cyan: #5FD4FF;
            --success: #3ddc84;
            --text-main: #F1F0EC;
            --text-muted: #838a99;
            --border-soft: 1px solid rgba(255, 255, 255, 0.08);
            --border-gold: 1px solid rgba(197, 160, 89, 0.4);
            --font-display: 'Cinzel', serif;
            --font-body: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --ease: cubic-bezier(0.16, 1, 0.3, 1);
            --shadow-luxury: 0 30px 60px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(197, 160, 89, 0.25);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
        body {
            background: var(--bg-deep);
            color: var(--text-main);
            font-family: var(--font-body);
            min-height: 100vh;
            width: 100%;
            overflow-x: hidden;
            position: relative;
        }

        /* --- FOND GÉODÉSIQUE & GLOBE D'OR CENTRAL --- */
        .world-bg { position: fixed; inset: 0; z-index: -3; overflow: hidden; pointer-events: none; }
        .world-bg__overlay {
            position: absolute; inset: 0;
            background: 
                radial-gradient(circle at 50% 25%, rgba(197, 160, 89, 0.18), transparent 55%),
                radial-gradient(circle at 50% 90%, rgba(95, 212, 255, 0.06), transparent 70%),
                linear-gradient(180deg, rgba(3, 4, 7, 0.8) 0%, var(--bg-deep) 90%);
        }
        .world-svg { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%); width: min(1500px, 240vw); height: auto; opacity: .55; }
        .globe-ring { fill: none; stroke: rgba(197, 160, 89, 0.18); stroke-width: 1.2; }
        .globe-ring--gold { stroke: rgba(197, 160, 89, 0.35); stroke-dasharray: 6 6; }
        .globe-meridian { fill: none; stroke: rgba(197, 160, 89, 0.08); stroke-width: 1; }
        .gold-sphere { fill: url(#goldSphereGrad); filter: drop-shadow(0 0 40px rgba(197, 160, 89, 0.7)); }
        .hub-dot { fill: #fff; filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.9)); }
        .hub-pulse { fill: none; stroke: var(--gold); stroke-width: 1.5; opacity: 0; transform-origin: center; animation: pulse-ring 4s cubic-bezier(0.1, 0.8, 0.3, 1) infinite; }
        @keyframes pulse-ring {
            0% { opacity: .9; transform: scale(0.2); }
            100% { opacity: 0; transform: scale(3.8); }
        }
        .arc-line { fill: none; stroke: url(#arcGoldGradient); stroke-width: 1.8; stroke-dasharray: 10 6; opacity: .8; animation: arc-flow 4s linear infinite; }
        @keyframes arc-flow { to { stroke-dashoffset: -120; } }
        .world-rotate { animation: world-spin 140s linear infinite; transform-origin: center; }
        @keyframes world-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        .bg-particles {
            position: fixed; inset: 0; z-index: -2; pointer-events: none; opacity: .22;
            background-image: radial-gradient(circle, rgba(197,160,89,0.5) 1.5px, transparent 1.5px), radial-gradient(circle, rgba(255,255,255,0.3) 1px, transparent 1px);
            background-size: 200px 200px, 300px 300px;
            animation: particles-drift 70s linear infinite;
        }
        @keyframes particles-drift { from { background-position: 0 0, 0 0; } to { background-position: 0 -700px, 0 -900px; } }

        /* --- TOP BAR & MODE SELECTOR --- */
        .top-bar {
            position: sticky; top: 0; z-index: 1000;
            display: flex; justify-content: space-between; align-items: center;
            padding: 16px 24px; backdrop-filter: blur(28px);
            background: rgba(3, 4, 7, 0.92); border-bottom: var(--border-soft);
            width: 100%;
        }
        .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 800; color: #fff; font-size: 1.15rem; letter-spacing: 0.12em; text-decoration: none; }
        .brand span { background: linear-gradient(135deg, #fff 20%, var(--gold)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .top-bar__right { display: flex; align-items: center; gap: 14px; }
        
        /* Sélecteur de Modes (Amazon / GitHub / Database) */
        .mode-switcher {
            display: flex; gap: 3px; background: rgba(0,0,0,0.6); padding: 3px; border-radius: 12px; border: var(--border-soft);
        }
        .mode-btn {
            padding: 6px 12px; border-radius: 9px; border: none; background: transparent; color: var(--text-muted);
            font-family: var(--font-mono); font-size: .7rem; font-weight: 600; cursor: pointer; transition: all .25s ease;
        }
        .mode-btn.active, .mode-btn:hover { color: var(--gold); background: rgba(197,160,89,0.15); box-shadow: 0 0 15px rgba(197,160,89,0.2); }

        .lang-switch { display: flex; gap: 3px; font-family: var(--font-mono); font-size: .7rem; background: rgba(0,0,0,0.6); padding: 3px; border-radius: 10px; border: var(--border-soft); }
        .lang-switch span { padding: 5px 8px; border-radius: 7px; cursor: pointer; color: var(--text-muted); transition: all .2s ease; font-weight: 600; }
        .lang-switch span.active, .lang-switch span:hover { color: var(--gold); background: rgba(197,160,89,0.15); }

        /* --- HERO SECTION --- */
        .hero { max-width: 900px; margin: 0 auto; padding: 50px 20px 20px; text-align: center; }
        .eyebrow {
            font-family: var(--font-mono); letter-spacing: .2em; font-size: .72rem; color: var(--gold);
            text-transform: uppercase; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;
            padding: 6px 18px; border-radius: 20px; background: rgba(197,160,89,0.08); border: 1px solid rgba(197,160,89,0.35);
        }
        .eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); box-shadow: 0 0 10px var(--success); animation: blink 2s infinite; }
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
        
        .hero h1 {
            font-family: var(--font-display); font-size: clamp(2.3rem, 7vw, 4.2rem); color: #fff; line-height: 1.12;
            margin-bottom: 20px; font-weight: 800; letter-spacing: -0.01em;
            text-shadow: 0 0 60px rgba(197,160,89,0.35);
        }
        .hero h1 span { background: linear-gradient(135deg, #fff 15%, var(--gold) 85%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero p { color: var(--text-muted); font-size: 1.08rem; line-height: 1.75; padding: 0 10px; max-width: 680px; margin: 0 auto 32px; }

        .live-stats { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 10px; padding: 0 16px; }
        .live-stat { text-align: center; background: var(--bg-panel); border: var(--border-soft); padding: 14px 24px; border-radius: 14px; min-width: 150px; backdrop-filter: blur(12px); }
        .live-stat__num { font-family: var(--font-mono); font-weight: 700; font-size: 1.6rem; color: var(--gold); text-shadow: 0 0 20px rgba(197,160,89,0.45); }
        .live-stat__label { font-family: var(--font-mono); font-size: .65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .1em; margin-top: 4px; }

        /* --- AUTH ZONE (EXPÉRONTION VIRTUELLE & CONNEXION) --- */
        .auth-zone { max-width: 520px; margin: 36px auto 0; padding: 0 20px; }
        .auth-tabs {
            display: flex; gap: 6px; margin-bottom: 18px;
            background: rgba(0, 0, 0, 0.5); border-radius: 14px; padding: 5px; border: var(--border-soft);
        }
        .auth-tab {
            flex: 1; padding: 12px 10px; border-radius: 10px; border: none; background: transparent;
            color: var(--text-muted); font-family: var(--font-body); font-weight: 700; font-size: .86rem; cursor: pointer;
            transition: all .3s var(--ease);
        }
        .auth-tab.active { background: linear-gradient(135deg, var(--gold), var(--gold-hover)); color: #000; box-shadow: 0 4px 20px rgba(197,160,89,0.35); }

        .auth-card {
            position: relative; overflow: hidden;
            background: var(--bg-surface); backdrop-filter: blur(35px); border: var(--border-gold);
            border-radius: 26px; padding: 32px 24px; box-shadow: var(--shadow-luxury);
        }
        .auth-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        .step-indicator { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
        .step-dot { flex: 1; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.1); transition: background .4s ease; }
        .step-dot.done { background: var(--gold); box-shadow: 0 0 12px rgba(197,160,89,0.7); }
        .step-label { font-family: var(--font-mono); font-size: .68rem; color: var(--gold); text-align: center; margin-bottom: 18px; letter-spacing: .08em; text-transform: uppercase; }

        .form-step { display: none; }
        .form-step.active { display: block; animation: step-in .4s var(--ease) both; }
        @keyframes step-in { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        .type-choice { display: flex; gap: 10px; margin-bottom: 20px; }
        .type-choice label {
            flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px;
            padding: 16px 10px; border-radius: 14px; cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(0, 0, 0, 0.3);
            font-size: .8rem; color: var(--text-muted); transition: all .3s ease;
        }
        .type-choice input { display: none; }
        .type-choice label:has(input:checked) {
            border-color: var(--gold); background: rgba(197, 160, 89, 0.14); color: #fff;
            box-shadow: 0 0 25px rgba(197, 160, 89, 0.3);
        }
        .type-choice .icon { font-size: 1.5rem; }

        .field-group { margin-bottom: 16px; }
        .field-group label {
            display: block; font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase;
            letter-spacing: .08em; color: var(--text-muted); margin-bottom: 6px;
        }
        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .auth-card input, .auth-card select {
            width: 100%; padding: 13px 16px; border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(0, 0, 0, 0.5);
            color: var(--text-main); font-size: 16px; font-family: var(--font-body);
            transition: all .3s ease;
        }
        .auth-card select option { background: #0a0d14; color: #fff; }
        .auth-card input:focus, .auth-card select:focus {
            outline: none; border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.18), 0 0 25px rgba(197, 160, 89, 0.3);
            background: rgba(0, 0, 0, 0.7);
        }

        #champ-autre-pays { display: none; margin-top: 10px; }

        .grade-preview {
            display: flex; align-items: center; gap: 12px; margin-top: 6px; margin-bottom: 18px;
            padding: 12px 16px; border-radius: 12px;
            background: rgba(197, 160, 89, 0.08); border: 1px solid rgba(197, 160, 89, 0.3);
        }
        .grade-preview__icon { font-size: 1.5rem; }
        .grade-preview__text { font-size: .78rem; color: var(--text-muted); line-height: 1.45; }
        .grade-preview__text strong { color: var(--gold); }

        .btn-row { display: flex; gap: 10px; margin-top: 10px; }
        .auth-btn-back {
            padding: 14px 18px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.15);
            background: transparent; color: var(--text-muted); font-weight: 700; font-size: .84rem; cursor: pointer;
            transition: all .25s ease;
        }
        .auth-btn-back:hover { color: #fff; border-color: rgba(255,255,255,0.35); background: rgba(255,255,255,0.04); }

        .auth-submit {
            flex: 1; padding: 14px; border: none; border-radius: 12px; position: relative; overflow: hidden;
            background: linear-gradient(135deg, var(--gold), var(--gold-hover)); color: #000;
            font-weight: 800; font-size: .92rem; cursor: pointer; font-family: var(--font-display);
            transition: transform .2s ease, box-shadow .2s ease;
            box-shadow: 0 4px 20px rgba(197,160,89,0.35);
        }
        .auth-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 28px rgba(197,160,89,0.55); }
        
        .glow-follow {
            position: absolute; width: 120px; height: 120px;
            background: radial-gradient(circle, rgba(255,255,255,0.5), transparent 70%);
            border-radius: 50%; pointer-events: none; opacity: 0; transition: opacity .2s ease;
            transform: translate(-50%, -50%);
        }
        .auth-submit:hover .glow-follow { opacity: 1; }

        .auth-msg { text-align: center; margin-top: 14px; font-size: .82rem; color: #ff6b6b; min-height: 20px; font-family: var(--font-mono); }
        .auth-msg.ok { color: var(--success); }
        .forgot-link { display: block; text-align: right; font-size: .76rem; color: var(--text-muted); text-decoration: none; margin-top: -6px; margin-bottom: 14px; transition: color .2s; }
        .forgot-link:hover { color: var(--gold); }

        /* --- SECTION AUTOMATISATION & CANAUX OMNICANAUX --- */
        .automation-section { max-width: 1150px; margin: 90px auto 0; padding: 0 20px; }
        .section-title {
            text-align: center; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .2em;
            text-transform: uppercase; color: var(--gold); margin-bottom: 8px;
        }
        .section-subtitle { text-align: center; font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.2rem); color: #fff; margin-bottom: 36px; font-weight: 700; }
        
        .automation-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
        @media (min-width: 768px) { .automation-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
        
        .automation-card {
            background: var(--bg-panel); border: var(--border-soft); border-radius: 20px;
            padding: 26px 20px; text-align: center; transition: all .35s var(--ease); backdrop-filter: blur(14px);
            position: relative; overflow: hidden;
        }
        .automation-card::after {
            content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(197,160,89,0.1), transparent);
            opacity: 0; transition: opacity .3s ease; pointer-events: none;
        }
        .automation-card:hover { transform: translateY(-6px); border-color: rgba(197, 160, 89, 0.55); background: var(--bg-panel-strong); box-shadow: 0 18px 40px rgba(0,0,0,0.6); }
        .automation-card:hover::after { opacity: 1; }
        .automation-card__icon { font-size: 2.4rem; margin-bottom: 14px; filter: drop-shadow(0 0 12px rgba(197,160,89,0.45)); }
        .automation-card__name { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 8px; font-family: var(--font-display); }
        .automation-card__desc { font-size: .76rem; color: var(--text-muted); line-height: 1.55; }
        .automation-badge {
            display: inline-block; margin-top: 16px; font-size: .65rem; font-family: var(--font-mono);
            padding: 4px 12px; border-radius: 20px; background: rgba(61, 220, 132, 0.12); color: var(--success);
            border: 1px solid rgba(61, 220, 132, 0.3);
        }

        /* --- SECTION VISUELLE IMMERSIVE & FUTURISTE (Bas de page) --- */
        .immersive-render-section { max-width: 1150px; margin: 100px auto 40px; padding: 0 20px; text-align: center; }
        .render-container {
            position: relative; border-radius: 28px; overflow: hidden; border: var(--border-gold);
            background: rgba(10, 14, 24, 0.9); box-shadow: var(--shadow-luxury); padding: 40px 20px;
        }
        .render-container::before {
            content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgba(197,160,89,0.12), transparent 70%); pointer-events: none;
        }
        .render-title { font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.4rem); color: #fff; margin-bottom: 16px; font-weight: 800; }
        .render-desc { color: var(--text-muted); font-size: .95rem; max-width: 700px; margin: 0 auto 32px; line-height: 1.7; }
        
        /* Visuel Virtuel Avancé (Simulateur d'interface Graphique) */
        .virtual-preview-box {
            position: relative; border-radius: 18px; overflow: hidden; border: var(--border-soft);
            background: #060911; text-align: left; box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }
        .preview-header {
            display: flex; align-items: center; justify-content: space-between; padding: 12px 18px;
            background: rgba(255,255,255,0.03); border-bottom: var(--border-soft);
        }
        .preview-dots { display: flex; gap: 6px; }
        .preview-dot { width: 10px; height: 10px; border-radius: 50%; }
        .dot-red { background: #ff5f56; }
        .dot-yellow { background: #ffbd2e; }
        .dot-green { background: #27c93f; }
        .preview-title { font-family: var(--font-mono); font-size: .72rem; color: var(--text-muted); letter-spacing: .08em; }

        .preview-body { padding: 30px; display: grid; grid-template-columns: 1fr; gap: 20px; }
        @media(min-width: 768px) { .preview-body { grid-template-columns: 1.2fr 0.8fr; } }

        .preview-console {
            background: rgba(0,0,0,0.6); border: var(--border-soft); border-radius: 12px; padding: 18px;
            font-family: var(--font-mono); font-size: .78rem; color: var(--cyan); line-height: 1.6;
        }
        .console-line { margin-bottom: 6px; display: flex; align-items: center; gap: 8px; }
        .console-prompt { color: var(--gold); }

        .preview-metrics {
            display: flex; flex-direction: column; gap: 12px; justify-content: center;
        }
        .metric-card {
            background: rgba(255,255,255,0.02); border: var(--border-soft); border-radius: 12px; padding: 14px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .metric-label { font-family: var(--font-mono); font-size: .72rem; color: var(--text-muted); }
        .metric-val { font-family: var(--font-mono); font-size: .95rem; font-weight: 700; color: var(--success); }

        /* --- FOOTER --- */
        .site-footer {
            border-top: var(--border-soft); padding: 36px 20px; margin-top: 80px;
            display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center;
            background: rgba(3, 4, 7, 0.96); backdrop-filter: blur(20px);
        }
        @media (min-width: 768px) { .site-footer { flex-direction: row; justify-content: space-between; padding: 36px 50px; } }
        .site-footer__quote { font-family: var(--font-mono); color: var(--text-muted); font-size: .72rem; letter-spacing: 0.06em; }
        .site-footer__meta { font-family: var(--font-mono); font-size: .68rem; color: var(--text-muted); }

        @media (min-width: 768px) {
            .top-bar { padding: 18px 45px; }
            .brand { font-size: 1.25rem; }
            .auth-card { padding: 38px; border-radius: 30px; }
        }
    </style>
</head>
<body>

    <!-- Fond Géodésique & Globe d'or central -->
    <div class="world-bg">
        <div class="world-bg__overlay"></div>
        <svg class="world-svg" viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="goldSphereGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#E8C27A"/>
                    <stop offset="50%" stop-color="#C5A059"/>
                    <stop offset="100%" stop-color="#5a451d"/>
                </linearGradient>
                <linearGradient id="arcGoldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#C5A059"/>
                    <stop offset="100%" stop-color="#E8C27A"/>
                </linearGradient>
            </defs>
            <g class="world-rotate">
                <circle class="globe-ring" cx="400" cy="400" r="320"/>
                <circle class="globe-ring globe-ring--gold" cx="400" cy="400" r="250"/>
                <circle class="globe-ring" cx="400" cy="400" r="180"/>
                <ellipse class="globe-meridian" cx="400" cy="400" rx="320" ry="90"/>
                <ellipse class="globe-meridian" cx="400" cy="400" rx="320" ry="190"/>
                <ellipse class="globe-meridian" cx="400" cy="400" rx="90" ry="320"/>
                <ellipse class="globe-meridian" cx="400" cy="400" rx="190" ry="320"/>
            </g>
            <!-- Globe central en or -->
            <circle class="gold-sphere" cx="400" cy="400" r="75"/>
            <!-- Points de connexion rayonnants -->
            <circle class="hub-dot" cx="400" cy="270" r="5"/>
            <circle class="hub-pulse" cx="400" cy="270" r="5"/>
            <circle class="hub-dot" cx="550" cy="330" r="4.5"/>
            <circle class="hub-pulse" cx="550" cy="330" r="4.5"/>
            <circle class="hub-dot" cx="500" cy="520" r="4.5"/>
            <circle class="hub-pulse" cx="500" cy="520" r="4.5"/>
            <circle class="hub-dot" cx="280" cy="370" r="4.5"/>
            <circle class="hub-pulse" cx="280" cy="370" r="4.5"/>
            <path class="arc-line" d="M400,400 Q400,335 400,270"/>
            <path class="arc-line" d="M400,400 Q475,365 550,330"/>
            <path class="arc-line" d="M400,400 Q450,460 500,520"/>
            <path class="arc-line" d="M400,400 Q340,385 280,370"/>
        </svg>
    </div>
    <div class="bg-particles"></div>

    <!-- Barre de Navigation & Modes dynamiques -->
    <header class="top-bar">
        <a href="/" class="brand">
            <span>SAMII OS · EMPIRE OG</span>
        </a>
        <div class="top-bar__right">
            <!-- Mode Switcher (Amazon / GitHub / Database) -->
            <div class="mode-switcher">
                <button class="mode-btn active" data-mode="amazon">Amazon</button>
                <button class="mode-btn" data-mode="github">GitHub</button>
                <button class="mode-btn" data-mode="database">Database</button>
            </div>
            <div class="lang-switch">
                <span data-lang="fr" class="active">FR</span>
