                'auth.grade1': '你将以此军衔入伍：', 'auth.grade2': '士兵', 'auth.grade3': '——每一步行动都让你更接近巅峰。',
                'auth.continue': '继续 →',
                'auth.field.password': '密码', 'auth.ph.password': '至少6个字符',
                'auth.theme.choose': '选择 SAMII 的世界',
                'auth.theme.strategiste': '🪖 策略家', 'auth.theme.sagesse': '🕊️ 智慧',
                'auth.theme.aventurier': '🧭 冒险家', 'auth.theme.lock1': '🔒 中士军衔',
                'auth.theme.gaming': '🎮 游戏', 'auth.theme.lock2': '🔒 中尉军衔',
                'auth.theme.note': '冒险家和游戏主题会随着你的军衔提升而解锁——可随时在你的空间中修改。',
                'auth.back': '← 返回', 'auth.ph.password_login': '你的密码', 'auth.forgot': '忘记密码？',
                'footer.quote': '© 2026 OG Technology',
                'msg.creating': '⏳ 正在创建账户...', 'msg.created_default': '✅ 账户创建成功！',
                'msg.error_default': '❌ 错误。', 'msg.error_network': '❌ 网络错误。',
                'msg.connecting': '⏳ 正在登录...', 'msg.connected': '✅ 登录成功！',
            },
        };

        let currentLang = localStorage.getItem('samii_lang') || 'fr';
        function t(key) { return (I18N[currentLang] && I18N[currentLang][key]) || I18N.fr[key] || key; }

        function applyLang(lang) {
            if (!I18N[lang]) lang = 'fr';
            currentLang = lang;
            localStorage.setItem('samii_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (I18N[lang][key] !== undefined) el.textContent = I18N[lang][key];
            });
            document.querySelectorAll('[data-i18n-ph]').forEach(el => {
                const key = el.getAttribute('data-i18n-ph');
                if (I18N[lang][key] !== undefined) el.placeholder = I18N[lang][key];
            });
            document.querySelectorAll('.lang-switch span').forEach(s => s.classList.toggle('active', s.dataset.lang === lang));

            const activeStep = document.querySelector('.form-step.active');
            if (activeStep) {
                const stepN = activeStep.dataset.step;
                document.getElementById('step-label').textContent = stepN === '2' ? t('auth.step2.label') : t('auth.step1.label');
            }
        }

        document.querySelectorAll('.lang-switch span').forEach(span => {
            span.addEventListener('click', () => applyLang(span.dataset.lang));
        });

        applyLang(currentLang);

        // ══ SAMII EN DIRECT ═══════════════════════════════════════════════
        // Le chat public du hero. L'historique reste côté navigateur (aucune
        // session, aucun compte) et est renvoyé tronqué à chaque appel — le
        // serveur ne lui fait pas confiance et le re-borne de son côté.
        (function samiiLive() {
            const form   = document.getElementById('samii-live-form');
            const input  = document.getElementById('samii-live-input');
            const thread = document.getElementById('samii-live-thread');
            const chips  = document.getElementById('samii-live-chips');
            if (!form || !input || !thread) return;

            let historique = [];
            let enCours = false;

            function ajouterMessage(texte, qui) {
                const div = document.createElement('div');
                div.className = 'samii-live__msg samii-live__msg--' + qui;
                div.textContent = texte;
                thread.appendChild(div);
                thread.scrollTop = thread.scrollHeight;
                return div;
            }

            function afficherFrappe() {
                const div = document.createElement('div');
                div.className = 'samii-live__msg samii-live__msg--bot samii-live__msg--typing';
                div.innerHTML = '<span></span><span></span><span></span>';
                thread.appendChild(div);
                thread.scrollTop = thread.scrollHeight;
                return div;
            }

            async function envoyer(texte) {
                const message = (texte || '').trim();
                if (!message || enCours) return;

                enCours = true;
                input.value = '';
                form.querySelector('button').disabled = true;
                if (chips) chips.style.display = 'none';

                ajouterMessage(message, 'me');
                const frappe = afficherFrappe();

                try {
                    const res = await fetch('/vitrine/chat', {
                        method : 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body   : JSON.stringify({ message, langue: currentLang, historique }),
                    });
                    const data = await res.json();
                    frappe.remove();

                    const reponse = data.reply || t('live.error');
                    ajouterMessage(reponse, 'bot');

                    // On ne garde que les 6 derniers tours côté navigateur :
                    // au-delà, c'est du contexte payé pour rien à chaque appel.
                    historique.push({ role: 'user', message });
                    historique.push({ role: 'model', message: reponse });
                    historique = historique.slice(-6);
                } catch (err) {
                    frappe.remove();
                    ajouterMessage(t('live.error'), 'bot');
                } finally {
                    enCours = false;
                    form.querySelector('button').disabled = false;
                    input.focus();
                }
            }

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                envoyer(input.value);
            });

            if (chips) {
                chips.addEventListener('click', (e) => {
                    const chip = e.target.closest('.samii-live__chip');
                    if (chip) envoyer(chip.textContent);
                });
            }
        })();

        document.querySelectorAll('.auth-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                const target = tab.dataset.tab;
                document.getElementById('form-register').style.display = target === 'register' ? 'block' : 'none';
                document.getElementById('form-login').style.display = target === 'login' ? 'block' : 'none';
                document.getElementById('form-partenariat').style.display = target === 'partenariat' ? 'block' : 'none';
                document.getElementById('auth-msg').textContent = '';
            });
        });

        document.querySelectorAll('input[name="partner_categorie"]').forEach(radio => {
            radio.addEventListener('change', () => {
                document.getElementById('partner-details').style.display = 'block';
            });
        });

        // Bouton "Ouvrir mon QG Agence" de la section Agences : ouvre le
        // formulaire d'inscription avec le type "Agence" déjà coché. Une
        // agence qui clique doit pouvoir s'inscrire tout de suite, pas
        // re-chercher où se déclarer.
        const btnAgency = document.getElementById('btn-agency');
        if (btnAgency) {
            btnAgency.addEventListener('click', () => {
                document.querySelector('.auth-tab[data-tab="register"]')?.click();
                const radioAgence = document.querySelector('input[name="type_compte"][value="agence"]');
                if (radioAgence) {
                    radioAgence.checked = true;
                    radioAgence.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });
        }

        document.getElementById('btn-partner-submit').addEventListener('click', async () => {
            const msg = document.getElementById('partner-msg');
            const categorie = document.querySelector('input[name="partner_categorie"]:checked')?.value;
            const email = document.getElementById('partner-email').value.trim();
            const telephone = document.getElementById('partner-telephone').value.trim();
            const description = document.getElementById('partner-description').value.trim();

            if (!categorie || !email || !description) {
                msg.textContent = t('msg.error_default');
                msg.className = 'auth-msg';
                return;
            }

            const btn = document.getElementById('btn-partner-submit');
            btn.disabled = true;
            msg.textContent = t('msg.creating');
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/partenariat', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ categorie, email, telephone, description }),
                });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = t('partenariat.sent');
                    msg.className = 'auth-msg ok';
                    document.getElementById('partner-email').value = '';
                    document.getElementById('partner-telephone').value = '';
                    document.getElementById('partner-description').value = '';
                    document.querySelectorAll('input[name="partner_categorie"]').forEach(r => r.checked = false);
                    document.getElementById('partner-details').style.display = 'none';
                    btn.disabled = false;
                } else {
                    msg.textContent = json.error || t('msg.error_default');
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = t('msg.error_network');
                btn.disabled = false;
            }
        });

        document.getElementById('select-pays').addEventListener('change', function () {
            document.getElementById('champ-autre-pays').style.display = this.value === 'autre' ? 'block' : 'none';
        });

        function goToStep(n) {
            document.querySelectorAll('.form-step').forEach(s => s.classList.remove('active'));
            document.querySelector('.form-step[data-step="' + n + '"]').classList.add('active');
            document.querySelectorAll('.step-dot').forEach(d => d.classList.toggle('done', parseInt(d.dataset.stepDot, 10) <= n));
            document.getElementById('step-label').textContent = n === 2 ? t('auth.step2.label') : t('auth.step1.label');
        }
        document.getElementById('btn-step1-next').addEventListener('click', () => {
            const form = document.getElementById('form-register');
            const requiredFields = form.querySelectorAll('.form-step[data-step="1"] [required]');
            for (const field of requiredFields) { if (!field.value) { field.reportValidity(); return; } }
            goToStep(2);
        });
        document.getElementById('btn-step2-back').addEventListener('click', () => goToStep(1));

        // Note "Agence" : affichée seulement quand ce type est choisi, pour
        // annoncer la validation avant l'inscription et pas après.
        document.querySelectorAll('input[name="type_compte"]').forEach(radio => {
            radio.addEventListener('change', () => {
                const note = document.getElementById('type-note-agence');
                if (note) note.style.display = radio.value === 'agence' && radio.checked ? 'block' : 'none';
            });
        });

        document.getElementById('form-register').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('auth-msg');
            const btn = e.target.querySelector('button[type="submit"]');
            const data = Object.fromEntries(new FormData(e.target));
            if (data.pays === 'autre' && data.pays_autre) { data.pays = data.pays_autre; }
            delete data.pays_autre;

            btn.disabled = true;
            msg.textContent = t('msg.creating');
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = json.message || t('msg.created_default');
                    msg.className = 'auth-msg ok';
                    if (json.redirect) setTimeout(() => window.location.href = json.redirect, 1200);
                } else {
                    msg.textContent = json.error || t('msg.error_default');
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = t('msg.error_network');
                btn.disabled = false;
            }
        });

        document.getElementById('form-login').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('auth-msg');
            const btn = e.target.querySelector('button');
            const data = Object.fromEntries(new FormData(e.target));

            btn.disabled = true;
            msg.textContent = t('msg.connecting');
            msg.className = 'auth-msg';

            try {
                const res = await fetch('/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                const json = await res.json();
                if (json.success) {
                    msg.textContent = t('msg.connected');
                    msg.className = 'auth-msg ok';
                    window.location.href = json.redirect || '/';
                } else {
                    msg.textContent = json.error || t('msg.error_default');
                    btn.disabled = false;
                }
            } catch (err) {
                msg.textContent = t('msg.error_network');
                btn.disabled = false;
            }
        });
    </script>
    <script src="/js/pwa-register.js"></script>
</body>
</html>
