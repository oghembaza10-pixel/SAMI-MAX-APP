<!DOCTYPE html>
<html lang="fr">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>OG</title>

<link rel="stylesheet" href="/css/index-style.css">

</head>

<body class="entry-body">

<div class="language-switcher">

<button data-lang="fr" class="active">FR</button>
<button data-lang="en">EN</button>
<button data-lang="ar">العربية</button>

</div>

<img
src="/Gemini_Generated_Image_c7gbzec7gbzec7gb.png"
class="main-insigne"
alt="OG">

<p class="entry-quote" id="entryQuote">

Du soldat au général.

</p>

<p class="entry-sub" id="entrySub">

Le jeu commence ici.

</p>

<a href="/hub" class="btn-rejoindre" id="joinBtn">

REJOINDRE MON QG

</a>

<script>

const traduction={

fr:{
join:"REJOINDRE MON QG",
quote:"Du soldat au général.",
sub:"Le jeu commence ici."
},

en:{
join:"JOIN MY HQ",
quote:"From Soldier to General.",
sub:"The game starts here."
},

ar:{
join:"انضم إلى مقري",
quote:"من الجندي إلى الجنرال",
sub:"هنا تبدأ اللعبة."
}

};

document.querySelectorAll(".language-switcher button").forEach(btn=>{

btn.onclick=()=>{

document.querySelectorAll(".language-switcher button")
.forEach(b=>b.classList.remove("active"));

btn.classList.add("active");

document.documentElement.lang=btn.dataset.lang;

document.getElementById("joinBtn").textContent=
traduction[btn.dataset.lang].join;

document.getElementById("entryQuote").textContent=
traduction[btn.dataset.lang].quote;

document.getElementById("entrySub").textContent=
traduction[btn.dataset.lang].sub;

};

});

</script>

</body>

</html>
