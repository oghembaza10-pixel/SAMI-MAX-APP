<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Shopify connecté — OG Technology</title>
  <link rel="stylesheet" href="/css/hub-premium.css">
</head>
<body>
<div class="og-capital">
  <%- include("../partials/sidebar") %>
  <main class="capitol-content" style="display:flex;align-items:center;justify-content:center;min-height:100vh;">
    <div style="background:#111;border:1px solid #222;border-radius:16px;padding:40px;max-width:440px;width:100%;">

      <div style="text-align:center;margin-bottom:30px;">
        <div style="font-size:3rem;">🛍️</div>
        <h2 style="color:#fff;margin-top:10px;">Shopify</h2>
        <span style="background:#00ff8822;color:#00ff88;padding:4px 12px;border-radius:20px;font-size:0.8rem;font-weight:600;">✅ Connecté</span>
      </div>

      <div style="border-top:1px solid #1a1a1a;padding-top:20px;">
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #1a1a1a;">
          <span style="color:#666;font-size:0.85rem;">Boutique</span>
          <span style="color:#fff;font-size:0.85rem;font-weight:500;"><%= nomBoutique %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #1a1a1a;">
          <span style="color:#666;font-size:0.85rem;">Domaine</span>
          <span style="color:#fff;font-size:0.85rem;font-weight:500;"><%= shop %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #1a1a1a;">
          <span style="color:#666;font-size:0.85rem;">Connecté le</span>
          <span style="color:#fff;font-size:0.85rem;font-weight:500;"><%= dateConnexion %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;">
          <span style="color:#666;font-size:0.85rem;">Webhooks</span>
          <span style="color:<%= webhooksActifs ? '#00ff88' : '#ff4444' %>;font-size:0.85rem;font-weight:500;">
            <%= webhooksActifs ? '6 actifs ✅' : 'Inactifs ❌' %>
          </span>
        </div>
      </div>

      <a href="/hub?shop=<%= shop %>"
        style="display:block;margin-top:24px;text-align:center;padding:13px;background:#1a1a1a;border-radius:10px;color:#fff;text-decoration:none;font-weight:600;font-size:0.9rem;">
        ← Retour au Hub
      </a>
    </div>
  </main>
</div>
<script src="https://unpkg.com/lucide@latest"></script>
<script>lucide.createIcons();</script>
</body>
</html>
