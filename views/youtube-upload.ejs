<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Uploader une vidéo YouTube — OG Technology</title>
  <link rel="stylesheet" href="/css/hub-premium.css">
</head>
<body>
<div class="og-capital">
  <%- include("partials/sidebar") %>
  <main class="capitol-content" style="display:flex;align-items:center;justify-content:center;min-height:100vh;">
    <div style="background:#111;border:1px solid #222;border-radius:16px;padding:40px;max-width:440px;width:100%;">

      <div style="text-align:center;margin-bottom:30px;">
        <div style="font-size:3rem;"><i data-lucide="youtube" style="width:48px;height:48px;color:#FF0000;"></i></div>
        <h2 style="color:#fff;margin-top:10px;">Uploader une vidéo</h2>
        <p style="color:#666;font-size:0.85rem;margin-top:6px;">Publiée directement sur ta chaîne YouTube connectée.</p>
      </div>

      <% if (!connected) { %>
        <p style="color:#e55;font-size:0.85rem;margin-bottom:18px;text-align:center;">
          Connecte d'abord Google (Paramètres → Connecter tes outils → Google) avant d'uploader une vidéo.
        </p>
        <a href="/connect/tools" style="display:block;text-align:center;padding:13px;background:#4285F4;border-radius:10px;color:#fff;text-decoration:none;font-weight:600;font-size:0.9rem;">
          Connecter Google →
        </a>
      <% } else if (success) { %>
        <p style="color:#4CAF50;font-size:0.9rem;margin-bottom:18px;text-align:center;">
          ✅ Vidéo publiée avec succès.
        </p>
        <a href="<%= link %>" target="_blank" style="display:block;text-align:center;padding:13px;background:#FF0000;border-radius:10px;color:#fff;text-decoration:none;font-weight:600;font-size:0.9rem;margin-bottom:10px;">
          Voir sur YouTube →
        </a>
      <% } else { %>
        <% if (error) { %>
          <p style="color:#e55;font-size:0.85rem;margin-bottom:14px;text-align:center;"><%= error %></p>
        <% } %>
        <form method="POST" action="/youtube/upload" enctype="multipart/form-data">
          <label style="display:block;color:#999;font-size:0.75rem;margin-bottom:6px;">Titre</label>
          <input type="text" name="titre" required
                 style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid #222;background:#000;color:#fff;font-size:0.88rem;margin-bottom:16px;">

          <label style="display:block;color:#999;font-size:0.75rem;margin-bottom:6px;">Description (optionnel)</label>
          <textarea name="description" rows="3"
                    style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid #222;background:#000;color:#fff;font-size:0.88rem;margin-bottom:16px;resize:vertical;"></textarea>

          <label style="display:block;color:#999;font-size:0.75rem;margin-bottom:6px;">Fichier vidéo (max 50 Mo)</label>
          <input type="file" name="video" accept="video/*" required
                 style="width:100%;padding:11px 0;color:#fff;font-size:0.85rem;margin-bottom:20px;">

          <button type="submit"
                  style="display:block;width:100%;padding:13px;background:#FF0000;border:none;border-radius:10px;color:#fff;font-weight:700;font-size:0.95rem;cursor:pointer;">
            Publier sur YouTube
          </button>
        </form>
      <% } %>

      <a href="/connect/tools"
         style="display:block;margin-top:20px;text-align:center;padding:13px;background:#1a1a1a;border-radius:10px;color:#fff;text-decoration:none;font-weight:600;font-size:0.9rem;">
        ← Retour à mes outils
      </a>

    </div>
  </main>
</div>
<script src="/js/i18n.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<script>lucide.createIcons();</script>
</body>
</html>
