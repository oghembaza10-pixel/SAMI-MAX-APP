<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API & Webhooks · <%= nomAgence %></title>
    <meta name="theme-color" content="#05070c">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%# Même feuille que la tour de contrôle, pour hériter du système de
        couleurs et du mode clair/sombre. La mise en page reste celle de
        l'agence : dense, tabulaire, chiffres en monospace. %>
    <link rel="stylesheet" href="/css/qg-style.css?v=8">
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; padding: 26px 18px 80px;
            background: var(--bg-deep); color: var(--text-main);
            font-family: var(--font-body); -webkit-font-smoothing: antialiased;
        }
        .ap { max-width: 940px; margin: 0 auto; }

        .ap-retour {
            display: inline-flex; align-items: center; gap: 7px;
            color: var(--text-muted); font-size: .78rem; text-decoration: none; margin-bottom: 20px;
        }
        .ap-retour:hover { color: var(--gold-og); }
        .ap-retour i { width: 14px; height: 14px; }

        .ap-haut { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
        .ap-mode {
            background: var(--bg-panel); border: var(--border-soft); color: var(--text-muted);
            width: 36px; height: 36px; border-radius: 50%; cursor: pointer; padding: 0;
            display: flex; align-items: center; justify-content: center; font-size: .95rem;
            flex-shrink: 0; margin-bottom: 20px;
        }
        .ap-mode:hover { color: var(--gold-og); border-color: var(--gold-og); filter: none; }
        .ap-ico-clair { display: none; }
        body[data-mode="light"] .ap-ico-sombre { display: none; }
        body[data-mode="light"] .ap-ico-clair { display: inline; }

        .ap-tete { border-bottom: var(--border-soft); padding-bottom: 20px; margin-bottom: 26px; }
        .ap-tete h1 { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: -.4px; }
        .ap-tete p { margin: 7px 0 0; color: var(--text-muted); font-size: .84rem; max-width: 620px; line-height: 1.6; }
        .ap-tete a { color: var(--gold-og); }

        .ap-bloc {
            background: var(--bg-panel); border: var(--border-soft); border-radius: 14px;
            padding: 20px; margin-bottom: 18px;
        }
        .ap-bloc h2 { margin: 0 0 4px; font-size: .95rem; font-weight: 700; }
        .ap-bloc .ap-aide { color: var(--text-muted); font-size: .78rem; margin: 0 0 16px; line-height: 1.6; }

        table { width: 100%; border-collapse: collapse; font-size: .8rem; }
        th {
            text-align: left; color: var(--text-muted); font-size: .66rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .8px; padding-bottom: 9px;
        }
        td { padding: 10px 10px 10px 0; border-top: var(--border-soft); vertical-align: middle; }
        .mono { font-family: 'JetBrains Mono', monospace; font-size: .74rem; }
        .ap-vide { color: var(--text-muted); font-size: .8rem; font-style: italic; padding: 12px 0; }

        input[type=text], input[type=url] {
            background: var(--bg-deep); border: var(--border-soft); color: var(--text-main);
            border-radius: 9px; padding: 11px 13px; font-size: .83rem; width: 100%; font-family: inherit;
        }
        input:focus { outline: none; border-color: var(--gold-og); }
        .ap-ligne { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
        .ap-ligne > input { flex: 1 1 240px; }

        button {
            background: var(--gold-og); color: #0A0A0A; border: none; border-radius: 9px;
            padding: 11px 20px; font-weight: 700; font-size: .8rem; cursor: pointer;
            font-family: inherit; white-space: nowrap;
        }
        button:hover { filter: brightness(1.12); }
        button.ap-mini {
            background: none; border: var(--border-soft); color: var(--text-muted);
            padding: 5px 11px; font-size: .71rem; font-weight: 500;
        }
        button.ap-mini:hover { border-color: #b34a3a; color: #e5533d; filter: none; }

        .ap-cases { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
        .ap-cases label {
            display: flex; align-items: center; gap: 6px; background: var(--bg-deep);
            border: var(--border-soft); border-radius: 8px; padding: 7px 11px;
            font-size: .72rem; color: var(--text-soft); cursor: pointer;
            font-family: 'JetBrains Mono', monospace;
        }
        .ap-cases input { accent-color: var(--gold-og); }

        .ap-nouvelle {
            display: none; margin-top: 16px; background: var(--bg-deep);
            border: 1px solid var(--gold-og); border-radius: 12px; padding: 16px;
        }
        .ap-nouvelle strong { color: var(--gold-og); font-size: .8rem; display: block; margin-bottom: 8px; }
        .ap-nouvelle .ap-val {
            background: var(--bg-panel); border-radius: 8px; padding: 12px; word-break: break-all;
            font-family: 'JetBrains Mono', monospace; font-size: .77rem;
        }
        .ap-nouvelle p { color: var(--text-muted); font-size: .73rem; margin: 10px 0 0; }

        pre {
            background: var(--bg-deep); border: var(--border-soft); border-radius: 10px;
            padding: 14px; overflow-x: auto; margin: 12px 0 0;
            font-family: 'JetBrains Mono', monospace; font-size: .73rem; line-height: 1.75;
            color: var(--text-soft);
        }
        code {
            font-family: 'JetBrains Mono', monospace; font-size: .82em;
            background: var(--bg-deep); border-radius: 5px; padding: 1.5px 6px; color: var(--gold-og);
        }
        pre code { background: none; padding: 0; color: inherit; font-size: 1em; }

        .ap-etat { font-size: .66rem; padding: 2px 9px; border-radius: 20px; font-weight: 600; }
        .ap-etat--on  { background: rgba(46,160,67,.15); color: #4CC76A; }
        .ap-etat--off { background: rgba(180,60,60,.15); color: #e5533d; }

        @media (max-width: 640px) {
            th:nth-child(3), td:nth-child(3) { display: none; }
        }

        /* ── ARABE (RTL) ─────────────────────────────────────────────
           La page se lit de droite à gauche : les tableaux alignent leurs
           cellules à droite, et la flèche de retour se retourne — sinon elle
           pointe vers l'avant du texte, c'est-à-dire vers l'inverse de ce
           qu'elle promet. Les colonnes `mono` (clés, identifiants, URLs)
           restent en LTR : un identifiant `WS-…` inversé est illisible. */
        [dir="rtl"] th, [dir="rtl"] td { text-align: right; }
        [dir="rtl"] .mono, [dir="rtl"] code, [dir="rtl"] pre { direction: ltr; text-align: left; unicode-bidi: embed; }
        /* …sauf ce qui est traduit. Une cellule `mono` contient tantôt un
           identifiant (`sk_samii_ab…`, `WS-…`), tantôt un mot du dictionnaire
           quand la valeur est absente — « jamais », « manque ». Le premier doit
           rester latin ; le second est de l'arabe, et l'arabe ne survit pas à
           une police à chasse fixe : JetBrains Mono n'a pas de glyphes arabes,
           chaque lettre tombait dans une police de secours différente et
           perdait sa liaison — « أبداً » s'affichait « أ بد أ ». C'est la
           police qu'il faut rendre, pas seulement le sens de lecture.
           Vu en capture, deux fois. */
        [dir="rtl"] .mono [data-i18n] {
            direction: rtl; text-align: right; unicode-bidi: isolate;
            font-family: var(--font-body, "Inter", system-ui, sans-serif);
        }
        [dir="rtl"] .ap-retour i { transform: scaleX(-1); }
    </style>
</head>
<body>
<div class="ap">
    <div class="ap-haut">
        <a href="/agence" class="ap-retour"><i data-lucide="arrow-left"></i> <span data-i18n="nav.retour.agence">Tour de contrôle</span></a>
        <%# Deux icônes dans le DOM, permutées par CSS selon data-mode :
            rien à réinjecter en JavaScript. %>
        <button type="button" class="ap-mode" id="ap-mode" title="Changer de mode" data-i18n-title="agence.btn.mode">
            <span class="ap-ico-sombre">☾</span><span class="ap-ico-clair">☀</span>
        </button>
    </div>

    <div class="ap-tete">
        <h1 data-i18n="agence.nav.api">API &amp; Webhooks</h1>
        <p>
            <span data-i18n="api.intro.1">Une seule clé pour tout ton portefeuille : tu branches ton n8n une fois, il pilote les</span>
            <%= espaces.length %> <span data-i18n="<%= espaces.length > 1 ? 'api.mot.espaces' : 'api.mot.espace' %>"><%= espaces.length > 1 ? "espaces" : "espace" %></span>
            <span data-i18n="api.intro.2">de tes clients. Pas un flux à reconstruire par boutique.</span>
            <a href="/api-docs" target="_blank" rel="noopener" data-i18n="api.doc">Documentation complète →</a>
        </p>
    </div>

    <!-- ── CLÉS ────────────────────────────────────────────────── -->
    <div class="ap-bloc">
        <h2 data-i18n="api.cles.titre">Clés d'agence</h2>
        <p class="ap-aide">
            <span data-i18n="api.cles.aide">Une clé s'affiche une seule fois, à sa création : nous n'en gardons qu'une empreinte, jamais la clé elle-même. Elle donne accès aux espaces de ton portefeuille — et à eux seuls. Un client qui te quitte sort automatiquement du périmètre, sans rien à révoquer.</span>
        </p>

        <table>
            <thead><tr><th data-i18n="api.th.nom">Nom</th><th data-i18n="api.th.cle">Clé</th><th data-i18n="api.th.permissions">Permissions</th><th data-i18n="api.th.dernierUsage">Dernier usage</th><th data-i18n="api.th.etat">État</th><th></th></tr></thead>
            <tbody>
            <% if (!cles.length) { %>
                <tr><td colspan="6" class="ap-vide" data-i18n="api.vide.cles">Aucune clé pour l'instant.</td></tr>
            <% } %>
            <% cles.forEach(c => { %>
                <tr>
                    <td><%= c.nom %></td>
                    <td class="mono"><%= c.cle_prefixe %>…</td>
                    <%# Portées absentes = clé créée avant les permissions : accès complet. %>
                    <td class="mono" style="font-size:.66rem">
                        <% if (c.portees && c.portees.length) { %><%= c.portees.join(", ") %><% } else { %><span data-i18n="api.cle.complete">accès complet (clé historique)</span><% } %>
                    </td>
                    <td class="mono"><% if (c.derniere_utilisation) { %><%= new Date(c.derniere_utilisation).toLocaleString('fr-FR') %><% } else { %><span data-i18n="api.mot.jamais">jamais</span><% } %></td>
                    <td><span class="ap-etat <%= c.actif ? 'ap-etat--on' : 'ap-etat--off' %>" data-i18n="<%= c.actif ? 'api.etat.active' : 'api.etat.revoquee' %>"><%= c.actif ? "active" : "révoquée" %></span></td>
                    <td><% if (c.actif) { %><button class="ap-mini" data-revoquer="<%= c.id %>" data-i18n="api.btn.revoquer">Révoquer</button><% } %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>

        <p class="ap-aide" style="margin:20px 0 0">
            <span data-i18n="api.portees.aide">Ce que cette clé aura le droit de faire, chez chacun de tes clients. Ne coche que le nécessaire : c'est aussi ce que tu pourras montrer à un client qui te demande ce que ton automatisation touche chez lui.</span>
        </p>
        <div class="ap-cases">
            <% domaines.forEach(d => { %>
                <% d.portees.forEach(p => { %>
                    <label title="<%= p.label %>">
                        <input type="checkbox" class="ap-portee" value="<%= p.id %>"
                               <%= p.niveau === "lire" ? "checked" : "" %>>
                        <%= p.id %>
                    </label>
                <% }) %>
            <% }) %>
        </div>

        <div class="ap-ligne">
            <input type="text" id="ap-nom-cle" placeholder="Nom de la clé (ex : n8n production)" data-i18n-placeholder="api.ph.nomCle">
            <button id="ap-creer-cle" data-i18n="api.btn.creerCle">Créer une clé</button>
        </div>

        <div class="ap-nouvelle" id="ap-nouvelle">
            <strong data-i18n="api.cle.nouvelle">Voici ta clé — copie-la maintenant</strong>
            <div class="ap-val" id="ap-valeur-cle"></div>
            <p data-i18n="api.cle.avertissement">Elle ne sera plus jamais affichée. Traite-la comme un mot de passe.</p>
        </div>
    </div>

    <!-- ── WEBHOOKS ────────────────────────────────────────────── -->
    <div class="ap-bloc">
        <h2 data-i18n="api.webhooks.titre">Webhooks — tout le portefeuille sur une URL</h2>
        <p class="ap-aide">
            <span data-i18n="api.webhooks.aide">SAMII appelle ton URL dès qu'un événement se produit chez n'importe lequel de tes clients, quel que soit le canal d'origine : WhatsApp, Telegram, Shopify, le QG ou l'API. Le bloc « espace » du corps envoyé, et l'en-tête X-SAMII-Espace, te disent duquel il s'agit. Chaque appel est signé — X-SAMII-Signature: sha256=… , HMAC du corps brut avec le secret affiché à la création.</span>
        </p>

        <table>
            <thead><tr><th>URL</th><th data-i18n="api.th.evenements">Événements</th><th data-i18n="api.th.dernierCode">Dernier code</th><th data-i18n="api.th.etat">État</th><th></th></tr></thead>
            <tbody>
            <% if (!webhooks.length) { %>
                <tr><td colspan="5" class="ap-vide" data-i18n="api.vide.webhooks">Aucun webhook enregistré.</td></tr>
            <% } %>
            <% webhooks.forEach(w => { %>
                <tr>
                    <td class="mono" style="word-break:break-all"><%= w.url %></td>
                    <td class="mono" style="font-size:.68rem"><%= (w.evenements || []).join(", ") %></td>
                    <td class="mono"><%= w.dernier_statut || "—" %></td>
                    <td><span class="ap-etat <%= w.actif ? 'ap-etat--on' : 'ap-etat--off' %>" data-i18n="<%= w.actif ? 'api.etat.actif' : 'api.etat.desactive' %>"><%= w.actif ? "actif" : "désactivé" %></span></td>
                    <td><button class="ap-mini" data-suppr-webhook="<%= w.id %>" data-i18n="api.btn.supprimer">Supprimer</button></td>
                </tr>
            <% }) %>
            </tbody>
        </table>

        <div class="ap-ligne">
            <input type="url" id="ap-url-webhook" placeholder="https://ton-n8n.com/webhook/samii">
        </div>
        <div class="ap-cases">
            <% evenements.forEach(e => { %>
                <label><input type="checkbox" class="ap-ev" value="<%= e %>" checked> <%= e %></label>
            <% }) %>
        </div>
        <div class="ap-ligne"><button id="ap-creer-webhook" data-i18n="api.btn.creerWebhook">Enregistrer le webhook</button></div>
    </div>

    <!-- ── PORTEFEUILLE ────────────────────────────────────────── -->
    <div class="ap-bloc">
        <h2 data-i18n="api.espaces.titre">Identifiants de tes espaces</h2>
        <p class="ap-aide">
            <span data-i18n="api.espaces.aide">C'est la valeur à mettre dans l'en-tête X-SAMII-Espace pour cibler un client. GET /api/v1/espaces renvoie exactement cette liste, si tu préfères la lire depuis ton automatisation plutôt que la recopier.</span>
        </p>
        <table>
            <thead><tr><th data-i18n="agence.table.client">Client</th><th data-i18n="api.th.idEspace">Identifiant d'espace</th><th data-i18n="agence.form.metier">Métier</th><th data-i18n="api.th.parcours">Parcours</th></tr></thead>
            <tbody>
            <% if (!espaces.length) { %>
                <tr><td colspan="4" class="ap-vide" data-i18n="api.vide.espaces">Aucun client dans ton portefeuille pour l'instant.</td></tr>
            <% } %>
            <% espaces.forEach(e => { %>
                <tr>
                    <td><%= e.nom %></td>
                    <td class="mono" style="word-break:break-all"><%= e.id %></td>
                    <td><%= e.metierLabel %></td>
                    <td class="mono"><%= e.parcours %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>

    <!-- ── JOURNAL D'ACCÈS ─────────────────────────────────────── -->
    <div class="ap-bloc">
        <h2 data-i18n="api.journal.titre">Ce que tes clés ont fait</h2>
        <p class="ap-aide">
            <span data-i18n="api.journal.aide">Les quinze derniers appels de tes clés, tous clients confondus. C'est la contrepartie des permissions — et la réponse toute prête au client qui demande ce que ton automatisation touche chez lui. Un appel refusé apparaît en rouge, avec la permission manquante.</span>
        </p>
        <table>
            <thead><tr><th data-i18n="api.th.quand">Quand</th><th data-i18n="agence.table.client">Client</th><th data-i18n="api.th.appel">Appel</th><th data-i18n="api.th.reponse">Réponse</th></tr></thead>
            <tbody>
            <% if (!acces || !acces.length) { %>
                <tr><td colspan="4" class="ap-vide" data-i18n="api.vide.journal">Aucun appel pour l'instant.</td></tr>
            <% } %>
            <% (acces || []).forEach(a => { %>
                <tr>
                    <td class="mono"><%= new Date(a.created_at).toLocaleString('fr-FR') %></td>
                    <td><%= a.espace_nom || "—" %></td>
                    <td class="mono" style="font-size:.68rem"><%= a.methode %> <%= a.chemin %></td>
                    <td class="mono">
                        <span class="ap-etat <%= a.refusee ? 'ap-etat--off' : 'ap-etat--on' %>"><%= a.statut %></span>
                        <% if (a.refusee && a.portee) { %>
                            <span style="font-size:.64rem;color:var(--text-muted)"> <span data-i18n="api.mot.manque">manque</span> <%= a.portee %></span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>

    <!-- ── DÉMARRAGE ───────────────────────────────────────────── -->
    <div class="ap-bloc">
        <h2 data-i18n="api.demarrage.titre">Démarrage</h2>
        <p class="ap-aide" data-i18n="api.demarrage.aide">Deux appels pour tout comprendre : la liste de tes clients, puis les commandes de l'un d'eux.</p>
<pre><code># 1. tes espaces
curl <%= baseUrl %>/api/v1/espaces \
  -H "Authorization: Bearer sk_samii_…"

# 2. les commandes d'un client
curl <%= baseUrl %>/api/v1/commandes \
  -H "Authorization: Bearer sk_samii_…" \
  -H "X-SAMII-Espace: WS-…"</code></pre>
        <p class="ap-aide" style="margin:16px 0 0">
            <span data-i18n="api.n8n">Dans n8n : nœud HTTP Request, authentification Header Auth (Authorization = Bearer sk_samii_…), et un second en-tête X-SAMII-Espace alimenté par la boucle sur tes clients. Aucun nœud communautaire, aucun SDK à installer.</span>
        </p>
    </div>
</div>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<script>
if (window.lucide) lucide.createIcons();

// Traduction des textes produits par ce script (alertes, confirmations) :
// aucun data-i18n ne peut les atteindre. Repli sur le français si la clé
// manque ou si le dictionnaire n'est pas encore chargé.
const apT = (cle, repli) => (window.Language && Language.t ? Language.t(cle, repli) : repli);


// ── Mode clair / sombre — même préférence que la tour de contrôle ──
function apAppliquerMode(mode) {
    if (mode === "light") document.body.setAttribute("data-mode", "light");
    else document.body.removeAttribute("data-mode");
}
apAppliquerMode(localStorage.getItem("samii_mode") === "light" ? "light" : "dark");
document.getElementById("ap-mode").addEventListener("click", () => {
    const suivant = document.body.getAttribute("data-mode") === "light" ? "dark" : "light";
    localStorage.setItem("samii_mode", suivant);
    apAppliquerMode(suivant);
});

async function apPoster(url, corps) {
    const r = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(corps || {}),
    });
    return r.json();
}

document.getElementById("ap-creer-cle").addEventListener("click", async (e) => {
    e.target.disabled = true;
    const nom = document.getElementById("ap-nom-cle").value.trim() || apT("api.cle.nomDefaut", "Clé agence");
    const portees = [...document.querySelectorAll(".ap-portee:checked")].map(c => c.value);
    const rep = await apPoster("/agence/api/cles", { nom, portees });
    if (rep.success) {
        document.getElementById("ap-valeur-cle").textContent = rep.cle;
        document.getElementById("ap-nouvelle").style.display = "block";
        // On ne recharge pas la page : ça effacerait la clé, visible une seule fois.
    } else {
        alert(rep.error || apT("agence.msg.erreur", "Erreur."));
        e.target.disabled = false;
    }
});

document.querySelectorAll("[data-revoquer]").forEach(b => {
    b.addEventListener("click", async () => {
        if (!confirm(apT("api.msg.revoquer", "Révoquer cette clé ? Tout système qui l'utilise perdra l'accès immédiatement."))) return;
        const rep = await apPoster(`/agence/api/cles/${b.dataset.revoquer}/revoquer`);
        if (rep.success) location.reload(); else alert(apT("agence.msg.erreur", "Erreur."));
    });
});

document.getElementById("ap-creer-webhook").addEventListener("click", async () => {
    const url = document.getElementById("ap-url-webhook").value.trim();
    const evenements = [...document.querySelectorAll(".ap-ev:checked")].map(c => c.value);
    const rep = await apPoster("/agence/api/webhooks", { url, evenements });
    if (rep.success) {
        alert(apT("api.msg.webhookOk", "Webhook enregistré.\n\nSecret de signature (à garder) :") + "\n" + rep.webhook.secret);
        location.reload();
    } else {
        alert(rep.error || apT("agence.msg.erreur", "Erreur."));
    }
});

document.querySelectorAll("[data-suppr-webhook]").forEach(b => {
    b.addEventListener("click", async () => {
        if (!confirm(apT("api.msg.supprWebhook", "Supprimer ce webhook ?"))) return;
        const rep = await apPoster(`/agence/api/webhooks/${b.dataset.supprWebhook}/supprimer`);
        if (rep.success) location.reload(); else alert(apT("agence.msg.erreur", "Erreur."));
    });
});
</script>

<%- include("partials/barre-langue") %>
</body>
</html>
