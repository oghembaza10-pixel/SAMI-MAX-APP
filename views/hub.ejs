<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OG • HUB</title>

    <link rel="stylesheet" href="/css/hub.css">

</head>

<body>

<div class="app">

    <!-- ===================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================== -->

    <aside class="sidebar">

        <div class="logo">

            <h2>OG</h2>

        </div>

        <nav class="menu">

            <a href="/hub" class="active">Hub</a>

            <a href="/profile">Profil</a>

            <a href="/academy">Académie</a>

            <a href="/marketplace">Marketplace</a>

            <a href="/settings">Paramètres</a>

        </nav>

    </aside>

    <!-- ===================================== -->
    <!-- CONTENU -->
    <!-- ===================================== -->

    <main class="content">

        <header class="hero">

            <h1>Bienvenue au Centre Commercial des QG</h1>

            <p>
                Choisissez votre activité et lancez votre quartier général.
            </p>

        </header>

        <!-- =============================== -->
        <!-- SAMII -->
        <!-- =============================== -->

        <section class="samii-card">

            <div class="samii-left">

                <span class="badge">
                    IA OPÉRATIONNELLE
                </span>

                <h2>SAMII</h2>

                <p>

                    Connectez vos réseaux et pilotez votre activité.

                </p>

                <button>

                    GO →

                </button>

            </div>

            <div class="samii-right">

                <span>Meta</span>

                <span>WhatsApp</span>

                <span>Shopify</span>

                <span>LinkedIn</span>

                <span>TikTok</span>

            </div>

        </section>

        <!-- =============================== -->
        <!-- METIERS -->
        <!-- =============================== -->

        <section class="cards">

            <div class="card">Particulier</div>
            <div class="card">Entreprise</div>
            <div class="card">E-commerce</div>
            <div class="card">Restaurant</div>

            <div class="card">Garage</div>
            <div class="card">Immobilier</div>
            <div class="card">Hôtel</div>
            <div class="card">Location</div>

            <div class="card">Marketing</div>
            <div class="card">Comptable</div>
            <div class="card">Avocat</div>
            <div class="card">Salle de sport</div>

            <div class="card">Transport</div>
            <div class="card">Ferme</div>
            <div class="card">Formation</div>
            <div class="card">Pharmacie</div>

            <div class="card">Clinique</div>
            <div class="card">Studio</div>
            <div class="card">Import / Export</div>
            <div class="card">Lavage</div>

        </section>

        <!-- =============================== -->
        <!-- PLUS -->
        <!-- =============================== -->

        <section class="more-card">

            <h2>+ Plus de métiers</h2>

            <p>

                Découvrez tous les QG disponibles.

            </p>

        </section>

    </main>

</div>

</body>

</html>
