<!DOCTYPE html>
<html lang="fr">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>OG — Hub Central</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/hub-premium.css">
</head>

<body data-workspace="<%= workspaceId || '' %>">

<div class="og-capital">

<!-- ========================================================= -->
<!-- SIDEBAR LINER / APPLE STYLE -->
<!-- ========================================================= -->
<aside class="og-sidebar">
    <div class="sidebar-top">
        <a href="/hub" class="brand-sigil-link" title="OG Hub">
            <span class="sigil-letter">OG</span>
        </a>
    </div>

    <nav class="sidebar-nav">
        <a href="/hub" class="sidebar-item active" title="Hub Central">
            <i data-lucide="command"></i>
            <span>Hub</span>
        </a>
        <a href="/marketplace" class="sidebar-item" title="Marketplace">
            <i data-lucide="shopping-bag"></i>
            <span>Market</span>
        </a>
        <a href="/community" class="sidebar-item" title="Community">
            <i data-lucide="users"></i>
            <span>Community</span>
        </a>
        <a href="/academy" class="sidebar-item" title="Academy">
            <i data-lucide="graduation-cap"></i>
            <span>Academy</span>
        </a>
        <a href="/networks" class="sidebar-item" title="Réseaux">
            <i data-lucide="share-2"></i>
            <span>Réseaux</span>
        </a>
        <a href="/workspaces" class="sidebar-item" title="Mes QG">
            <i data-lucide="layers"></i>
            <span>QG</span>
        </a>
        <a href="/settings" class="sidebar-item" title="Paramètres">
            <i data-lucide="sliders"></i>
            <span>Config</span>
        </a>
    </nav>

    <div class="sidebar-bottom">
        <div class="tech-pulse-node" title="SAMII Core Active"></div>
    </div>
</aside>

<!-- ========================================================= -->
<!-- CONTENU PRINCIPAL -->
<!-- ========================================================= -->
<main class="og-main-content">

<% if(error){ %>
<div class="hub-error-banner"><%= error %></div>
<% } %>

<!-- ========================================================= -->
<!-- HERO : VILLE FUTURISTE IMMERSIVE -->
<!-- ========================================================= -->
<header class="og-hero">
    <div class="hero-city-viewport"></div>
    <div class="hero-tech-grid"></div>
    <div class="hero-ambient-glow glow-gold"></div>
    <div class="hero-ambient-glow glow-blue"></div>

    <div class="hero-inner">
        <div class="hero-tag">INFRASTRUCTURE MONDIALE</div>
        <h1>Tout commence ici.</h1>
        <p>Sélectionnez votre secteur ou pilotez votre empire technologique avec l'assistance de SAMII.</p>

        <!-- Barre de recherche interactive -->
        <div class="hero-search-wrapper">
            <button id="hubSearchButton" class="hero-search-trigger">
                <i data-lucide="search"></i>
                <span>Quel est votre métier ? Je configure votre QG...</span>
                <kbd>⌘K</kbd>
            </button>
        </div>

        <% if(hasWorkspace){ %>
        <div class="active-workspace-pill">
            <span>Dernier QG actif :</span>
            <% workspaces.forEach(function(workspace){ %>
                <% if(workspace.id === lastWorkspace){ %>
                <button class="pill-btn" data-workspace="<%= workspace.id %>">
                    <%= workspace.name %>
                </button>
                <% } %>
            <% }) %>
        </div>
        <% } %>
    </div>
</header>

<!-- ========================================================= -->
<!-- SECTION MÉTIERS / CARTES HAUT DE GAMME -->
<!-- ========================================================= -->
<section class="og-metiers-section">
    <div class="section-header">
        <h2>Secteurs d'activité</h2>
        <p>Déployez un écosystème sur-mesure instantanément.</p>
    </div>

    <div class="metier-grid" id="metier-grid">
        <% metiers.forEach(function(metier){ %>
        <div class="og-card" data-metier="<%= metier %>">
            <div class="card-glow-border"></div>
            <div class="card-content">
                <div class="card-icon-box">
                    <i data-lucide="cpu"></i>
                </div>
                <h3><%= metier %></h3>
                <p>Initialiser l'infrastructure</p>
            </div>
            <div class="card-arrow">
                <i data-lucide="arrow-right"></i>
            </div>
        </div>
        <% }) %>
    </div>
</section>

<!-- ========================================================= -->
<!-- FOOTER : EMPIRE MONDIAL (GLOBE FUTURISTE) -->
<!-- ========================================================= -->
<footer class="og-empire-footer">
    <div class="globe-viewport"></div>
    <div class="globe-overlay-gradient"></div>

    <div class="empire-content">
        <div class="empire-badge">GLOBAL NETWORK</div>
        <h2>Bâtir l'Empire OG à l'échelle mondiale.</h2>
        <p>Connectivité universelle, automatisation sans limites, souveraineté numérique.</p>
        <div class="empire-footer-bottom">
            <span>© 2026 OG Corporation. Tous droits réservés.</span>
            <div class="system-status-indicator">
                <span class="status-dot"></span>
                <span>Systems Operational</span>
            </div>
        </div>
    </div>
</footer>

</main>

</div>

<!-- ========================================================= -->
<!-- MODALE COMMANDE INTERACTIVE -->
<!-- ========================================================= -->
<div id="hubModal" class="og-modal">
    <div class="modal-backdrop"></div>
    <div class="modal-container">
        <button class="modal-close" id="closeHubModal">
            <i data-lucide="x"></i>
        </button>

        <!-- Étape Accueil -->
        <div id="hubStepHome" class="modal-step active">
            <h2>Command Center</h2>
            <p>Quel secteur souhaitez-vous structurer ?</p>
            
            <div class="modal-search-box">
                <i data-lucide="search"></i>
                <input id="metierInput" type="text" placeholder="Ex : Technologie, E-commerce, Conseil, Luxe...">
            </div>

            <div class="modal-actions-list">
                <button class="action-row" id="createQG">
                    <i data-lucide="plus-circle"></i>
                    <div>
                        <strong>Créer un nouveau QG</strong>
                        <span>Générer une architecture métier avec SAMII</span>
                    </div>
                </button>
                <button class="action-row" id="inviteCollaborator">
                    <i data-lucide="user-plus"></i>
                    <div>
                        <strong>Ajouter un collaborateur</strong>
                        <span>Inviter un partenaire dans votre réseau</span>
                    </div>
                </button>
                <button class="action-row" id="searchWorkspace">
                    <i data-lucide="layers"></i>
                    <div>
                        <strong>Rechercher un QG existant</strong>
                        <span>Accéder à un espace de travail actif</span>
                    </div>
                </button>
            </div>
        </div>

        <!-- Étape Création QG -->
        <div id="hubStepCreate" class="modal-step">
            <div class="samii-agent-head">
                <div class="samii-avatar-dot">OG</div>
                <div>
                    <h3>SAMII Intelligence</h3>
                    <p>Initialisation du QG en cours...</p>
                </div>
            </div>
            <form id="createWorkspaceForm" class="modal-form">
                <div class="input-group">
                    <label>Secteur / Métier</label>
                    <input id="workspaceMetier" type="text" required>
                </div>
                <div class="input-row">
                    <div class="input-group">
                        <label>Nom</label>
                        <input id="workspaceNom" type="text" required>
                    </div>
                    <div class="input-group">
                        <label>Prénom</label>
                        <input id="workspacePrenom" type="text" required>
                    </div>
                </div>
                <div class="input-group">
                    <label>Nom de l'entreprise</label>
                    <input id="workspaceEntreprise" type="text" required>
                </div>
                <button type="submit" class="og-primary-btn">Déployer l'infrastructure</button>
            </form>
        </div>

        <!-- Étape Collaborateur -->
        <div id="hubStepCollaborator" class="modal-step">
            <h2>Collaborateurs</h2>
            <p>Rechercher un membre par e-mail ou identifiant.</p>
            <input type="text" class="modal-text-input" placeholder="nom@domaine.com">
            <button class="og-primary-btn">Envoyer l'invitation</button>
        </div>

        <!-- Étape Recherche QG -->
        <div id="hubStepWorkspace" class="modal-step">
            <h2>Recherche QG</h2>
            <p>Entrez le nom de l'espace à cibler.</p>
            <input type="text" class="modal-text-input" placeholder="Nom de l'entreprise">
            <button class="og-primary-btn">Rechercher</button>
        </div>

        <!-- Étape Conseils SAMII -->
        <div id="hubStepAdvice" class="modal-step">
            <div class="samii-agent-head">
                <div class="samii-avatar-dot">OG</div>
                <div>
                    <h3>QG Opérationnel</h3>
                    <p>Recommandations stratégiques</p>
                </div>
            </div>
            <div id="samiiAdvice" class="samii-advice-box"></div>
            <button class="og-primary-btn">Accéder au QG</button>
        </div>
    </div>
</div>

<script>
window.OG_WORKSPACES = <%- JSON.stringify(workspaces || []) %>;
window.OG_WORKSPACE_ID = "<%= workspaceId || '' %>";
window.OG_ACTIONS = <%- JSON.stringify(actions || []) %>;
window.OG_METIERS = <%- JSON.stringify(metiers || []) %>;
window.OG_HAS_WORKSPACE = <%= hasWorkspace ? "true" : "false" %>;
window.OG_LAST_WORKSPACE = "<%= lastWorkspace || '' %>";
</script>

<script src="https://unpkg.com/lucide@latest"></script>
<script src="/js/i18n.js"></script>
<script src="/js/hub.js"></script>

</body>
</html>
