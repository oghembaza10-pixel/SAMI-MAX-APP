<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG • HUB</title>

    <link rel="stylesheet" href="/css/hub-style.css">
</head>

<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <h2>OG</h2>
            <span class="logo-subtitle">Du soldat au général</span>
        </div>

        <nav class="menu">
            <a href="/hub" class="active"><span>Hub</span></a>
            <a href="/profile"><span>Profil</span></a>
            <a href="/academy"><span>Académie</span></a>
            <a href="/marketplace"><span>Marketplace</span></a>
            <a href="/settings"><span>Paramètres</span></a>
            <a href="/contact"><span>Contact</span></a>
        </nav>

    </aside>

    <!-- CONTENU -->
    <main class="content">

        <!-- HERO SIMPLE -->
        <header class="hero">

            <h1>OG</h1>

            <p>
                Le jeu commence ici.<br>
                Choisissez votre premier QG.
            </p>

            <div class="language-switcher">
                <button data-lang="fr" class="active">FR</button>
                <button data-lang="en">EN</button>
                <button data-lang="ar">AR</button>
            </div>

        </header>

        <!-- QG GRID -->
        <section id="hub-grid" class="hub-grid"></section>

        <!-- CTA FINAL -->
        <section class="community-card">

            <h3>Votre métier n'existe pas ?</h3>

            <p>
                Construisons ensemble le réseau OG.
                Proposez un nouveau QG.
            </p>

            <button>
                Proposer un QG
            </button>

        </section>

    </main>

</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script src="/js/hub.js"></script>

</body>
</html>
