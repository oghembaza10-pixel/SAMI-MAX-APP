<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        /* --- STYLE INTEGRÉ (Pas de risque d'erreur de lien CSS) --- */
        body { background-color: #0A0A0A !important; color: #ffffff !important; font-family: sans-serif; margin: 0; padding: 40px; }
        
        .hub { max-width: 1200px; margin: auto; }

        /* Titre Doré */
        h1 { color: #C5A059 !important; font-size: 2.5rem; margin-bottom: 10px; }
        p { color: #888; }

        /* Grille */
        .hub-masonry {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)) !important;
            gap: 20px !important;
            margin-top: 40px !important;
        }

        /* Carte */
        .card {
            background: #111111 !important;
            border: 1px solid #333333 !important;
            padding: 25px !important;
            border-radius: 15px !important;
            display: flex !important;
            align-items: center !important;
            cursor: pointer !important;
            transition: all 0.4s ease !important;
            color: #fff !important;
            text-decoration: none !important;
        }

        /* Effet de Vol au survol */
        .card:hover {
            transform: translateY(-10px) !important;
            border-color: #C5A059 !important;
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2) !important;
        }

        /* Samii spécial */
        .card-samii {
            grid-column: 1 / -1 !important;
            border: 2px solid #C5A059 !important;
            background: #000 !important;
            display: block !important;
        }
        
        .go-button {
            background: #C5A059 !important;
            color: #000 !important;
            border: none !important;
            padding: 10px 20px !important;
            border-radius: 8px !important;
            font-weight: bold !important;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <main class="hub">
        <h1>Bienvenue dans ton QG</h1>
        <p>Choisis ton activité et lance ton système.</p>

        <section class="hub-masonry">
            <article class="card card-samii">
                <h2>SAMII</h2>
                <p>IA Opérationnelle</p>
                <button class="go-button">GO →</button>
            </article>

            <article class="card"><h3>Particulier</h3></article>
            <article class="card"><h3>Entreprise</h3></article>
            <article class="card"><h3>E-commerce</h3></article>
            <article class="card"><h3>Restaurant</h3></article>
        </section>
    </main>
</body>
</html>
