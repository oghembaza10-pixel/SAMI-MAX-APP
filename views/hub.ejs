<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="hub_title">OG — Hub Central</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <!-- CSS Dédié -->
    <link rel="stylesheet" href="/css/hub.css">
</head>
<body data-workspace="<%= workspaceId || '' %>">

    <div class="og-layout">

        <!-- ================= SIDEBAR ================= -->
        <aside class="og-sidebar" id="ogSidebar">
            <div class="sidebar-brand">
                <a href="/hub" class="brand-logo">OG</a>
            </div>

            <nav class="sidebar-nav">
                <a href="/hub" class="nav-item active" title="Hub">
                    <i data-lucide="command"></i>
                    <span data-i18n="nav_hub">Hub</span>
                </a>
                <a href="/marketplace" class="nav-item" title="Marketplace">
                    <i data-lucide="shopping-bag"></i>
                    <span data-i18n="nav_market">Market</span>
                </a>
                <a href="/community" class="nav-item" title="Community">
                    <i data-lucide="users"></i>
                    <span data-i18n="nav_community">Community</span>
                </a>
                <a href="/academy" class="nav-item" title="Academy">
                    <i data-lucide="graduation-cap"></i>
                    <span data-i18n="nav_academy">Academy</span>
                </a>
                <a href="/networks" class="nav-item" title="Réseaux">
                    <i data-lucide="share-2"></i>
                    <span data-i18n="nav_networks">Réseaux</span>
                </a>
                <a href="/workspaces" class="nav-item" title="Mes QG">
                    <i data-lucide="layers"></i>
                    <span data-i18n="nav_qg">Mes QG</span>
                </a>
                <a href="/settings" class="nav-item" title="Paramètres">
                    <i data-lucide="sliders"></i>
                    <span data-i18n="nav_config">Config</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <button class="sidebar-toggle" id="sidebarToggle" title="Réduire">
                    <i data-lucide="chevron-left"></i>
                </button>
            </div>
        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <main class="og-main">
            
            <% if(error){ %>
            <div class="og-error-banner"><%= error %></div>
            <% } %>

            <!-- HERO SECTION -->
            <header class="og-hero">
                <div class="hero-content">
                    <span class="hero-badge">OG INFRASTRUCTURE</span>
                    <h1 data-i18n="hero_title">Pilotez votre activité.</h1>
                    <p data-i18n="hero_subtitle">Sélectionnez votre secteur ou configurez votre site et vos espaces avec SAMII.</p>

                    <!-- Barre de recherche / Déclencheur modal -->
                    <div class="hero-search-bar" id="openModalTrigger">
                        <i data-lucide="search"></i>
                        <span data-i18n="hero_search_placeholder">Quel est votre métier ? Je configure votre espace...</span>
                        <kbd>⌘K</kbd>
                    </div>

                    <% if(hasWorkspace){ %>
                    <div class="active-workspace-indicator">
                        <span data-i18n="last_workspace_label">Dernier espace actif :</span>
                        <% workspaces.forEach(function(workspace){ %>
                            <% if(workspace.id === lastWorkspace){ %>
                            <button class="workspace-pill" data-workspace="<%= workspace.id %>">
                                <%= workspace.name %>
                            </button>
                            <% } %>
                        <% }) %>
                    </div>
                    <% } %>
                </div>
            </header>

            <!-- SECTEURS / MÉTIERS -->
            <section class="og-section">
                <div class="section-header">
                    <h2 data-i18n="sectors_title">Secteurs d'activité</h2>
                    <p data-i18n="sectors_subtitle">Déployez une structure sur-mesure instantanément.</p>
                </div>

                <div class="metiers-grid">
                    <% metiers.forEach(function(metier){ %>
                    <div class="metier-card" data-metier="<%= metier %>">
                        <div class="card-glow"></div>
                        <div class="card-inner">
                            <div class="card-icon">
                                <i data-lucide="briefcase"></i>
                            </div>
                            <h3><%= metier %></h3>
                            <p data-i18n="card_action_init">Créer votre site ou boutique</p>
                        </div>
                        <div class="card-arrow">
                            <i data-lucide="arrow-right"></i>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </section>

        </main>
    </div>

    <!-- ================= MODALE INTERACTIVE ================= -->
    <div class="og-modal-backdrop" id="ogModal">
        <div class="og-modal-container">
            <button class="modal-close" id="closeModal">
                <i data-lucide="x"></i>
            </button>

            <!-- Étape 1 : Accueil Modale -->
            <div class="modal-step active" id="stepHome">
                <h2 data-i18n="modal_home_title">Command Center</h2>
                <p data-i18n="modal_home_subtitle">Quel est votre métier ou votre activité ?</p>
                
                <div class="modal-input-wrapper">
                    <i data-lucide="search"></i>
                    <input type="text" id="metierInput" placeholder="Ex : Agence, Restauration, Service, Mode..." data-i18n-placeholder="modal_input_placeholder">
                </div>

                <div class="modal-actions">
                    <button class="modal-action-btn" id="createQG">
                        <i data-lucide="plus-circle"></i>
                        <div>
                            <strong data-i18n="modal_action_create_title">Créer un nouvel espace</strong>
                            <span data-i18n="modal_action_create_sub">Générer l'architecture avec SAMII</span>
                        </div>
                    </button>
                    <button class="modal-action-btn" id="inviteCollaborator">
                        <i data-lucide="user-plus"></i>
                        <div>
                            <strong data-i18n="modal_action_collab_title">Ajouter un collaborateur</strong>
                            <span data-i18n="modal_action_collab_sub">Inviter un partenaire</span>
                        </div>
                    </button>
                    <button class="modal-action-btn" id="searchWorkspace">
                        <i data-lucide="layers"></i>
                        <div>
                            <strong data-i18n="modal_action_search_title">Rechercher un espace</strong>
                            <span data-i18n="modal_action_search_sub">Accéder à une structure existante</span>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Étape 2 : Formulaire de Création -->
            <div class="modal-step" id="stepCreate">
                <div class="samii-header">
                    <div class="samii-avatar">OG</div>
                    <div>
                        <h3 data-i18n="samii_title">SAMII Intelligence</h3>
                        <p data-i18n="samii_init_sub">Configuration de votre site/boutique en cours</p>
                    </div>
                </div>
                <form id="createWorkspaceForm" class="modal-form">
                    <div class="form-group">
                        <label data-i18n="form_label_sector">Activité / Métier</label>
                        <input type="text" id="workspaceMetier" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label data-i18n="form_label_name">Nom</label>
                            <input type="text" id="workspaceNom" required>
                        </div>
                        <div class="form-group">
                            <label data-i18n="form_label_firstname">Prénom</label>
                            <input type="text" id="workspacePrenom" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label data-i18n="form_label_company">Nom de votre entreprise / site</label>
                        <input type="text" id="workspaceEntreprise" required>
                    </div>
                    <button type="submit" class="og-btn-primary" data-i18n="form_btn_deploy">Générer l'espace</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Data Injection -->
    <script>
        window.OG_WORKSPACES = <%- JSON.stringify(workspaces || []) %>;
        window.OG_WORKSPACE_ID = "<%= workspaceId || '' %>";
    </script>

    <!-- Scripts -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/js/i18n.js"></script>
    <script src="/js/hub.js"></script>
</body>
</html>
