<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OG • HUB</title>

    <link rel="stylesheet" href="/css/hub-style.css">

</head>

<body>

<div class="app">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <h2>OG</h2>

            <span>Centre Commercial des QG</span>

        </div>

        <nav class="menu">

            <a href="/hub" class="active">Hub</a>

            <a href="/profile">Profil</a>

            <a href="/academy">Académie</a>

            <a href="/marketplace">Marketplace</a>

            <a href="/settings">Paramètres</a>

        </nav>

    </aside>

    <!-- CONTENU -->

    <main class="content">

        <header class="hero">

            <h1>Bienvenue au Centre Commercial des QG</h1>

            <p>
                Choisissez votre activité et lancez votre quartier général.
            </p>

        </header>

        <!-- CARTE SAMII -->

        <section class="samii-card">

            <div class="samii-left">

                <span class="badge">
                    IA OPÉRATIONNELLE
                </span>

                <h2>SAMII</h2>

                <p>
                    Connectez tous vos réseaux et pilotez votre activité depuis un seul endroit.
                </p>

                <button class="go-button">
                    GO →
                </button>

            </div>

            <div class="samii-right">

                <span>Meta</span>

                <span>WhatsApp</span>

                <span>Shopify</span>

                <span>LinkedIn</span>

                <span>TikTok</span>

            </div>

        </section>

        <!-- HUB -->

        <section class="hub-grid">

            <article class="card"><h3>Particulier</h3></article>
            <article class="card"><h3>Entreprise</h3></article>
            <article class="card"><h3>E-commerce</h3></article>
            <article class="card"><h3>Restaurant</h3></article>

            <article class="card"><h3>Garage</h3></article>
            <article class="card"><h3>Immobilier</h3></article>
            <article class="card"><h3>Hôtel</h3></article>
            <article class="card"><h3>Location</h3></article>

            <article class="card"><h3>Marketing</h3></article>
            <article class="card"><h3>Comptable</h3></article>
            <article class="card"><h3>Avocat</h3></article>
            <article class="card"><h3>Salle de sport</h3></article>

            <article class="card"><h3>Transport</h3></article>
            <article class="card"><h3>Ferme</h3></article>
            <article class="card"><h3>Formation</h3></article>
            <article class="card"><h3>Pharmacie</h3></article>

            <article class="card"><h3>Clinique</h3></article>
            <article class="card"><h3>Studio</h3></article>
            <article class="card"><h3>Import / Export</h3></article>
            <article class="card"><h3>Lavage</h3></article>

            <article class="card card-more">

                <h3>+ Plus de métiers</h3>

                <p>
                    Découvrez tous les QG disponibles.
                </p>

            </article>

        </section>

    </main>

</div>

</body>

</html>
