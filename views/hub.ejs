<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG Empire — Capitale Mondiale</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/hub-premium.css">

</head>

<body>

<div class="og-capital">

    <%- include("partials/sidebar") %>

    <main class="capitol-content">

        <header class="hero-premium">

            <div class="hero-overlay"></div>

            <img
                src="/img/premium-capitol-bg.jpg"
                alt="Capitale OG"
                class="hero-bg-img"
            >

            <div class="hero-text-zone">

                <h1>Rejoignez l'écosystème OG.</h1>

            </div>

        </header>

        <section class="holographic-grid">

            <article class="viable-card"
                     onclick="window.location.href='/marketplace'">

                <div class="card-content">

                    <i data-lucide="shopping-cart"
                       class="card-icon"></i>

                    <h2>Marketplace</h2>

                </div>

                <div class="card-shine"></div>

            </article>

            <article class="viable-card"
                     onclick="window.location.href='/academy'">

                <div class="card-content">

                    <i data-lucide="graduation-cap"
                       class="card-icon"></i>

                    <h2>Academy</h2>

                </div>

                <div class="card-shine"></div>

            </article>
<div class="og-capital">

    <%- include("partials/sidebar") %>

    <main class="capitol-content">

        <header class="hero-premium">

            <div class="hero-overlay"></div>

            <img src="/img/premium-capitol-bg.jpg"
                 class="hero-bg-img"
                 alt="OG">

            <div class="hero-text-zone">

                <h1>Rejoignez l'écosystème OG</h1>

                <p>
                    Le Hub est la capitale mondiale.
                    Créez votre Quartier Général et développez votre entreprise.
                </p>

            </div>

        </header>


        <section class="holographic-grid">

            <article class="viable-card"
                     onclick="location.href='/marketplace'">

                <div class="card-content">
                    <i data-lucide="store"></i>
                    <h2>Marketplace</h2>
                </div>

                <div class="card-shine"></div>

            </article>


            <article class="viable-card"
                     onclick="location.href='/academy'">

                <div class="card-content">
                    <i data-lucide="graduation-cap"></i>
                    <h2>Academy</h2>
                </div>

                <div class="card-shine"></div>

            </article>


            <article class="viable-card"
                     onclick="location.href='/community'">

                <div class="card-content">
                    <i data-lucide="users"></i>
                    <h2>Community</h2>
                </div>

                <div class="card-shine"></div>

            </article>


            <article class="viable-card"
                     onclick="location.href='/metiers'">

                <div class="card-content">
                    <i data-lucide="briefcase"></i>
                    <h2>Les Métiers</h2>
                </div>

                <div class="card-shine"></div>

            </article>


            <article class="viable-card primary-action"
                     onclick="location.href='/creer-qg'">

                <div class="card-content">
                    <i data-lucide="plus-circle"></i>
                    <h2>Créer mon QG</h2>
                </div>

                <div class="card-shine"></div>

            </article>

        </section>

    </main>

</div>

<script src="https://unpkg.com/lucide@latest"></script>

<script>
lucide.createIcons();
</script>

<script src="/js/sidebar.js"></script>
<script src="/js/hub.js"></script>
        <section class="hub-presentation">

            <div class="presentation-box">

                <h2>La capitale de l'écosystème OG</h2>

                <p>
                    Ici, tous les entrepreneurs se retrouvent.
                    Découvrez les métiers, échangez avec la communauté,
                    développez vos compétences et créez votre Quartier Général.
                </p>

            </div>

        </section>


        <section class="hub-features">

            <article class="feature-card">

                <i data-lucide="shield"></i>

                <h3>Votre réputation</h3>

                <p>
                    SAMII calcule votre score grâce aux avis,
                    aux livraisons et à votre activité.
                </p>

            </article>


            <article class="feature-card">

                <i data-lucide="trending-up"></i>

                <h3>Montez en grade</h3>

                <p>
                    Soldat, Caporal, Sergent,
                    Lieutenant, Colonel puis Général.
                </p>

            </article>


            <article class="feature-card">

                <i data-lucide="sparkles"></i>

                <h3>Cartes stratégiques</h3>

                <p>
                    Boost Marketing,
                    Radar Opportunités,
                    Forteresse,
                    Coffre,
                    et bien d'autres.
                </p>

            </article>

        </section>


        <section class="create-qg-banner">

            <div>

                <h2>Votre entreprise mérite son Quartier Général.</h2>

                <p>
                    Le Hub est seulement votre point de départ.
                </p>

            </div>

            <a href="/creer-qg" class="create-btn">

                Créer mon QG

            </a>

        </section>


    </main>


    <div class="samii-orb" id="samii-trigger">

        <i data-lucide="bot"></i>

    </div>

</div>

<script src="https://unpkg.com/lucide@latest"></script>

<script>
lucide.createIcons();
</script>

<script src="/js/sidebar.js"></script>
<script src="/js/hub.js"></script>

</body>
</html>
