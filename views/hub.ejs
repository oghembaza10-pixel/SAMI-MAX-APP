<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include("partials/head") %>
    <title>OG Empire — Le Hub</title>
    <link rel="stylesheet" href="/css/hub-premium.css">
</head>
<body>

<div class="og-capital">

    <%- include("partials/sidebar") %>

    <main class="capitol-content">

        <!-- HERO — vivant, aucune statistique -->
        <header class="hero-premium">
            <img src="/img/premium-capitol-bg.jpg" alt="Capitale OG" class="hero-bg-img">
            <div class="hero-overlay"></div>

            <div class="hero-text-zone">
                <span class="hero-eyebrow">Bienvenue, Général</span>
                <h1>Ton empire commence ici.</h1>
                <p>Choisis ton premier QG et construis ton héritage.</p>
            </div>
        </header>

        <!-- CHOIX DU MÉTIER -->
        <div class="section-eyebrow">
            <i data-lucide="compass"></i>
            <span>Choisis ton métier</span>
        </div>

        <section class="metier-grid" id="metier-grid">
            <!-- Rempli dynamiquement par hub.js (METIERS) -->
        </section>

        <div class="og-divider"></div>

        <!-- ACCÈS RAPIDES : Marketplace / Academy / Community / Arsenal -->
        <div class="quick-links">
            <a class="quick-link" href="/marketplace">
                <i data-lucide="store"></i> Marketplace
            </a>
            <a class="quick-link" href="/academy">
                <i data-lucide="graduation-cap"></i> Academy
            </a>
            <a class="quick-link" href="/community">
                <i data-lucide="users"></i> Community
            </a>
            <a class="quick-link" href="/arsenal">
                <i data-lucide="sword"></i> Arsenal
            </a>
        </div>

        <div class="og-divider"></div>

        <!-- ÉCOSYSTÈME CONNECTÉ -->
        <div class="section-eyebrow">
            <i data-lucide="link-2"></i>
            <span>Ton écosystème</span>
        </div>

        <section class="platform-grid" id="platform-grid">
            <!-- Rempli dynamiquement par hub.js (PLATFORMS) -->
        </section>

        <%- include("partials/footer") %>

    </main>

</div>

<%- include("partials/samii-widget") %>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
    // Injecté par le serveur : liste des plateformes déjà connectées pour ce compte.
    // Ex. côté route : res.render('hub', { connectedPlatforms: ['instagram', 'google'] })
    window.OG_CONNECTED_PLATFORMS = <%- JSON.stringify(typeof connectedPlatforms !== "undefined" ? connectedPlatforms : []) %>;
</script>
<script src="/js/hub.js"></script>

</body>
</html>
