<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG Technology — Le Hub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/hub-premium.css">
</head>
<body data-workspace="<%= typeof workspaceId !== 'undefined' ? workspaceId : '' %>">

<div class="og-capital">

    <%- include("partials/sidebar") %>

    <main class="capitol-content">

        <!-- MESSAGE ERREUR HUB -->
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="hub-error-msg" style="display:block;">
            <%= error %>
        </div>
        <% } %>

        <!-- HERO -->
        <header class="hero-premium">
            <img src="/hero-city.png" alt="Ville futuriste OG" class="hero-bg-img" onerror="this.style.display='none'">
            <div class="hero-grid"></div>
            <div class="hero-glow hero-glow-1"></div>
            <div class="hero-glow hero-glow-2"></div>
            <div class="hero-particles"></div>
            <div class="hero-light"></div>
            <div class="hero-overlay"></div>

            <div class="hero-text-zone">
                <span class="hero-eyebrow" data-i18n="hub.hero.eyebrow">OG Technology</span>
                <h1 data-i18n="hub.hero.title">Quel empire voulez-vous construire ?</h1>
                <p data-i18n="hub.hero.subtitle">SAMII vous aide à lancer votre QG et à connecter votre écosystème.</p>

                <div class="hero-search-wrap">
                    <div class="hero-search">
                        <i data-lucide="search"></i>
                        <input type="text" id="hero-search"
                               data-i18n-ph="hub.hero.searchPlaceholder"
                               placeholder="Construisez votre prochain empire..." autocomplete="off">
                        <button type="button" class="hero-search__btn" id="hero-search-btn">
                            <i data-lucide="arrow-right"></i>
                        </button>
                    </div>
                    <div class="hero-search__panel" id="hero-search-panel">
                        <button class="hero-search__option" data-action="create">
                            <i data-lucide="plus-circle"></i>
                            <div>
                                <strong data-i18n="hub.search.create.title">Créer mon QG</strong>
                                <span data-i18n="hub.search.create.desc">Nouveau workspace pour votre activité</span>
                            </div>
                        </button>
                        <button class="hero-search__option" data-action="invite">
                            <i data-lucide="user-plus"></i>
                            <div>
                                <strong data-i18n="hub.search.invite.title">Inviter un collaborateur</strong>
                                <span data-i18n="hub.search.comingSoon">Bientôt disponible</span>
                            </div>
                        </button>
                        <button class="hero-search__option" data-action="find">
                            <i data-lucide="search"></i>
                            <div>
                                <strong data-i18n="hub.search.find.title">Chercher un QG</strong>
                                <span data-i18n="hub.search.comingSoon">Bientôt disponible</span>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            <span class="hero-scroll">▼</span>
        </header>

        <!-- CHOIX DU MÉTIER / WORKSPACES -->
        <div class="section-eyebrow">
            <i data-lucide="compass"></i>
            <span data-i18n="hub.section.choose">Choisis ton métier</span>
        </div>

        <section class="metier-grid" id="metier-grid">
            <!-- Rempli dynamiquement par hub.js -->
        </section>

        <!-- BANNIÈRE -->
        <section class="hub-banner" id="hub-banner">
            <img src="/banner-tech.png" alt="OG Technology" class="hub-banner__img" onerror="this.style.opacity=0">
            <div class="hub-banner__overlay"></div>
            <div class="hub-banner__glow"></div>
            <div class="hub-banner__content">
                <span class="hero-eyebrow">OG Technology</span>
                <h2 data-i18n="hub.banner.title">Construisez un empire mondial.</h2>
                <p data-i18n="hub.banner.subtitle">Une seule plateforme. Des possibilités illimitées.</p>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="og-footer">
            <div class="og-footer__line"></div>
            <div class="og-footer__inner">
                <div class="og-footer__brand">
                    <span class="og-footer__crest">◆</span>
                    <span class="og-mono">OG · EMPIRE</span>
                </div>
                <p class="og-footer__quote" data-i18n="hub.footer.quote">Chaque général commence soldat.</p>
                <div class="og-footer__meta">
                    <span class="og-mono" data-i18n="hub.footer.version">v1.0 · SOLDAT</span>
                </div>
            </div>
        </footer>

    </main>

</div>

<!-- SAMII — sphère flottante -->
<div class="samii-widget" id="samii-widget" data-open="false">
    <button class="samii-widget__trigger" id="samii-widget-trigger" aria-label="Ouvrir SAMII" data-i18n-aria="hub.samii.openAria">
        <span class="samii-widget__aura"></span>
        <span class="samii-widget__aura samii-widget__aura--2"></span>
        <svg class="samii-widget__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"/>
            <rect width="16" height="12" x="4" y="8" rx="2"/>
            <path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>
        </svg>
    </button>
    <div class="samii-widget__panel" id="samii-widget-panel" role="dialog" aria-label="Assistant SAMII" data-i18n-aria="hub.samii.dialogAria">
        <header class="samii-widget__header">
            <div class="samii-widget__id">
                <div class="samii-widget__avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 8V4H8"/>
                        <rect width="16" height="12" x="4" y="8" rx="2"/>
                        <path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>
                    </svg>
                </div>
                <div>
                    <p class="samii-widget__name">SAMII</p>
                    <p class="samii-widget__status">
                        <span class="og-badge og-badge--live" data-i18n="hub.status.operational">OPÉRATIONNEL</span>
                    </p>
                </div>
            </div>
            <div class="samii-widget__actions">
                <button class="samii-widget__close" id="samii-widget-close" aria-label="Fermer" data-i18n-aria="hub.samii.closeAria">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                         stroke="currentColor" stroke-width="1.8">
                        <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </header>
        <div class="samii-widget__feed" id="samii-widget-feed">
            <div class="samii-msg samii-msg--bot">
                <div class="samii-msg__bubble">
                    <span data-i18n="hub.samii.welcome1">Bienvenue, Général. Je suis</span> <b>SAMII</b>, <span data-i18n="hub.samii.welcome2">votre stratège.</span><br>
                    <span data-i18n="hub.samii.welcome3">Comment puis-je vous aider aujourd'hui ?</span>
                </div>
            </div>
        </div>
        <form class="samii-widget__form" id="samii-widget-form">
            <input type="text" id="samii-widget-input"
                   placeholder="Parler à SAMII…" autocomplete="off" data-i18n-ph="hub.samii.inputPlaceholder">
            <button type="submit" aria-label="Envoyer" data-i18n-aria="hub.samii.sendAria">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/>
                </svg>
            </button>
        </form>
    </div>
</div>

<!-- ✅ Données serveur → frontend -->
