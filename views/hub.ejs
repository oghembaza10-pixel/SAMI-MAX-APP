<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG Hub — Tableau de Bord</title>
    
    <!-- Styles CSS -->
    <link rel="stylesheet" href="/css/hub.css">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <div class="hub-layout">
        <!-- Sidebar -->
        <aside class="hub-sidebar">
            <div class="hub-sidebar__brand">
                <span class="hub-logo-dot"></span>
                <h2>OG EMPIRE</h2>
            </div>
            <nav class="hub-nav">
                <a href="/hub" class="hub-nav__item active">
                    <i data-lucide="layout-grid"></i>
                    <span>Hub Central</span>
                </a>
                <a href="/analytics" class="hub-nav__item">
                    <i data-lucide="bar-chart-3"></i>
                    <span>Analytique</span>
                </a>
                <a href="/settings" class="hub-nav__item">
                    <i data-lucide="settings"></i>
                    <span>Paramètres</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="hub-main">
            <header class="hub-header">
                <div class="hub-header__search-box">
                    <i data-lucide="search"></i>
                    <input type="text" id="hero-search" placeholder="Rechercher un secteur, un empire...">
                </div>
                <div class="hub-header__profile">
                    <span>Général</span>
                    <div class="hub-avatar"></div>
                </div>
            </header>

            <div class="hub-content">
                <div class="hub-hero">
                    <h1>Sélectionnez votre Secteur</h1>
                    <p>Déployez et pilotez vos QGs opérationnels à travers l'écosystème.</p>
                </div>

                <!-- Grille des métiers -->
                <div id="metier-grid" class="metier-grid">
                    <!-- Injecté dynamiquement par hub.js -->
                </div>
            </div>
        </main>
    </div>

    <!-- Widget SAMII -->
    <div id="samii-widget" class="samii-widget" data-open="false">
        <div id="samii-widget-trigger" class="samii-widget__trigger">
            <i data-lucide="bot"></i>
            <span>SAMII</span>
        </div>
        <div class="samii-widget__panel">
            <div class="samii-widget__header">
                <h3>SAMII — Assistant Stratège</h3>
                <button id="samii-widget-close"><i data-lucide="x"></i></button>
            </div>
            <div id="samii-widget-feed" class="samii-widget__feed">
                <div class="samii-msg samii-msg--bot">
                    <div class="samii-msg__bubble">
                         Comment puis-je vous assister dans le pilotage ?
                    </div>
                </div>
            </div>
            <form id="samii-widget-form" class="samii-widget__form">
                <input type="text" id="samii-widget-input" placeholder="Envoyer une directive à SAMII..." autocomplete="off">
                <button type="submit"><i data-lucide="send"></i></button>
            </form>
        </div>
    </div>

    <!-- Données injectées pour le JS -->
   <script>
        window.OG_WORKSPACES = <%- JSON.stringify(workspaces || []) %>;
        window.OG_WORKSPACE_ID = "<%= workspaceId || '' %>";
    </script>

    <!-- Script Frontend -->
    <script src="/js/hub.js"></script>
</body>
</html>
