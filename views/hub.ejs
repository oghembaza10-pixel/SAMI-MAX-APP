<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OG • HUB</title>

    <link rel="stylesheet" href="/css/hub-style.css">

</head>

<body>

<div class="app">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <h2>OG</h2>

            <span>Centre Commercial des QG</span>

        </div>

        <nav class="menu">

            <a href="/hub" class="active">

                <i data-lucide="layout-grid"></i>

                Hub

            </a>

            <a href="/profile">

                <i data-lucide="user"></i>

                Profil

            </a>

            <a href="/academy">

                <i data-lucide="graduation-cap"></i>

                Académie

            </a>

            <a href="/marketplace">

                <i data-lucide="store"></i>

                Marketplace

            </a>

            <a href="/settings">

                <i data-lucide="settings"></i>

                Paramètres

            </a>

        </nav>

    </aside>

    <!-- CONTENU -->

    <main class="content">

        <header class="hero">

            <h1>Bienvenue au Centre Commercial des QG</h1>

            <p>

                Choisissez votre activité et lancez votre quartier général.

            </p>

            <div class="language-switcher">

                <button data-lang="fr" class="active">FR</button>

                <button data-lang="en">EN</button>

                <button data-lang="ar">العربية</button>

            </div>

        </header>

        <!-- SAMII -->

        <section class="samii-card">

            <div class="samii-left">

                <span class="badge">

                    IA OPÉRATIONNELLE

                </span>

                <h2>SAMII</h2>

                <p>

                    Connectez tous vos outils et pilotez votre activité
                    depuis un seul QG.

                </p>

                <button class="go-button">

                    GO →

                </button>

            </div>

            <div class="samii-right">

                <span><i data-lucide="message-circle"></i> WhatsApp</span>

                <span><i data-lucide="facebook"></i> Meta</span>

                <span><i data-lucide="send"></i> Telegram</span>

                <span><i data-lucide="shopping-bag"></i> Shopify</span>

                <span><i data-lucide="briefcase"></i> LinkedIn</span>

                <span><i data-lucide="video"></i> TikTok</span>

            </div>

        </section>

        <!-- HUB -->

        <section id="hub-grid" class="hub-grid"></section>

        <!-- COMMUNAUTÉ -->

        <section class="community-card">

            <i data-lucide="lightbulb"></i>

            <h3>

                Un métier manque ?

            </h3>

            <p>

                Dites-nous quel QG vous souhaitez voir apparaître.
                Les métiers les plus demandés seront ajoutés
                progressivement par la communauté OG.

            </p>

            <button>

                <i data-lucide="plus"></i>

                Proposer un métier

            </button>

        </section>

    </main>

</div>

<script src="https://unpkg.com/lucide@latest"></script>

<script src="/js/hub.js"></script>

<script>

if(window.lucide){

    lucide.createIcons();

}

</script>

</body>

</html>
