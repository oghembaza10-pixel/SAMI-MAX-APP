<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG Empire — Le Hub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/hub-premium.css">
</head>
<body data-workspace="<%= typeof workspaceId !== 'undefined' ? workspaceId : '' %>">

<div class="og-capital">

    <%- include("partials/sidebar") %>

    <main class="capitol-content">

        <!-- HERO -->
        <header class="hero-premium">
            <img src="/hero-city.png" alt="Ville futuriste OG" class="hero-bg-img" onerror="this.style.display='none'">
            <div class="hero-grid"></div>
            <div class="hero-glow hero-glow-1"></div>
            <div class="hero-glow hero-glow-2"></div>
            <div class="hero-particles"></div>
            <div class="hero-light"></div>
            <div class="hero-overlay"></div>

            <div class="hero-text-zone">
                <span class="hero-eyebrow" data-i18n="hub.hero.eyebrow">OG Empire</span>
                <h1 data-i18n="hub.hero.title">Quel empire voulez-vous construire ?</h1>
                <p data-i18n="hub.hero.subtitle">SAMII vous aide à lancer votre QG et à connecter votre écosystème.</p>

                <div class="hero-search">
                    <i data-lucide="search"></i>
                    <input type="text" id="hero-search" data-i18n-placeholder="hub.hero.searchPlaceholder" placeholder="Construisez votre prochain empire...">
                    <button type="button" class="hero-search__btn">
                        <i data-lucide="arrow-right"></i>
                    </button>
                </div>
            </div>

            <span class="hero-scroll">▼</span>
        </header>

        <!-- CHOIX DU MÉTIER -->
        <div class="section-eyebrow">
            <i data-lucide="compass"></i>
            <span data-i18n="hub.section.choose">Choisis ton métier</span>
        </div>

        <section class="metier-grid" id="metier-grid">
            <!-- Rempli dynamiquement par hub.js (traduit aussi) -->
        </section>

        <!-- BANNIÈRE "TAPIS" -->
        <section class="hub-banner" id="hub-banner">
            <img src="/banner-tech.png" alt="OG Empire" class="hub-banner__img" onerror="this.style.opacity=0">
            <div class="hub-banner__overlay"></div>
            <div class="hub-banner__glow"></div>
            <div class="hub-banner__content">
                <span class="hero-eyebrow">OG Empire</span>
                <h2>Construisez un empire mondial.</h2>
                <p>Une seule plateforme. Des possibilités illimitées.</p>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="og-footer">
            <div class="og-footer__line"></div>
            <div class="og-footer__inner">
                <div class="og-footer__brand">
                    <span class="og-footer__crest">◆</span>
                    <span class="og-mono">OG · EMPIRE</span>
                </div>
                <p class="og-footer__quote" data-i18n="hub.footer.quote">Chaque général commence soldat.</p>
                <div class="og-footer__meta">
                    <span class="og-mono" data-i18n="hub.footer.version">v1.0 · SOLDAT</span>
                </div>
            </div>
        </footer>

    </main>

</div>

<!-- SAMII — sphère flottante -->
<div class="samii-widget" id="samii-widget" data-open="false">
    <button class="samii-widget__trigger" id="samii-widget-trigger" aria-label="Ouvrir SAMII">
        <span class="samii-widget__aura"></span>
        <span class="samii-widget__aura samii-widget__aura--2"></span>
        <svg class="samii-widget__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"/>
            <rect width="16" height="12" x="4" y="8" rx="2"/>
            <path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>
        </svg>
    </button>
    <div class="samii-widget__panel" id="samii-widget-panel" role="dialog" aria-label="Assistant SAMII">
        <header class="samii-widget__header">
            <div class="samii-widget__id">
                <div class="samii-widget__avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2M20 14h2M15 13v2M9 13v2"/></svg>
                </div>
                <div>
                    <p class="samii-widget__name">SAMII</p>
                    <p class="samii-widget__status"><span class="og-badge og-badge--live">OPÉRATIONNEL</span></p>
                </div>
            </div>
            <div class="samii-widget__actions">
                <button class="samii-widget__close" id="samii-widget-close" aria-label="Fermer">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
        </header>
        <div class="samii-widget__feed" id="samii-widget-feed">
            <div class="samii-msg samii-msg--bot">
                <div class="samii-msg__bubble">
                    Bienvenue, Général. Je suis <b>SAMII</b>, votre stratège.<br>
                    Comment puis-je vous aider aujourd'hui ?
                </div>
            </div>
        </div>
        <form class="samii-widget__form" id="samii-widget-form">
            <input type="text" id="samii-widget-input" placeholder="Parler à SAMII…" autocomplete="off">
            <button type="submit" aria-label="Envoyer">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/></svg>
            </button>
        </form>
    </div>
</div>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
    window.OG_CONNECTED_PLATFORMS = <%- JSON.stringify(typeof connectedPlatforms !== "undefined" ? connectedPlatforms : []) %>;
    window.OG_WORKSPACE_ID = document.body.getAttribute('data-workspace') || '';
</script>
<script src="/js/i18n.js"></script>
<script src="/js/hub.js"></script>

</body>
</html>

