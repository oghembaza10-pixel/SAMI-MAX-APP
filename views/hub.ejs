<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OG Empire — Capitale Mondiale</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/css/hub-premium.css">
</head>
<body>

    <div class="og-capital">

        <nav class="capitol-sidebar">
            <div class="sidebar-top">
                <div class="logo-sm">OG</div>
                <a href="/hub" class="nav-item active" title="Hub">
                    <i data-lucide="home"></i>
                </a>
                <a href="/marketplace" class="nav-item" title="Marketplace">
                    <i data-lucide="shopping-cart"></i>
                </a>
                <a href="/academy" class="nav-item" title="Academy">
                    <i data-lucide="graduation-cap"></i>
                </a>
                <a href="/community" class="nav-item" title="Community">
                    <i data-lucide="globe"></i>
                </a>
                <a href="/metiers" class="nav-item" title="Les Métiers">
                    <i data-lucide="sword"></i>
                </a>
            </div>
            <div class="sidebar-bottom">
                <div class="logo-placeholder">IG</div>
                <div class="logo-placeholder">WA</div>
                <div class="logo-placeholder">GO</div>
            </div>
        </nav>

        <main class="capitol-content">
            
            <header class="hero-premium">
                <div class="hero-overlay"></div>
                <img src="/img/premium-capitol-bg.jpg" alt="Capitale OG" class="hero-bg-img">
                <div class="hero-text-zone">
                    <h1>Rejoignez l'écosystème OG.</h1>
                </div>
            </header>

            <section class="holographic-grid">
                
                <article class="viable-card" onclick="window.location.href='/marketplace'">
                    <div class="card-content">
                        <i data-lucide="shopping-cart" class="card-icon"></i>
                        <h2>Marketplace</h2>
                    </div>
                    <div class="card-shine"></div>
                </article>

                <article class="viable-card" onclick="window.location.href='/academy'">
                    <div class="card-content">
                        <i data-lucide="graduation-cap" class="card-icon"></i>
                        <h2>Academy</h2>
                    </div>
                    <div class="card-shine"></div>
                </article>

                <article class="viable-card" onclick="window.location.href='/community'">
                    <div class="card-content">
                        <i data-lucide="globe" class="card-icon"></i>
                        <h2>Community</h2>
                    </div>
                    <div class="card-shine"></div>
                </article>

                <article class="viable-card" onclick="window.location.href='/metiers'">
                    <div class="card-content">
                        <i data-lucide="sword" class="card-icon"></i>
                        <h2>Les Métiers</h2>
                    </div>
                    <div class="card-shine"></div>
                </article>

                <article class="viable-card primary-action" onclick="window.location.href='/creer-qg'">
                    <div class="card-content">
                        <i data-lucide="plus-circle" class="card-icon"></i>
                        <h2>Créer mon QG</h2>
                    </div>
                    <div class="card-shine"></div>
                </article>

            </section>

        </main>

        <div class="samii-orb" id="samii-trigger">
            <i data-lucide="bot"></i>
        </div>

    </div>

    <script>
        lucide.createIcons();
    </script>
    <script src="/js/capitol.js"></script>

</body>
</html>
