<main class="hub">
    <header class="hub-header">
        <div class="hub-heading">
            <h1>Bienvenue dans ton QG</h1>
            <p>Choisis ton activité et lance ton système.</p>
        </div>
        <nav class="hub-language">
            <button class="active">FR</button>
            <button>EN</button>
            <button>العربية</button>
        </nav>
    </header>

    <section class="search-section">
        <div class="search-box">
            <i data-lucide="search"></i>
            <input id="search" type="text" placeholder="Chercher mon QG...">
        </div>
    </section>

    <section class="hub-masonry">
        <article class="card card-samii">
            <div class="card-content">
                <span class="card-label">IA OPÉRATIONNELLE</span>
                <h2>SAMII</h2>
                <p>Connectez vos réseaux.</p>
                <div class="samii-network">
                    <span>Meta</span><span>WhatsApp</span><span>Shopify</span><span>LinkedIn</span><span>TikTok</span>
                </div>
            </div>
            <div class="card-action">
                <button class="go-button">GO →</button>
            </div>
        </article>

        <article class="card"><div class="card-icon"><img src="/icons/particulier.svg" alt="Particulier"></div><h3>Particulier</h3><span class="nav-arrow">→</span></article>
        <article class="card"><div class="card-icon"><img src="/icons/entreprise.svg" alt="Entreprise"></div><h3>Entreprise</h3><span class="nav-arrow">→</span></article>
        <article class="card card-more">
            <div class="card-content"><h3>+ Plus de métiers</h3><p>Découvrir tous les QG disponibles.</p></div>
            <span class="nav-arrow">→</span>
        </article>
    </section>
</main>
<script>lucide.createIcons();</script>
