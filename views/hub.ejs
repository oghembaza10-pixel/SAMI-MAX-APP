<main class="main">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <header class="hub-header">

        <div class="hub-title">

            <h1>Bienvenue dans ton QG</h1>

            <p>
                Choisis ton activité et lance ton système.
            </p>

        </div>

        <div class="hub-language">

            <button>FR</button>

            <button>EN</button>

            <button>العربية</button>

        </div>

    </header>


    <!-- ========================= -->
    <!-- SEARCH -->
    <!-- ========================= -->

    <section class="search-section">

        <div class="search-box">

            <i data-lucide="search"></i>

            <input
                id="search"
                type="text"
                placeholder="Chercher mon QG..."
            >

        </div>

    </section>


    <!-- ========================= -->
    <!-- SAMII -->
    <!-- ========================= -->

    <section class="samii-section">

        <div class="samii-card">

            <div class="samii-left">

                <span class="samii-label">
                    IA OPÉRATIONNELLE
                </span>

                <h2>SAMII</h2>

                <p>

                    Ton copilote intelligent.

                    Connecté à tous tes réseaux.

                </p>

                <div class="samii-network">

                    <span>Meta</span>

                    <span>TikTok</span>

                    <span>WhatsApp</span>

                    <span>LinkedIn</span>

                    <span>Shopify</span>

                </div>

            </div>

            <div class="samii-right">

                <span class="nav-arrow">

                    →

                </span>

            </div>

        </div>

    </section>


    <!-- ========================= -->
    <!-- HUB -->
    <!-- ========================= -->

    <section class="hub-grid">

        <div class="main-grid">

            <!-- Garage -->

            <div class="card">

                <div class="card-icon">

                    <img src="/icons/garage.svg">

                </div>

                <h3>Garage</h3>

                <span class="nav-arrow">→</span>

            </div>


            <!-- Immobilier -->

            <div class="card">

                <div class="card-icon">

                    <img src="/icons/immo.svg">

                </div>

                <h3>Immobilier</h3>

                <span class="nav-arrow">→</span>

            </div>


            <!-- Hôtel -->

            <div class="card">

                <div class="card-icon">

                    <img src="/icons/hotel.svg">

                </div>

                <h3>Hôtel</h3>

                <span class="nav-arrow">→</span>

            </div>


            <!-- Restaurant -->

            <div class="card">

                <div class="card-icon">

                    <img src="/icons/restaurant.svg">

                </div>

                <h3>Restaurant</h3>

                <span class="nav-arrow">→</span>

            </div>

            <!-- Les autres métiers suivent exactement le même modèle -->

        </div>

    </section>

</main>

<script>

lucide.createIcons();

</script>
