<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Espace · OG Empire</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/client-style.css">
</head>
<body>
<div class="qg-grade-bar">
    <span class="qg-grade-bar__icon" id="grade-icon">🪖</span>
    <span class="qg-grade-bar__nom" id="grade-nom">SOLDAT</span>
    <div class="qg-grade-bar__batterie">
        <div class="qg-grade-bar__fill" id="grade-fill" style="width:5%"></div>
    </div>
    <span class="qg-grade-bar__next" id="grade-next">→ CAPORAL</span>
</div>
<div class="qg-shell">
    <aside class="qg-sidebar" id="og-sidebar">
        <div class="qg-sidebar__top">
            <a href="/client-qg" class="qg-logo">
                <img src="/og.png" alt="OG">
                <span class="qg-logo__text">OG · EMPIRE</span>
            </a>
            <button class="qg-collapse-btn" id="og-sidebar-collapse" aria-label="Réduire la sidebar">
                <i data-lucide="chevrons-left"></i>
            </button>
        </div>
        <nav class="qg-nav">
            <a href="/client-qg" class="qg-nav__item active">
                <i data-lucide="home"></i><span>Mon Espace</span>
            </a>
            <a href="/marketplace" class="qg-nav__item">
                <i data-lucide="store"></i><span>Marketplace</span>
            </a>
            <a href="/community" class="qg-nav__item">
                <i data-lucide="users"></i><span>Community</span>
            </a>
            <a href="/academy" class="qg-nav__item">
                <i data-lucide="graduation-cap"></i><span>Academy</span>
            </a>
            <div class="qg-nav__divider"></div>
            <a href="/client-qg/samii" class="qg-nav__item qg-nav__item--samii">
                <i data-lucide="bot"></i><span>SAMII</span>
                <span class="qg-status-dot qg-status-dot--on"></span>
            </a>
        </nav>
        <div class="qg-sidebar__bottom">
            <a href="/settings" class="qg-nav__item">
                <i data-lucide="settings"></i><span>Paramètres</span>
            </a>
            <a href="/logout" class="qg-nav__item" style="color:#e55;">
                <i data-lucide="log-out"></i><span>Déconnexion</span>
            </a>
        </div>
    </aside>

    <main class="qg-main">
        <header class="qg-topbar">
            <div class="qg-topbar__breadcrumb">
                <span class="qg-mono">MON ESPACE</span>
            </div>
        </header>

        <section class="qg-hero">
            <div class="qg-hero__content">
                <span class="qg-eyebrow">BIENVENUE</span>
                <h1>Bonjour <%= nom || 'Général' %> 👋</h1>
                <p>SAMII t'aide au quotidien — transport, services, plans, et bien plus.</p>
            </div>
        </section>

        <div class="qg-section-title">
            <i data-lucide="sparkles"></i>
            <span>Aujourd'hui</span>
        </div>
        <section class="qg-dashboard">
            <a href="/client-qg/transport" class="qg-card qg-card--tilt" style="text-decoration:none;cursor:pointer;">
                <div class="qg-card__icon"><i data-lucide="bus"></i></div>
                <span class="qg-card__value" style="font-size:1rem;">🚌 Transport</span>
                <span class="qg-card__label">Trouver un trajet →</span>
            </a>
            <a href="/client-qg/traducteur" class="qg-card qg-card--tilt" style="text-decoration:none;cursor:pointer;">
                <div class="qg-card__icon"><i data-lucide="languages"></i></div>
                <span class="qg-card__value" style="font-size:1rem;">🌐 Traducteur</span>
                <span class="qg-card__label">Traduire un texte →</span>
            </a>
            <a href="/client-qg/services" class="qg-card qg-card--tilt" style="text-decoration:none;cursor:pointer;">
                <div class="qg-card__icon"><i data-lucide="hand-helping"></i></div>
                <span class="qg-card__value" style="font-size:1rem;">🛎️ Services</span>
                <span class="qg-card__label">Livraison, garde, plus →</span>
            </a>
            <a href="/client-qg/plans" class="qg-card qg-card--tilt" style="text-decoration:none;cursor:pointer;">
                <div class="qg-card__icon"><i data-lucide="gift"></i></div>
                <span class="qg-card__value" style="font-size:1rem;">🎁 Meilleurs Plans</span>
                <span class="qg-card__label">Découvrir la surprise →</span>
            </a>
            <a href="/client-qg/academie" class="qg-card qg-card--tilt" style="text-decoration:none;cursor:pointer;">
                <div class="qg-card__icon"><i data-lucide="graduation-cap"></i></div>
                <span class="qg-card__value" style="font-size:1rem;">🎓 Technologie</span>
                <span class="qg-card__label">Devenir Marchand →</span>
            </a>
<a href="/client-qg/emploi" class="qg-card qg-card--tilt" style="text-decoration:none;cursor:pointer;">
    <div class="qg-card__icon"><i data-lucide="briefcase"></i></div>
    <span class="qg-card__value" style="font-size:1rem;">💼 Missions & Emploi</span>
    <span class="qg-card__label">Trouver un poste →</span>
</a>
        </section>

        <div class="qg-section-title">
            <i data-lucide="message-circle"></i>
            <span>SAMII</span>
        </div>
        <section class="qg-dashboard">
            <article class="qg-card" style="grid-column:1/-1;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                    <span style="color:#9d5cff;font-weight:700;font-size:.95rem;">Messages restants aujourd'hui</span>
                    <span class="qg-mono" id="quota-texte" style="color:#5FD4FF;">50 / 50</span>
                </div>
                <div style="background:rgba(255,255,255,0.06);border-radius:8px;height:8px;margin-bottom:12px;">
                    <div id="quota-bar" style="height:8px;border-radius:8px;background:linear-gradient(90deg,#9d5cff,#5FD4FF);width:100%;transition:width .6s ease;"></div>
                </div>
                <p style="color:var(--text-muted);font-size:.8rem;">
                    💡 Invite 3 amis avec ton lien pour débloquer plus de messages chaque jour.
                </p>
                <button id="btn-copier-lien" style="margin-top:10px;padding:10px 16px;background:#9d5cff;border:none;border-radius:8px;font-weight:700;cursor:pointer;color:#fff;">
                    🔗 Copier mon lien d'invitation
                </button>
            </article>
        </section>
    </main>
</div>

<a href="/client-qg/samii" class="samii-orb" aria-label="Ouvrir SAMII">
    <span class="samii-orb__aura"></span>
    <span class="samii-orb__aura samii-orb__aura--2"></span>
    <i data-lucide="bot"></i>
</a>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
if (typeof lucide !== "undefined") lucide.createIcons();

document.getElementById('btn-copier-lien')?.addEventListener('click', () => {
    const lien = window.location.origin + '/register?ref=<%= codeParrainage || "" %>';
    navigator.clipboard.writeText(lien).then(() => {
        const btn = document.getElementById('btn-copier-lien');
        const original = btn.textContent;
        btn.textContent = '✅ Lien copié !';
        setTimeout(() => { btn.textContent = original; }, 2000);
    });
});

fetch('/client-qg/quota')
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;
        document.getElementById('quota-texte').textContent = `${data.restant} / ${data.total}`;
        const pct = Math.round((data.restant / data.total) * 100);
        document.getElementById('quota-bar').style.width = pct + '%';
    })
    .catch(() => {});
</script>
</body>
</html>
