<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Espace · OG Technology</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/client-style.css?v=2">
</head>
<body data-telephone="<%= telephone || '' %>" data-user-id="<%= userId || '' %>">
<div class="qg-grade-bar">
    <span class="qg-grade-bar__icon" id="grade-icon">🪖</span>
    <span class="qg-grade-bar__nom" id="grade-nom" data-i18n="grade.soldat">SOLDAT</span>
    <div class="qg-grade-bar__batterie">
        <div class="qg-grade-bar__fill" id="grade-fill" style="width:5%"></div>
    </div>
    <span class="qg-grade-bar__next" id="grade-next" data-i18n="grade.next.caporal">→ CAPORAL</span>
</div>
<div class="qg-shell">
    <aside class="qg-sidebar" id="og-sidebar">
        <div class="qg-sidebar__top">
            <a href="<%= COM.ecosysteme ? "/client-qg" : ("/c/" + COM.slug) %>" class="qg-logo">
                <img src="/og.png" alt="OG">
                <span class="qg-logo__text"><%= COM.ecosysteme ? "OG · TECHNOLOGY" : (COM.marque + " " + COM.marqueSuite) %></span>
            </a>
            <button class="qg-collapse-btn" id="og-sidebar-collapse" aria-label="Réduire la sidebar" data-i18n-aria="nav.collapse">
                <i data-lucide="chevrons-left"></i>
            </button>
        </div>
        <nav class="qg-nav">
            <a href="/client-qg" class="qg-nav__item active">
                <i data-lucide="home"></i><span data-i18n="nav.monespace">Mon Espace</span>
            </a>
            <% if (COM.ecosysteme) { %><a href="/marketplace" class="qg-nav__item">
                <i data-lucide="store"></i><span data-i18n="nav.marketplace">Marketplace</span>
            </a><% } %>
            <a href="<%= COM.ecosysteme ? "/community" : ("/c/" + COM.slug) %>" class="qg-nav__item">
                <i data-lucide="users"></i><span data-i18n="nav.community">Community</span>
            </a>
            <% if (COM.ecosysteme) { %><a href="/academy" class="qg-nav__item">
                <i data-lucide="graduation-cap"></i><span data-i18n="nav.academy">Academy</span>
            </a><% } %>
            <% if (COM.ecosysteme) { %><a href="/livreur" class="qg-nav__item">
                <i data-lucide="bike"></i><span data-i18n="nav.livreur">Devenir livreur</span>
            </a><% } %>
            <a href="/client-qg/samii" class="qg-nav__item qg-nav__item--samii">
    <img src="/samii-os-icon.png" alt="<%= COM.assistant %>" style="width:20px;height:20px;border-radius:6px;object-fit:cover;">
    <span><%= COM.assistant %></span>
    <span class="qg-status-dot qg-status-dot--on"></span>
</a>
        </nav>
        <div class="qg-sidebar__bottom">
            <a href="/settings" class="qg-nav__item">
                <i data-lucide="settings"></i><span data-i18n="nav.settings">Paramètres</span>
            </a>
            <a href="/logout" class="qg-nav__item" style="color:#e55;">
                <i data-lucide="log-out"></i><span data-i18n="nav.logout">Déconnexion</span>
            </a>
            <div class="og-lang-switch">
                <span data-lang-btn="fr">FR</span>
                <span data-lang-btn="en">EN</span>
                <span data-lang-btn="ar">AR</span>
                <span data-lang-btn="zh">ZH</span>
            </div>
        </div>
    </aside>

    <main class="qg-main">
        <header class="qg-topbar">
            <div class="qg-topbar__breadcrumb">
                <span class="qg-mono" data-i18n="topbar.title">MON ESPACE</span>
            </div>
        </header>

        <section class="qg-hero">
            <div class="qg-hero__content">
                <span class="qg-eyebrow" data-i18n="hero.eyebrow">BIENVENUE</span>
                <h1><span data-i18n="hero.greeting">Bonjour</span> <%= nom || 'Général' %> 👋</h1>
                <p<%= COM.ecosysteme ? ' data-i18n="hero.subtitle"' : "" %>><%= COM.ecosysteme ? "SAMII t'aide au quotidien — transport, services, plans, et bien plus." : COM.moteurTexte %></p>
            </div>
        </section>

        <% if (commandes && commandes.length) { %>
        <div class="qg-section-title">
            <i data-lucide="truck"></i>
            <span data-i18n="section.commandes">Mes commandes</span>
        </div>
        <section class="qg-dashboard" id="mes-commandes">
            <% commandes.forEach(function(c) { %>
            <article class="qg-card" style="grid-column:1/-1;" data-commande-id="<%= c.id %>">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
                    <div>
                        <span style="color:#fff;font-weight:700;font-size:.9rem;">#<%= c.id %></span>
                        <span style="color:var(--text-muted);font-size:.82rem;margin-left:8px;"><%= c.produit || '' %></span>
                    </div>
                    <span class="commande-statut-badge" style="padding:4px 12px;border-radius:20px;font-size:.75rem;font-weight:700;background:rgba(95,212,255,0.12);color:#5FD4FF;">
                        <%= c.dernier_statut_suivi || c.statut || 'en attente' %>
                    </span>
                </div>
                <% if (c.numero_suivi) { %>
                <p style="color:var(--text-muted);font-size:.78rem;margin-top:8px;">
                    📦 <span data-i18n="track.label">Suivi :</span> <%= c.numero_suivi %> (<%= c.transporteur || '' %>)
                </p>
                <% } %>
            </article>
            <% }); %>
        </section>
        <% } %>

