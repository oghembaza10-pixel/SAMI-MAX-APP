        </section>
    </main>
</div>

<a href="/client-qg/samii" class="samii-orb" aria-label="<%= "Ouvrir " + COM.assistant %>"<%- COM.ecosysteme ? ' data-i18n-aria="samii.openAria"' : "" %>>
