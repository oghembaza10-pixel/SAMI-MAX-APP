    <span class="samii-orb__aura samii-orb__aura--2"></span>
    <img src="/samii-os-icon.png" alt="<%= COM.assistant %>" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">
</a>
<script src="https://unpkg.com/lucide@latest"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
if (typeof lucide !== "undefined") lucide.createIcons();

document.getElementById('btn-copier-lien')?.addEventListener('click', () => {
    const lien = window.location.origin + '/register?ref=<%= codeParrainage || "" %>';
    navigator.clipboard.writeText(lien).then(() => {
        const btn = document.getElementById('btn-copier-lien');
        const original = btn.textContent;
        btn.textContent = t('samii.linkCopied');
        setTimeout(() => { btn.textContent = original; }, 2000);
    });
});

fetch('/client-qg/quota')
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;
        if (data.illimite) {
            document.getElementById('quota-texte').textContent = t('samii.quotaUnlimited') || 'Illimité';
            document.getElementById('quota-bar').style.width = '100%';
            return;
        }
        document.getElementById('quota-texte').textContent = `${data.restant} / ${data.total}`;
        const pct = Math.round((data.restant / data.total) * 100);
        document.getElementById('quota-bar').style.width = pct + '%';
    })
    .catch(() => {});

fetch('/parrainage/resume')
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;
        const badge = document.getElementById('badge-gains');
        if (badge && data.confirme > 0) badge.textContent = ' (+' + data.confirme.toFixed(2) + '$)';
    })
    .catch(() => {});

if (typeof io !== 'undefined') {
    const socket = io();
    const telephone = document.body.getAttribute('data-telephone');
    const userId = document.body.getAttribute('data-user-id');
    socket.on('connect', () => {
        if (telephone) socket.emit('join', telephone);
        if (userId) socket.emit('join', userId);
    });
    socket.on('parrainage:gain', function (gain) {
        if (gain.statut !== 'confirmee') return;
        const badge = document.getElementById('badge-gains');
        if (!badge) return;
        const actuel = parseFloat((badge.textContent.match(/[\d.]+/) || [0])[0]) || 0;
        badge.textContent = ' (+' + (actuel + parseFloat(gain.commission_montant)).toFixed(2) + '$)';
    });
    socket.on('commande-suivi-maj', function (d) {
        const card = document.querySelector('[data-commande-id="' + d.id + '"]');
        if (!card) return;
        const badge = card.querySelector('.commande-statut-badge');
        if (badge && d.statut) badge.textContent = d.statut;
        if (d.numero_suivi) {
            let suivi = card.querySelector('p');
            if (!suivi) {
                suivi = document.createElement('p');
                suivi.style.cssText = 'color:var(--text-muted);font-size:.78rem;margin-top:8px;';
                card.appendChild(suivi);
            }
            suivi.textContent = '📦 ' + t('track.label') + ' ' + d.numero_suivi + ' (' + (d.transporteur || '') + ')';
        }
    });
}
</script>
