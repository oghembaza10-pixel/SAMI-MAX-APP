<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>L'Académie — SAMII OS</title>
  <link rel="stylesheet" href="/css/qg-style.css">
  <style>
    :root {
      --enc:#07070a; --pan:#101013; --pan2:#16161a; --or:#c9a961; --or-clair:#f0d99b;
      --ivoire:#f3f1e9; --gris:#8b8d95; --faible:#6c6e77; --bord:rgba(201,169,97,.18);
      --cyan:#5fd4ff;
    }
    body { background: var(--enc); color: var(--ivoire); }
    .vi { max-width: 1180px; margin: 0 auto; padding: 34px 20px 80px; }

    .vi-haut { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:30px; }
    .vi-marque { font-family:Georgia,serif; font-size:10px; letter-spacing:.46em; text-indent:.46em;
                 color:var(--or); text-transform:uppercase; }
    .vi-menu { display:flex; gap:8px; flex-wrap:wrap; }
    .vi-menu a {
      padding:9px 15px; border-radius:4px; border:1px solid rgba(255,255,255,.09);
      color:var(--gris); text-decoration:none; font-size:.79rem; transition:.2s ease;
    }
    .vi-menu a:hover { border-color:var(--bord); color:var(--ivoire); }
    .vi-menu a.est-or { background:var(--or); border-color:var(--or); color:#07070a; font-weight:650; }
    .vi-menu a.est-or:hover { background:var(--or-clair); border-color:var(--or-clair); }

    .vi-titre { text-align:center; margin-bottom:8px; }
    .vi-titre h1 { font-family:"Didot","Bodoni MT",Georgia,serif; font-weight:400;
                   font-size:clamp(1.8rem,4.4vw,2.5rem); margin:0 0 10px; }
    .vi-titre p { color:var(--gris); font-size:.92rem; line-height:1.7; max-width:56ch; margin:0 auto; }

    /* La recherche d'abord : quelqu'un qui arrive ici a un problème en tête,
       pas l'envie de parcourir un catalogue. */
    .vi-chercher { display:flex; gap:10px; max-width:660px; margin:28px auto 22px; flex-wrap:wrap; }
    .vi-chercher input, .vi-chercher select {
      flex:1 1 200px; padding:13px 15px; border-radius:4px; border:1px solid rgba(255,255,255,.1);
      background:rgba(255,255,255,.03); color:var(--ivoire); font-size:.86rem; font-family:inherit;
    }
    .vi-chercher input::placeholder { color:var(--faible); }
    .vi-chercher button {
      padding:13px 26px; border:none; border-radius:4px; background:var(--or); color:#07070a;
      font-weight:700; font-size:.78rem; letter-spacing:.06em; text-transform:uppercase; cursor:pointer;
    }
    .vi-chercher button:hover { background:var(--or-clair); }

    .vi-natures { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-bottom:12px; }
    .vi-natures a {
      padding:7px 14px; border-radius:20px; border:1px solid rgba(255,255,255,.09);
      color:var(--gris); text-decoration:none; font-size:.75rem; transition:.2s ease;
    }
    .vi-natures a:hover { border-color:var(--bord); color:var(--ivoire); }
    .vi-natures a.actif { border-color:var(--or); color:var(--or); background:rgba(201,169,97,.07); }

    .vi-compte { text-align:center; color:var(--faible); font-size:.76rem; margin-bottom:26px; }

    .vi-grille { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    @media (max-width:980px) { .vi-grille { grid-template-columns:repeat(2,1fr); } }
    @media (max-width:620px) { .vi-grille { grid-template-columns:1fr; } }

    .vi-carte {
      display:flex; flex-direction:column; padding:22px 20px; text-decoration:none; color:inherit;
      border:1px solid rgba(255,255,255,.08); border-radius:8px;
      background:linear-gradient(180deg,var(--pan2),var(--pan));
      transition:border-color .25s ease, transform .25s ease;
    }
    .vi-carte:hover { border-color:var(--bord); transform:translateY(-3px); }
    .vi-carte__haut { display:flex; align-items:center; gap:11px; margin-bottom:13px; }
    .vi-carte__icone { font-size:1.4rem; line-height:1; }
    .vi-carte__nature {
      font-family:var(--font-mono,monospace); font-size:.61rem; letter-spacing:.11em;
      text-transform:uppercase; padding:3px 9px; border-radius:20px;
      border:1px solid rgba(255,255,255,.1); color:var(--faible);
    }
    .vi-carte__nature--application { color:var(--cyan); border-color:rgba(95,212,255,.25); }
    .vi-carte__nature--prestataire { color:var(--or); border-color:var(--bord); }
    .vi-carte h3 { margin:0 0 7px; font-size:.98rem; font-weight:650; }
    .vi-carte p { margin:0 0 16px; font-size:.83rem; line-height:1.65; color:var(--gris); flex:1; }
    .vi-carte__pied { display:flex; align-items:center; justify-content:space-between; gap:10px;
                      padding-top:13px; border-top:1px solid rgba(255,255,255,.06); }
    .vi-carte__auteur { font-size:.74rem; color:var(--faible); }
    .vi-carte__action { font-family:var(--font-mono,monospace); font-size:.68rem;
                        letter-spacing:.09em; text-transform:uppercase; color:var(--or); }

    /* Jamais de rubrique vide : quand aucun prestataire n'est encore visible,
       cette carte prend la place et invite au lieu de constater le manque. */
    .vi-appel {
      grid-column:1/-1; padding:30px 26px; border:1px dashed var(--bord); border-radius:8px;
      background:rgba(201,169,97,.03); text-align:center;
    }
    .vi-appel h3 { margin:0 0 8px; font-size:1.05rem; font-weight:650; }
    .vi-appel p { margin:0 auto 18px; font-size:.86rem; line-height:1.7; color:var(--gris); max-width:58ch; }
    .vi-appel a {
      display:inline-block; padding:13px 30px; background:var(--or); color:#07070a;
      border-radius:4px; text-decoration:none; font-size:.77rem; font-weight:700;
      letter-spacing:.07em; text-transform:uppercase;
    }
    .vi-appel a:hover { background:var(--or-clair); }
    .vi-vide { grid-column:1/-1; text-align:center; padding:50px 20px; color:var(--gris); font-size:.88rem; }
    .vi-vide a { color:var(--or); }
  </style>
</head>
<body data-theme="og">
<div class="vi">

  <div class="vi-haut">
    <div class="vi-marque">O G &nbsp; T E C H N O L O G Y</div>
    <nav class="vi-menu">
      <a href="/qg">QG</a>
      <a href="/academy/bibliotheque">Apprendre</a>
      <a href="/academy/construire" class="est-or">Créer avec SAMII</a>
    </nav>
  </div>

  <div class="vi-titre">
    <h1>L'Académie</h1>
    <p>Les solutions qui font tourner un commerce, et les gens qui les construisent.
       Dis ton métier, on te montre ce qui existe pour toi.</p>
  </div>

  <form class="vi-chercher" method="GET" action="/academy">
    <input type="text" name="recherche" value="<%= recherche %>"
           placeholder="Ce qu'il te faut : relancer mes clients, prendre les RDV…">
    <select name="metier">
      <option value="">Tous les métiers</option>
      <% groupes.forEach(function (g) { %>
        <optgroup label="<%= g.groupe %>">
          <% g.items.forEach(function (m) { %>
            <option value="<%= m.id %>" <%= metier === m.id ? "selected" : "" %>><%= m.icone %> <%= m.label %></option>
          <% }); %>
        </optgroup>
      <% }); %>
    </select>
    <button type="submit">Chercher</button>
  </form>

  <div class="vi-natures">
    <% const base = "/academy?" + (metier ? "metier=" + metier + "&" : "") + (recherche ? "recherche=" + encodeURIComponent(recherche) + "&" : ""); %>
    <a href="<%= base %>" class="<%= !nature ? "actif" : "" %>">Tout</a>
    <% Object.values(natures).forEach(function (n) { %>
      <a href="<%= base %>nature=<%= n.id %>" class="<%= nature === n.id ? "actif" : "" %>"><%= n.label %></a>
    <% }); %>
  </div>

  <p class="vi-compte">
    <%= cartes.length %> solution<%= cartes.length > 1 ? "s" : "" %><% if (metierLabel) { %> pour <%= metierLabel %><% } %>
  </p>

  <div class="vi-grille">

    <% cartes.forEach(function (c) { %>
      <a class="vi-carte" href="<%= c.lien %>">
        <div class="vi-carte__haut">
          <span class="vi-carte__icone"><%= c.icone %></span>
          <span class="vi-carte__nature vi-carte__nature--<%= c.nature %>"><%= natures[c.nature].label %></span>
        </div>
        <h3><%= c.titre %></h3>
        <p><%= c.description %></p>
        <div class="vi-carte__pied">
          <span class="vi-carte__auteur"><%= c.auteur %></span>
          <span class="vi-carte__action"><%= natures[c.nature].action %> →</span>
        </div>
      </a>
    <% }); %>

    <% if (!cartes.length) { %>
      <div class="vi-vide">
        Rien ne correspond à cette recherche.
        <a href="/academy">Voir tout →</a>
      </div>
    <% } %>

    <% if (!prestataires) { %>
      <div class="vi-appel">
        <h3>Ce qui manque ici, c'est peut-être toi</h3>
        <p>Développeur, agence, intégrateur : construis sur l'API de SAMII et pose ton
           travail dans cette vitrine. Les marchands y sont déjà. Entrer et publier ne
           coûtent rien — SAMII prend <%= taux %> % le jour où tu vends, et rien avant.</p>
        <a href="/academy/construire">Créer avec SAMII →</a>
      </div>
    <% } %>

  </div>

</div>
</body>
</html>
