<div class="og-platforms-wrapper">

    <div class="sidebar-title">

        <span data-i18n="sidebar.platforms">

            Plateformes

        </span>

    </div>

    <div class="og-platforms-scroll">

        <% if (connectedPlatforms && connectedPlatforms.length > 0) { %>

            <% connectedPlatforms.forEach(function(platform){ %>

                <a
                    href="/connectors/<%= platform.slug %>"
                    class="platform-card connected"
                    title="<%= platform.name %>">

                    <div class="platform-icon">

                        <% if(platform.logo){ %>

                            <img
                                src="<%= platform.logo %>"
                                alt="<%= platform.name %>">

                        <% }else{ %>

                            <i data-lucide="plug"></i>

                        <% } %>

                    </div>

                    <div class="platform-content">

                        <span class="platform-name">

                            <%= platform.name %>

                        </span>

                        <small
                            class="platform-status"
                            data-i18n="sidebar.connected">

                            Connecté

                        </small>

                    </div>

                    <span class="platform-online"></span>

                </a>

            <% }) %>

        <% } else { %>

            <a
                href="/marketplace"
                class="platform-card discover">

                <div class="platform-icon">

                    <i data-lucide="plus"></i>

                </div>

                <div class="platform-content">

                    <span
                        data-i18n="sidebar.addPlatform">

                        Ajouter une plateforme

                    </span>

                    <small
                        data-i18n="sidebar.marketplace">

                        Marketplace

                    </small>

                </div>

            </a>

        <% } %>

    </div>

</div>
