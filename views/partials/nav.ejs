<%#
  ==========================================================================
  SAMII OS — LA NAVIGATION, UNE SEULE FOIS

  ── CE QU'IL Y AVAIT AVANT ────────────────────────────────────────────────

  Deux gabarits : `qg-nav.ejs` (la colonne du QG, 2 vues) et `sidebar.ejs`
  (la barre étroite, 13 vues). Tous deux lisaient déjà config/modules-qg.js —
  ce n'était donc pas deux listes concurrentes, et c'est ce qui rendait la
  duplication difficile à voir.

  Ce qui était vraiment dupliqué :

    1. LE REPLI SUR LA COMMUNAUTÉ, vingt lignes identiques des deux côtés.
       C'est la logique qui évite d'afficher « OG · TECHNOLOGY » sur le
       domaine d'une partenaire quand une route oublie de passer `communaute`.
       Écrite deux fois, elle n'aurait été corrigée qu'une fois.
    2. LA LISTE DE LA BARRE ÉTROITE, écrite en dur dans le gabarit — une
       deuxième liste de modules, à côté du registre. Elle est passée dans
       config/modules-qg.js (BARRE_ETROITE), à sa place.

  ── CE QUI N'EST PAS FUSIONNÉ, ET POURQUOI ────────────────────────────────

  Les deux BALISAGES restent distincts, sélectionnés par `variante`. Ils
  servent deux feuilles de style différentes (`qg-sidebar`/`qg-nav__item` et
  `og-sidebar`/`og-item`), et n'ont ni la même forme ni le même rôle : l'une
  est une colonne de travail avec ses rangs et ses replis, l'autre une barre
  d'icônes de six entrées.

  Les réunir en un seul balisage aurait voulu dire réécrire deux feuilles de
  style pour un gain nul à l'écran. Un fichier, une source de données, deux
  rendus : c'est la fusion qui règle le vrai problème sans en créer un autre.

  ── CE QU'IL FAUT PASSER ──────────────────────────────────────────────────

    variante   "qg" (colonne complète) | "etroite" (barre d'icônes)
    actif      l'identifiant du module en cours ("affaires", "connect"…)
  Facultatif :
    communaute, userId, typeCompte  (viennent de res.locals la plupart du temps)
  ==========================================================================
%>
<%
// ── LE REPLI, EN TROIS TEMPS — et l'ordre est tout l'enjeu ───────────────
//
// 1. Ce que la route a passé explicitement.
// 2. SINON `COM`, posé par index.js sur res.locals à chaque requête : c'est
//    la communauté du SERVICE. Une route qui oublie de passer `communaute`
//    rend alors quand même la bonne colonne.
// 3. SINON seulement, la maison.
//
// L'étape 2 est celle qui compte. Sans elle, un oubli dans UNE route suffit
// à afficher « OG · TECHNOLOGY », Marketplace et Arsenal sur le domaine
// d'une partenaire — sans erreur, sans log, juste une page fausse. L'oubli
// doit tomber du côté sûr, pas du côté visible.
//
// La maison reste le dernier recours plutôt qu'une page blanche : refuser
// d'afficher un QG est pire que d'en montrer un trop complet à quelqu'un de
// chez nous.
//
// `locals.COM` et non `COM` : on est en train de DÉCLARER `COM`, et se citer
// dans sa propre initialisation lève une ReferenceError.
const _duService = (typeof locals !== "undefined" && locals && locals.COM) || null;
const COM = (typeof communaute !== "undefined" && communaute)
    ? communaute
    : (_duService && _duService.slug ? _duService
    : { slug: "samii", marque: "OG", marqueSuite: "TECHNOLOGY",
        assistant: "SAMII", ecosysteme: true, qg: null });

const _ctx = {
    userId: typeof userId !== "undefined" ? userId : "",
    typeCompte: typeof typeCompte !== "undefined" ? typeCompte : "",
};
const _actif = typeof actif === "undefined" ? "" : actif;
// `modulesQg` vient de app.locals (index.js) : un gabarit EJS n'a pas de
// `require`, et le découvrir en production aurait donné un QG en erreur.
const _variante = (typeof variante !== "undefined" && variante === "etroite") ? "etroite" : "qg";
const _accueil = COM.ecosysteme ? "/hub" : `/c/${COM.slug}`;
// Chez une partenaire, l'assistant porte SON nom — le moteur est le même,
// c'est l'étiquette qui change.
const _libelle = (m) => (m.id === "assistant" ? COM.assistant : m.libelle);
%>
<% if (_variante === "qg") { %>
<%
const _liste = modulesQg.autorises(COM).filter((m) => !m.siAgence || _ctx.typeCompte === "agence");
const _rang = (r) => _liste.filter((m) => m.rang === r);

// Le nom en haut de la colonne. Chez une partenaire, écrire
// « OG · TECHNOLOGY » revient à signer notre marque sur un espace qu'on lui
// a présenté comme le sien.
const _marque = COM.ecosysteme ? "OG · TECHNOLOGY" : `${COM.marque} ${COM.marqueSuite}`.trim();

function _entree(m) {
    const href = modulesQg.lien(m, COM, _ctx);
    const classes = [
        "qg-nav__item",
        // `avance` porte AUSSI `--more` : sur téléphone, le panneau « Plus »
        // existant continue donc de les servir sans une ligne de changement.
        // Sur ordinateur, c'est `--avance` qui décide, et lui seul.
        m.rang === "core" ? "qg-nav__item--core"
            : (m.rang === "avance" ? "qg-nav__item--more qg-nav__item--avance"
            : (m.rang === "more" ? "qg-nav__item--more" : "")),
        m.id === "assistant" ? "qg-nav__item--samii" : "",
        m.id === _actif ? "active" : "",
    ].filter(Boolean).join(" ");
    const cible = m.nouvelOnglet ? ' target="_blank" rel="noopener"' : "";
    return `<a href="${href}" class="${classes}"${cible}>
        <i data-lucide="${m.icone}"></i><span data-i18n="${m.cle}">${_libelle(m)}</span>
        ${m.pastille ? '<span class="qg-status-dot qg-status-dot--on" id="samii-status-dot" title="Assistant actif" data-i18n-title="qg.nav.samiiActive"></span>' : ""}
        ${m.badge ? `<span id="${m.badge}" style="color:#3ddc84;"></span>` : ""}
    </a>`;
}
%>
<aside class="qg-sidebar" id="og-sidebar">
    <div class="qg-sidebar__top">
        <a href="<%= _accueil %>" class="qg-logo">
            <span class="qg-logo__text"><%= _marque %></span>
        </a>
        <button class="qg-collapse-btn" id="og-sidebar-collapse" aria-label="Réduire la sidebar" data-i18n-aria="qg.nav.collapse">
            <i data-lucide="chevrons-left"></i>
        </button>
    </div>
    <nav class="qg-nav">
        <% _rang("core").forEach((m) => { %><%- _entree(m) %><% }); %>
        <% if (_rang("more").length) { %>
        <button type="button" id="qg-more-toggle" class="qg-nav__item qg-nav__item--core qg-nav__item--more-toggle">
            <i data-lucide="more-horizontal"></i><span data-i18n="qg.nav.more">Plus</span>
        </button>
        <% } %>
        <% _rang("more").forEach((m) => { %>
            <% if (m.separateurAvant) { %><div class="qg-nav__divider qg-nav__item--more"></div><% } %>
            <%- _entree(m) %>
        <% }); %>

        <%# ── « PLUS » SUR ORDINATEUR ──────────────────────────────────────
            Le bouton « Plus » n'existait que sur téléphone : sur un écran
            large il est masqué, et la colonne affichait ses quatorze entrées
            d'un bloc. Une colonne de quatorze lignes ne se lit plus, elle se
            subit — et les lignes qu'on ne comprend pas (« API & Webhooks »,
            « Applications ») apprennent au commerçant que ce produit n'est
            pas pour lui.
            Ce second bouton prend le relais sur grand écran, sans toucher au
            premier : les deux mécaniques ne se croisent jamais, chacune est
            masquée là où l'autre travaille. %>
        <% if (_rang("avance").length) { %>
        <button type="button" id="qg-avance-toggle" class="qg-nav__item qg-nav__item--avance-toggle"
                aria-expanded="false">
            <i data-lucide="more-horizontal"></i><span data-i18n="qg.nav.more">Plus</span>
        </button>
        <% } %>
        <% _rang("avance").forEach((m) => { %><%- _entree(m) %><% }); %>
    </nav>
    <div class="qg-sidebar__bottom qg-nav__item--more">
        <% _rang("bas").forEach((m) => { %><%- _entree(m) %><% }); %>
        <%# La sortie et le choix de langue ne sont pas des modules : ils
            existent partout, y compris dans le QG le plus réduit. Les
            retirer enfermerait quelqu'un dans une langue qu'il ne lit pas. %>
        <a href="/logout" class="qg-nav__item" style="color:#e55;">
            <i data-lucide="log-out"></i><span data-i18n="qg.nav.logout">Déconnexion</span>
        </a>
        <div class="og-lang-switch">
            <span data-lang-btn="fr">FR</span>
            <span data-lang-btn="en">EN</span>
            <span data-lang-btn="ar">AR</span>
            <span data-lang-btn="zh">ZH</span>
        </div>
    </div>
</aside>
<% } else { %>
<%# ── LA BARRE ÉTROITE ──────────────────────────────────────────────────
    Celle de « Connecter mes outils », du Hub et de la création de QG.

    « Qu'est-ce que ça fout chez elle, ça ? On voulait lui laisser Connect
    Tools, mais pas ce qu'il y a avec. Là je vois Arsenal, je vois
    Marketplace. »

    Exact — et c'est pourquoi elle lit le même registre que la colonne du
    QG, filtré par ce à quoi la communauté a droit. La porte empêchait d'y
    ENTRER, mais les liens restaient affichés : on clique, on rebondit sur
    son fil, et on croit que c'est cassé. Cacher une page sans retirer son
    lien est pire que de ne rien cacher. %>
<aside class="og-sidebar">
    <%# Le logo ramène chez elle, et n'affiche pas le nôtre. %>
    <a href="<%= _accueil %>" class="og-logo">
        <% if (COM.ecosysteme) { %>
            <img src="/og.png" alt="OG">
        <% } else { %>
            <%# Son sigle à la place de notre logo. Style posé ici : cette
                barre est incluse par treize vues aux feuilles de style
                différentes, et une classe ajoutée dans l'une d'elles ne
                serait présente que dans celle-là. %>
            <span style="display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#111114;color:#fff;font-weight:800;font-size:13px;letter-spacing:.02em;"><%= COM.sigle || "" %></span>
        <% } %>
    </a>

    <div class="og-sidebar-divider"></div>

    <nav class="og-nav">
        <% modulesQg.barreEtroite(COM).forEach((m) => { const href = modulesQg.lien(m, COM, _ctx); %>
        <a href="<%= href %>" class="og-item<%= m.id === _actif ? " active" : "" %>"
           title="<%= _libelle(m) %>" data-i18n-title="<%= m.cle %>">
            <i data-lucide="<%= m.icone %>"></i>
            <span class="og-item__label" data-i18n="<%= m.cle %>"><%= _libelle(m) %></span>
        </a>
        <% }); %>
    </nav>

    <div class="og-sidebar-extra">
        <a href="/profile" class="og-item" title="Profil" data-i18n-title="sidebar.profile">
            <i data-lucide="user"></i>
        </a>
        <a href="/settings" class="og-item" title="Paramètres" data-i18n-title="sidebar.settings">
            <i data-lucide="settings"></i>
        </a>
        <%# Sortir de son compte : il n'y avait aucun moyen de le faire
            depuis cette barre non plus. %>
        <a href="/logout" class="og-item" title="Se déconnecter" data-i18n-title="qg.nav.logout">
            <i data-lucide="log-out"></i>
        </a>
    </div>

    <div class="og-lang-switch">
        <span data-lang-btn="fr">FR</span>
        <span data-lang-btn="en">EN</span>
        <span data-lang-btn="ar">AR</span>
        <span data-lang-btn="zh">ZH</span>
    </div>
</aside>
<% } %>
