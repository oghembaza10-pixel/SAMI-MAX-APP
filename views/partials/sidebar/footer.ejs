<div class="og-sidebar-footer">

    <div class="sidebar-divider"></div>

    <!-- ================= PROFIL ================= -->

    <a
        href="/profile"
        class="sidebar-item <%= currentPage === 'profile' ? 'active' : '' %>">

        <i data-lucide="user-circle"></i>

        <div class="sidebar-item-content">

            <span data-i18n="sidebar.profile">

                Profil

            </span>

            <% if(typeof user !== "undefined" && user){ %>

                <small>

                    <%= user.firstname || user.name || "Utilisateur" %>

                </small>

            <% } %>

        </div>

    </a>

    <!-- ================= PARAMÈTRES ================= -->

    <a
        href="/settings"
        class="sidebar-item <%= currentPage === 'settings' ? 'active' : '' %>">

        <i data-lucide="settings-2"></i>

        <span data-i18n="sidebar.settings">

            Paramètres

        </span>

    </a>

    <!-- ================= LANGUES ================= -->

    <div class="sidebar-language">

        <button data-lang="fr">FR</button>

        <button data-lang="en">EN</button>

        <button data-lang="es">ES</button>

        <button data-lang="ar">AR</button>

    </div>

    <!-- ================= DÉCONNEXION ================= -->

    <a
        href="/logout"
        class="sidebar-item sidebar-logout">

        <i data-lucide="log-out"></i>

        <span data-i18n="sidebar.logout">

            Déconnexion

        </span>

    </a>

</div>
