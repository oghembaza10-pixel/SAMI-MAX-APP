            'qg.modules.all': 'Tout',
            'qg.section.overview': 'Vue d’ensemble',
            'qg.cards2.revenue': 'Revenus', 'qg.cards2.orders': 'Commandes', 'qg.cards2.pending': 'En attente',
            'qg.cards2.confirmed': 'Confirmées', 'qg.cards2.cancelled': 'Annulées', 'qg.cards2.vip': 'Clients VIP',
            'qg.cards2.blacklist': 'Blacklist',
            'qg.section.delivery': 'Livraison temps réel 🚚',
            'qg.delivery.delivered': 'Livrées', 'qg.delivery.inProgress': 'En cours', 'qg.delivery.failed': 'Échecs',
            'qg.section.missionToday': 'Mission du jour 🎯',
            'qg.mission.objective': 'Objectif du jour', 'qg.mission.ordersToday': 'Commandes aujourd’hui',
            'qg.mission.revenueToday': 'Revenus aujourd’hui', 'qg.mission.progressLabel': 'Progression vers objectif (10 cmd)',
            'qg.section.performance': 'Performance du mois 📈',
            'qg.performance.revenueMonth': 'Revenus ce mois', 'qg.performance.ordersMonth': 'Commandes ce mois',
            'qg.performance.vsLastMonth': 'vs mois dernier',
            'qg.section.liveActivity': 'Activité en direct',
            'qg.section.recentOrders': 'Dernières commandes',
            'qg.section.calendar': 'Calendrier des rendez-vous',
            'qg.table.client': 'Client', 'qg.table.phone': 'Téléphone', 'qg.table.product': 'Produit',
            'qg.table.total': 'Total', 'qg.table.status': 'Statut',
            'qg.loading': 'Chargement...',
