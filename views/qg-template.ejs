<script>
document.querySelectorAll('.auth-tab').forEach(tab=>tab.addEventListener('click',()=>{
 document.querySelectorAll('.auth-tab').forEach(t=>t.classList.remove('active'));tab.classList.add('active');
 const r=tab.dataset.tab==='register';document.getElementById('form-register').style.display=r?'block':'none';document.getElementById('form-login').style.display=r?'none':'block';document.getElementById('auth-msg').textContent='';
}));
document.querySelectorAll('input[name="type_compte"]').forEach(r=>r.addEventListener('change',()=>{
 document.getElementById('bloc-metier').style.display=r.value==='marchand'&&r.checked?'block':'none';
}));
document.getElementById('select-pays').addEventListener('change',function(){document.getElementById('champ-autre-pays').style.display=this.value==='autre'?'block':'none'});
const stepLabels={1:'Étape 1 sur 2 — Ton profil',2:'Étape 2 sur 2 — Sécurité & style'};
function goToStep(n){document.querySelectorAll('.form-step').forEach(s=>s.classList.remove('active'));document.querySelector('.form-step[data-step="'+n+'"]').classList.add('active');document.querySelectorAll('.step-dot').forEach(d=>d.classList.toggle('done',+d.dataset.stepDot<=n));document.getElementById('step-label').textContent=stepLabels[n]}
document.getElementById('btn-step1-next').addEventListener('click',()=>{for(const f of document.querySelectorAll('.form-step[data-step="1"] [required]'))if(!f.value){f.reportValidity();return}goToStep(2)});
document.getElementById('btn-step2-back').addEventListener('click',()=>goToStep(1));
document.getElementById('form-register').addEventListener('submit',async e=>{
 e.preventDefault();const msg=document.getElementById('auth-msg'),btn=e.target.querySelector('button[type="submit"]'),data=Object.fromEntries(new FormData(e.target));if(data.pays==='autre'&&data.pays_autre)data.pays=data.pays_autre;delete data.pays_autre;btn.disabled=true;msg.textContent='⏳ Création en cours...';msg.className='auth-msg';
 try{const res=await fetch('/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}),json=await res.json();if(json.success){msg.textContent=json.message||'✅ Compte créé !';msg.className='auth-msg ok';if(json.redirect)setTimeout(()=>location.href=json.redirect,1200)}else{msg.textContent=json.error||'❌ Erreur.';btn.disabled=false}}catch(err){msg.textContent='❌ Erreur réseau.';btn.disabled=false}
});
document.getElementById('form-login').addEventListener('submit',async e=>{
 e.preventDefault();const msg=document.getElementById('auth-msg'),btn=e.target.querySelector('button'),data=Object.fromEntries(new FormData(e.target));btn.disabled=true;msg.textContent='⏳ Connexion...';msg.className='auth-msg';
 try{const res=await fetch('/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}),json=await res.json();if(json.success){msg.textContent='✅ Connecté !';msg.className='auth-msg ok';location.href=json.redirect||'/'}else{msg.textContent=json.error||'❌ Erreur.';btn.disabled=false}}catch(err){msg.textContent='❌ Erreur réseau.';btn.disabled=false}
});
const body=document.body;
document.querySelectorAll('.theme-controls button').forEach(b=>b.addEventListener('click',()=>{
 document.querySelectorAll('.theme-controls button').forEach(x=>x.classList.remove('active'));b.classList.add('active');
 body.classList.remove('sagesse','light');
 const mode=b.dataset.mode;
 if(mode==='sagesse')body.classList.add('sagesse');
 if(mode==='light')body.classList.add('light');
 localStorage.setItem('samii-mode',mode);
}));
const saved=localStorage.getItem('samii-mode');
if(saved){const b=document.querySelector('[data-mode="'+saved+'"]');if(b)b.click()}
</script>
</body>
</html>
'''
