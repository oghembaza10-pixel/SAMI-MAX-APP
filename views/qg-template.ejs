<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>OG | <%= metier %></title>
    <link rel="stylesheet" href="/css/qg-style.css">
    
    <style>
        body { background-color: #000 !important; color: #fff !important; font-family: sans-serif; }
        .qg-wrapper { max-width: 500px; margin: 40px auto; padding: 20px; }
        h1 { color: #C5A059; text-align: center; }
        .card { border: 1px solid #C5A059; padding: 20px; margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="qg-wrapper">
        <header>
            <h1>QG <%= metier.toUpperCase() %></h1>
            <p class="grade">NIVEAU I • SOLDAT</p>
        </header>

        <div class="card">
            <h2>MISSION DU JOUR</h2>
            <p>Votre QG est prêt.</p>
        </div>

        <div class="card">
            <h2>CENTRE DE COMMANDEMENT</h2>
            <ul>
                <li><a href="/marketplace" style="color:#fff;">Marketplace</a></li>
                <li><a href="/academy" style="color:#fff;">Academy</a></li>
            </ul>
        </div>
        
        <a href="/hub" style="color:#C5A059;">RETOUR AU HUB</a>
    </div>
</body>
</html>
